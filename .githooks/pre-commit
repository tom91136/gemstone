#!/usr/bin/env bash
# enable once per clone: git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

native=()
scala=false
while IFS= read -r -d '' path; do
  case "$path" in
    native/* | conformance/*)
      case "/$path" in */generated/* | */licences/* | */third_party/* | */vendor/*) continue ;; esac
      case "${path,,}" in *.c | *.cc | *.cpp | *.cu | *.cxx | *.hip) native+=("$path") ;; esac
      ;;
  esac
  case "$path" in *.scala | *.sbt) scala=true ;; esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

failed=false

if ((${#native[@]})); then
  container=${GEMSTONE_CONTAINER_EXE:-podman}
  image=$(cmake -P conformance/artifacts/NativeToolchain.cmake)
  if ! "$container" image inspect "$image" >/dev/null 2>&1; then
    echo "pre-commit: toolchain image $image is missing; build it with: sbt native/nativeToolchain" >&2
    exit 1
  fi
  identity=(--user "$(id -u):$(id -g)")
  [[ "$(basename "$container")" == podman ]] && identity=(--userns keep-id "${identity[@]}")
  staged=$(mktemp -d)
  trap 'rm -rf "$staged"' EXIT
  git checkout-index --prefix="$staged/" -- "${native[@]}"
  "$container" run --rm --security-opt label=disable "${identity[@]}" \
    --mount "type=bind,source=$PWD,target=$PWD,readonly" --mount "type=bind,source=$staged,target=/staged,readonly" \
    --workdir "$PWD" "$image" sh -c \
    'status=0; for path; do clang-format --dry-run --Werror --assume-filename="$path" < "/staged/$path" >/dev/null || status=1; done; exit $status' \
    sh "${native[@]}" || failed=true
  $failed && echo "pre-commit: staged C/C++ is not clang-formatted; run: sbt native/format conformance/format" >&2
fi

if $scala; then
  if ! git diff --quiet -- '*.scala' '*.sbt'; then
    echo "pre-commit: unstaged Scala changes present; scalafmt checks the working tree" >&2
  fi
  for task in scalafmtCheckAll scalafmtSbtCheck; do
    if ! sbt --client "$task" >/dev/null; then
      echo "pre-commit: $task failed; run: sbt scalafmtAll scalafmtSbt" >&2
      failed=true
    fi
  done
fi

! $failed
