# RTX 4060 Ti, Radeon gfx1036, Intel Arc A750.
# Tested ROCm compatibility configuration: bundled vendor BLAS kernels target gfx1030.
# Compile our HIP/HSA fixtures for the same target; the physical GPU remains gfx1036.
# This is a host-local test override, not a claim of official ROCm hardware support.
HSA_OVERRIDE_GFX_VERSION=10.3.0
GEMSTONE_TEST_ORACLES=
GEMSTONE_TEST_ORACLES+=:cuda@sm_89!nvidia-0
GEMSTONE_TEST_ORACLES+=:hip@gfx1030!amd-0
GEMSTONE_TEST_ORACLES+=:hsa@gfx1030!amd-0
GEMSTONE_TEST_ORACLES+=:opencl@amd!amd-0
GEMSTONE_TEST_ORACLES+=:sycl-opencl@intel!intel-0
GEMSTONE_TEST_ORACLES+=:sycl-levelzero@intel!intel-0
# The Intel GPU oracle uses the driver's supported FP64 emulation path.
OverrideDefaultFP64Settings=1
IGC_EnableDPEmulation=1
# Reuse native SYCL JIT binaries across independent CTest processes.
SYCL_CACHE_PERSISTENT=1
