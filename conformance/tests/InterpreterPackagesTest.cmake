cmake_minimum_required(VERSION 3.25)
get_filename_component(conformance "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
include("${conformance}/interpreters/Packages.cmake")

function(fail text)
  message(FATAL_ERROR "${text}")
endfunction()

function(expect_packages backend architecture compiler expected)
  conformance_interpreter_packages_for_route("${backend}" "${architecture}" "${compiler}" actual)
  if(NOT "${actual}" STREQUAL "${expected}")
    fail("${backend}/${architecture}/${compiler} scheduled '${actual}', expected '${expected}'")
  endif()
endfunction()

expect_packages(cuda sm_35 vendor "")
expect_packages(cuda sm_70 vendor "")
expect_packages(cuda sm_75 vendor "numba;julia-cuda")
expect_packages(cuda sm_89 vendor "numba;julia-cuda")
expect_packages(cuda sm_90a vendor "")
expect_packages(cuda sm_89 clang "")
expect_packages(hip gfx1030 vendor "julia-amdgpu")
expect_packages(levelzero "" vendor "julia-oneapi")

foreach(package IN LISTS conformance_interpreter_packages)
  set(minimum "${conformance_interpreter_package_${package}_minimum_capability}")
  if("${minimum}" STREQUAL "")
    continue()
  endif()
  if(NOT "${minimum}" MATCHES "^[0-9]+$")
    fail("${package} declares a non-numeric minimum compute capability: '${minimum}'")
  endif()
  set(script "${conformance_interpreter_package_${package}_capability_script}")
  if("${script}" STREQUAL "")
    fail("${package} declares a minimum compute capability without a capability script")
  endif()
  if(NOT EXISTS "${conformance}/interpreters/${script}")
    fail("${package} capability script is missing: ${script}")
  endif()
endforeach()
