cmake_minimum_required(VERSION 3.25)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/DependencyCache.cmake")

if(DEFINED OFFLINE_CACHE)
  conformance_dependency_cache_apply("${OFFLINE_CACHE}" "file" TRUE "${EXPECTED_HASH}")
  return()
endif()

execute_process(COMMAND mktemp -d /tmp/conformance-cache-test-XXXXXX
  OUTPUT_VARIABLE directory OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
set(cache "${directory}/cache")
file(MAKE_DIRECTORY "${directory}/source/tree")
file(WRITE "${directory}/source/header.hpp" "first revision\n")
file(WRITE "${directory}/source/tree/value.txt" "unchanged archive\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${directory}/source.tar" tree
  WORKING_DIRECTORY "${directory}/source" COMMAND_ERROR_IS_FATAL ANY)
file(SHA256 "${directory}/source/header.hpp" first_hash)
file(SHA256 "${directory}/source.tar" archive_hash)
set(manifest "file|file|file://${directory}/source/header.hpp|${first_hash}"
             "archive|archive|file://${directory}/source.tar|${archive_hash}")
conformance_dependency_cache_ready("${manifest}" "${cache}" ready)
if(ready)
  message(FATAL_ERROR "Absent cache was accepted")
endif()
conformance_dependency_cache_populate("${manifest}" "${cache}")
conformance_dependency_cache_ready("${manifest}" "${cache}" ready)
if(NOT ready)
  message(FATAL_ERROR "Freshly populated cache was rejected")
endif()
# A populated archive must not be re-extracted when another pin changes.
file(WRITE "${cache}/archive/preserve.txt" "unchanged\n")
conformance_dependency_cache_apply("${cache}" "file" TRUE "${first_hash}")
if(NOT FETCHCONTENT_SOURCE_DIR_FILE STREQUAL "${cache}/file")
  message(FATAL_ERROR "Matching cache was not used")
endif()
file(WRITE "${directory}/source/header.hpp" "second revision\n")
file(SHA256 "${directory}/source/header.hpp" second_hash)
list(REMOVE_AT manifest 0)
list(PREPEND manifest "file|file|file://${directory}/source/header.hpp|${second_hash}")
conformance_dependency_cache_ready("${manifest}" "${cache}" ready)
if(ready)
  message(FATAL_ERROR "Changed manifest hash accepted stale source")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" "-DOFFLINE_CACHE=${cache}" "-DEXPECTED_HASH=${second_hash}"
  -P "${CMAKE_CURRENT_LIST_FILE}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(status STREQUAL "0" OR NOT "${output}${error}" MATCHES "Missing or outdated cached dependency: file")
  message(FATAL_ERROR "Offline build did not reject the stale pin: ${output}${error}")
endif()
conformance_dependency_cache_apply("${cache}" "file" FALSE "${second_hash}")
if(DEFINED FETCHCONTENT_SOURCE_DIR_FILE OR FETCHCONTENT_FULLY_DISCONNECTED)
  message(FATAL_ERROR "Stale cache override or offline mode survived online invalidation")
endif()
conformance_dependency_cache_populate("${manifest}" "${cache}")
conformance_dependency_cache_ready("${manifest}" "${cache}" ready)
file(READ "${cache}/file/header.hpp" content)
if(NOT ready OR NOT content STREQUAL "second revision\n" OR NOT EXISTS "${cache}/archive/preserve.txt")
  message(FATAL_ERROR "Cache refresh changed the wrong entries or retained stale source")
endif()
file(WRITE "${cache}/file/.conformance-complete" "completed\n")
conformance_dependency_cache_ready("${manifest}" "${cache}" ready)
if(ready)
  message(FATAL_ERROR "Unverified completion marker was accepted")
endif()
file(REMOVE_RECURSE "${directory}")
