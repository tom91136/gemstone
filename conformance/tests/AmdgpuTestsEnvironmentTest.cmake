cmake_minimum_required(VERSION 3.25)
get_filename_component(interpreters "${CMAKE_CURRENT_LIST_DIR}/../interpreters" ABSOLUTE)
set(project "${interpreters}/julia/amdgpu/tests")
set(enzyme_uuid "7da242da-08ed-463a-9acd-ee780be4f1d9")

function(fail text)
  message(FATAL_ERROR "${text}")
endfunction()

function(manifest_entry text name output)
  string(FIND "${text}" "[[deps.${name}]]\n" start)
  if(start EQUAL -1)
    set(${output} "" PARENT_SCOPE)
    return()
  endif()
  string(SUBSTRING "${text}" ${start} -1 rest)
  string(FIND "${rest}" "\n\n" stop)
  string(SUBSTRING "${rest}" 0 ${stop} block)
  set(${output} "${block}" PARENT_SCOPE)
endfunction()

file(READ "${project}/Project.toml" project_toml)
string(REGEX MATCH "\\[deps\\][^[]*Enzyme = \"${enzyme_uuid}\"" matched "${project_toml}")
if(NOT matched)
  fail("the amdgpu tests environment must list Enzyme under [deps] so the prepared depot carries it")
endif()

file(READ "${project}/Manifest.toml" manifest_toml)
manifest_entry("${manifest_toml}" Enzyme enzyme_entry)
if(NOT enzyme_entry MATCHES "\nuuid = \"${enzyme_uuid}\"")
  fail("Manifest.toml must pin Enzyme with uuid ${enzyme_uuid}")
endif()
manifest_entry("${manifest_toml}" EnzymeCore enzyme_core_entry)
if(enzyme_core_entry STREQUAL "")
  fail("Manifest.toml must pin EnzymeCore, which Enzyme loads")
endif()
