cmake_minimum_required(VERSION 3.25)
get_filename_component(conformance "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(artifacts "${conformance}/artifacts")
include("${conformance}/interpreters/Packages.cmake")
include("${artifacts}/ShardCosts.cmake")

execute_process(COMMAND mktemp -d /tmp/conformance-shards-test-XXXXXX
  OUTPUT_VARIABLE directory OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)

function(fail text)
  file(REMOVE_RECURSE "${directory}")
  message(FATAL_ERROR "${text}")
endfunction()

function(shards costs mode output_result output_error)
  set(arguments "-DCONFORMANCE_BUILD_PROFILE=complete" "-DMODE=${mode}")
  if(NOT costs STREQUAL "")
    list(APPEND arguments "-DCONFORMANCE_SHARD_COSTS=${costs}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" ${arguments} -P "${artifacts}/Shards.cmake"
    RESULT_VARIABLE result OUTPUT_VARIABLE matrix ERROR_VARIABLE error OUTPUT_STRIP_TRAILING_WHITESPACE)
  set(${output_result} "${result}" PARENT_SCOPE)
  set(${output_error} "${error}" PARENT_SCOPE)
  set(matrix "${matrix}" PARENT_SCOPE)
endfunction()

function(count_group group)
  string(JSON length LENGTH "${matrix}")
  set(count 0)
  if(length GREATER 0)
    math(EXPR last "${length} - 1")
    foreach(index RANGE ${last})
      string(JSON shard GET "${matrix}" ${index} shard)
      if(shard MATCHES "^${group}-")
        math(EXPR count "${count} + 1")
      endif()
    endforeach()
  endif()
  set(count ${count} PARENT_SCOPE)
endfunction()

set(programs)
foreach(package IN LISTS conformance_interpreter_packages)
  list(APPEND programs ${conformance_interpreter_package_${package}_programs})
endforeach()
file(READ "${conformance}/workloads/hecbench-bounded.toml" bounded)
string(REGEX MATCH "include_programs = \\[([^]]*)\\]" ignored "${bounded}")
string(REGEX MATCHALL "hecbench_[a-z0-9_]+" bounded_programs "${CMAKE_MATCH_1}")
if(NOT bounded_programs)
  fail("hecbench-bounded.toml lists no programs")
endif()
foreach(program IN LISTS programs bounded_programs)
  if(NOT DEFINED conformance_cost_${program})
    fail("${program} has no cost entry in ShardCosts.cmake")
  endif()
endforeach()
foreach(entry IN LISTS conformance_cost_programs)
  if(NOT entry IN_LIST programs AND NOT entry IN_LIST bounded_programs)
    fail("cost entry ${entry} names no interpreter or bounded HeCBench program")
  endif()
endforeach()

get_cmake_property(variables VARIABLES)
foreach(variable IN LISTS variables)
  if(variable MATCHES "^conformance_memory_(.+)$" AND NOT CMAKE_MATCH_1 IN_LIST programs)
    fail("memory entry ${variable} names no interpreter program")
  endif()
endforeach()

shards("" run status error)
if(NOT status EQUAL 0)
  fail("Shards.cmake failed: ${error}")
endif()
string(JSON length LENGTH "${matrix}")
if(length GREATER 256)
  fail("The run matrix has ${length} entries, past the 256 a GitHub matrix allows")
endif()
math(EXPR limit "${conformance_shard_wall_seconds} / 60")
math(EXPR last "${length} - 1")
foreach(index RANGE ${last})
  string(JSON shard GET "${matrix}" ${index} shard)
  string(JSON minutes ERROR_VARIABLE unsized GET "${matrix}" ${index} minutes)
  if(unsized)
    continue()
  endif()
  if(minutes GREATER limit)
    fail("Shard ${shard} is expected to take ${minutes} minutes, past the ${limit} its budget allows")
  endif()
endforeach()
count_group(cuda)
set(cuda_shards ${count})

file(READ "${artifacts}/ShardCosts.cmake" costs)
string(REGEX REPLACE "set\\(conformance_cost_python_numba ([0-9]+)\\)" "set(conformance_cost_python_numba 99999)" doubled "${costs}")
file(WRITE "${directory}/heavier.cmake" "${doubled}")
shards("${directory}/heavier.cmake" run status error)
if(NOT status EQUAL 0)
  fail("Shards.cmake failed on a heavier cost table: ${error}")
endif()
count_group(cuda)
if(NOT count GREATER cuda_shards)
  fail("A costlier Numba suite left cuda at ${count} shards, from ${cuda_shards}")
endif()

foreach(program IN ITEMS python_numba julia_tests_amdgpu hecbench_laplace)
  string(REGEX REPLACE "set\\(conformance_cost_${program} [0-9]+\\)" "" missing "${costs}")
  file(WRITE "${directory}/missing.cmake" "${missing}")
  shards("${directory}/missing.cmake" run status error)
  if(status EQUAL 0 OR NOT error MATCHES "${program}")
    fail("A cost table without ${program} was accepted: ${status} ${error}")
  endif()
endforeach()

shards("" build status error)
if(NOT status EQUAL 0)
  fail("Shards.cmake failed in build mode: ${error}")
endif()

set(graph_directory "${directory}/complete")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${artifacts}" -B "${graph_directory}" -G Ninja
  -DCONFORMANCE_BUILD_PROFILE=complete -DROCM_VERSION=7.1.1
  OUTPUT_VARIABLE output ERROR_VARIABLE error RESULT_VARIABLE status)
if(NOT status STREQUAL "0")
  fail("Complete matrix configuration failed: ${output}\n${error}")
endif()
file(READ "${graph_directory}/build.ninja" graph)
execute_process(COMMAND "${CMAKE_COMMAND}" -DCONFORMANCE_BUILD_PROFILE=complete -P "${artifacts}/Targets.cmake"
  OUTPUT_VARIABLE complete_routes OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
string(REPLACE "\n" ";" complete_routes "${complete_routes}")

function(route_family route output)
  string(REGEX REPLACE "^cuda-(ptx|sass)/.*$" "cuda" family "${route}")
  string(REGEX REPLACE "/.*$" "" family "${family}")
  set(${output} "${family}" PARENT_SCOPE)
endfunction()

function(route_configuration route output)
  if(route MATCHES "^cuda-(ptx|sass)/(sm_[^/]+)")
    set(configuration "${CMAKE_MATCH_1}/${CMAKE_MATCH_2}")
  elseif(route MATCHES "^[^/]+/(.+)$")
    set(configuration "${CMAKE_MATCH_1}")
  else()
    set(configuration "${route}")
  endif()
  set(${output} "${configuration}" PARENT_SCOPE)
endfunction()

foreach(route IN LISTS complete_routes)
  string(REGEX REPLACE "^cuda-sass/" "cuda/" artifact_route "${route}")
  string(REGEX REPLACE "^([^/]+)/([^/]+)/(clang|gcc)$" "\\1/\\3/\\2" artifact_route "${artifact_route}")
  string(REGEX MATCH "build output/${artifact_route}/artifact\\.toml [^\n]*\n  COMMAND = [^\n]*CONFORMANCE_INTERPRETER_PACKAGES=([^ \n]*)"
    edge "${graph}")
  if(edge STREQUAL "")
    fail("Exported route ${route} has no matching artifact edge")
  endif()
  string(REPLACE "," ";" package_list "${CMAKE_MATCH_1}")
  foreach(package IN LISTS conformance_interpreter_packages)
    if(package IN_LIST package_list)
      list(APPEND carriers_${package} "${route}")
    endif()
  endforeach()
endforeach()

foreach(package IN LISTS conformance_interpreter_packages)
  set(carriers "${carriers_${package}}")
  set(minimum "${conformance_interpreter_package_${package}_minimum_capability}")
  if(carriers STREQUAL "")
    fail("${package} is carried by no complete route")
  endif()
  list(GET carriers 0 first)
  route_family("${first}" family)
  set(configurations)
  foreach(route IN LISTS carriers)
    route_family("${route}" carrier_family)
    if(NOT carrier_family STREQUAL family)
      fail("${package} is carried by ${family} and ${carrier_family} routes")
    endif()
    if(route MATCHES "/(clang|gcc)$" OR route MATCHES "/sm_[0-9]+[af]$")
      fail("${package} is carried by ${route}, a clang, gcc or suffixed route")
    endif()
    route_configuration("${route}" configuration)
    if(configuration IN_LIST configurations)
      fail("${package} is carried by more than one route for ${configuration}")
    endif()
    list(APPEND configurations "${configuration}")
  endforeach()
  foreach(route IN LISTS complete_routes)
    route_family("${route}" route_family_name)
    if(route_family_name STREQUAL family AND NOT route MATCHES "/(clang|gcc)$" AND NOT route MATCHES "/sm_[0-9]+[af]$")
      route_configuration("${route}" configuration)
      set(supported TRUE)
      if(route MATCHES "sm_([0-9]+)$")
        if(NOT "${minimum}" STREQUAL "" AND CMAKE_MATCH_1 LESS minimum)
          set(supported FALSE)
        endif()
      endif()
      if(supported AND NOT configuration IN_LIST configurations)
        fail("${package} is not carried by ${route} for ${configuration}")
      elseif(NOT supported AND configuration IN_LIST configurations)
        fail("${package} is carried by ${route} below its minimum compute capability ${minimum}")
      endif()
    endif()
  endforeach()
endforeach()

file(REMOVE_RECURSE "${directory}")
