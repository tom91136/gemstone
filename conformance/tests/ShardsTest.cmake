cmake_minimum_required(VERSION 3.25)
get_filename_component(conformance "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(artifacts "${conformance}/artifacts")
include("${conformance}/interpreters/Packages.cmake")
include("${artifacts}/ShardCosts.cmake")

execute_process(COMMAND mktemp -d /tmp/conformance-shards-test-XXXXXX
  OUTPUT_VARIABLE directory OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)

function(fail text)
  file(REMOVE_RECURSE "${directory}")
  message(FATAL_ERROR "${text}")
endfunction()

function(shards costs mode output_result output_error)
  set(arguments "-DCONFORMANCE_BUILD_PROFILE=complete" "-DMODE=${mode}")
  if(NOT costs STREQUAL "")
    list(APPEND arguments "-DCONFORMANCE_SHARD_COSTS=${costs}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" ${arguments} -P "${artifacts}/Shards.cmake"
    RESULT_VARIABLE result OUTPUT_VARIABLE matrix ERROR_VARIABLE error OUTPUT_STRIP_TRAILING_WHITESPACE)
  set(${output_result} "${result}" PARENT_SCOPE)
  set(${output_error} "${error}" PARENT_SCOPE)
  set(matrix "${matrix}" PARENT_SCOPE)
endfunction()

function(count_group group)
  string(JSON length LENGTH "${matrix}")
  set(count 0)
  if(length GREATER 0)
    math(EXPR last "${length} - 1")
    foreach(index RANGE ${last})
      string(JSON shard GET "${matrix}" ${index} shard)
      if(shard MATCHES "^${group}-")
        math(EXPR count "${count} + 1")
      endif()
    endforeach()
  endif()
  set(count ${count} PARENT_SCOPE)
endfunction()

set(programs)
foreach(package IN LISTS conformance_interpreter_packages)
  list(APPEND programs ${conformance_interpreter_package_${package}_programs})
endforeach()
file(READ "${conformance}/workloads/hecbench-bounded.toml" bounded)
string(REGEX MATCH "include_programs = \\[([^]]*)\\]" ignored "${bounded}")
string(REGEX MATCHALL "hecbench_[a-z0-9_]+" bounded_programs "${CMAKE_MATCH_1}")
if(NOT bounded_programs)
  fail("hecbench-bounded.toml lists no programs")
endif()
foreach(program IN LISTS programs bounded_programs)
  if(NOT DEFINED conformance_cost_${program})
    fail("${program} has no cost entry in ShardCosts.cmake")
  endif()
endforeach()
foreach(entry IN LISTS conformance_cost_programs)
  if(NOT entry IN_LIST programs AND NOT entry IN_LIST bounded_programs)
    fail("cost entry ${entry} names no interpreter or bounded HeCBench program")
  endif()
endforeach()

shards("" run status error)
if(NOT status EQUAL 0)
  fail("Shards.cmake failed: ${error}")
endif()
string(JSON length LENGTH "${matrix}")
if(length GREATER 256)
  fail("The run matrix has ${length} entries, past the 256 a GitHub matrix allows")
endif()
math(EXPR limit "${conformance_shard_wall_seconds} / 60")
math(EXPR last "${length} - 1")
foreach(index RANGE ${last})
  string(JSON shard GET "${matrix}" ${index} shard)
  string(JSON minutes ERROR_VARIABLE unsized GET "${matrix}" ${index} minutes)
  if(unsized)
    continue()
  endif()
  if(minutes GREATER limit)
    fail("Shard ${shard} is expected to take ${minutes} minutes, past the ${limit} its budget allows")
  endif()
endforeach()
count_group(cuda)
set(cuda_shards ${count})

file(READ "${artifacts}/ShardCosts.cmake" costs)
string(REGEX REPLACE "set\\(conformance_cost_python_numba ([0-9]+)\\)" "set(conformance_cost_python_numba 99999)" doubled "${costs}")
file(WRITE "${directory}/heavier.cmake" "${doubled}")
shards("${directory}/heavier.cmake" run status error)
if(NOT status EQUAL 0)
  fail("Shards.cmake failed on a heavier cost table: ${error}")
endif()
count_group(cuda)
if(NOT count GREATER cuda_shards)
  fail("A costlier Numba suite left cuda at ${count} shards, from ${cuda_shards}")
endif()

foreach(program IN ITEMS python_numba julia_tests_amdgpu hecbench_laplace)
  string(REGEX REPLACE "set\\(conformance_cost_${program} [0-9]+\\)" "" missing "${costs}")
  file(WRITE "${directory}/missing.cmake" "${missing}")
  shards("${directory}/missing.cmake" run status error)
  if(status EQUAL 0 OR NOT error MATCHES "${program}")
    fail("A cost table without ${program} was accepted: ${status} ${error}")
  endif()
endforeach()

shards("" build status error)
if(NOT status EQUAL 0)
  fail("Shards.cmake failed in build mode: ${error}")
endif()

file(REMOVE_RECURSE "${directory}")
