ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

USER root

ARG BUILDER_UID=1000
ARG BUILDER_GID=1000
ARG INSTALL_OPENCL=0
ENV DEBIAN_FRONTEND=noninteractive

# The compiler and vendor SDK come from BASE_IMAGE.  These are only the
# reproducible build tools needed by the suite; none of them are copied into
# the relocated artifact.
RUN apt-get update \
    && apt-get install --no-install-recommends --yes \
       binutils \
       build-essential \
       ca-certificates \
       cmake \
       file \
       git \
       libdw1 \
       ninja-build \
       patchelf \
       python3 \
    && if [ "${INSTALL_OPENCL}" = 1 ]; then \
         apt-get install --no-install-recommends --yes opencl-headers ocl-icd-opencl-dev; \
       fi \
    && rm -rf /var/lib/apt/lists/* \
    && if ! getent group "${BUILDER_GID}" >/dev/null; then \
         groupadd --gid "${BUILDER_GID}" gemstone-builder; \
       fi \
    && if ! getent passwd "${BUILDER_UID}" >/dev/null; then \
         useradd --create-home --uid "${BUILDER_UID}" --gid "${BUILDER_GID}" gemstone-builder; \
       fi \
    && mkdir --mode=1777 /work

USER ${BUILDER_UID}:${BUILDER_GID}
WORKDIR /work
