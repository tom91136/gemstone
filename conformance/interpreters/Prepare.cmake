include("${CMAKE_CURRENT_LIST_DIR}/Environment.cmake")

function(glob_to_regex glob output_var)
  string(REPLACE "." "\\." r "${glob}")
  string(REPLACE "+" "\\+" r "${r}")
  string(REPLACE "?" "." r "${r}")
  string(REPLACE "*" ".*" r "${r}")
  set(${output_var} "^${r}$" PARENT_SCOPE)
endfunction()

function(parse_toml_string_list content key output_var found_var)
  if(content MATCHES "${key}[ \t]*=[ \t]*\\[([^]]*)\\]")
    set(raw "${CMAKE_MATCH_1}")
    string(REGEX MATCHALL "['\"][^'\"]*['\"]" items "${raw}")
    set(cleaned)
    foreach(item IN LISTS items)
      string(REGEX REPLACE "^['\"]|['\"]$" "" val "${item}")
      list(APPEND cleaned "${val}")
    endforeach()
    set(${output_var} "${cleaned}" PARENT_SCOPE)
    set(${found_var} TRUE PARENT_SCOPE)
  else()
    set(${found_var} FALSE PARENT_SCOPE)
  endif()
endfunction()

function(load_workload workloads name inc_var exc_var)
  set(file "${workloads}/${name}.toml")
  if(NOT EXISTS "${file}")
    message(FATAL_ERROR "Workload file does not exist: ${file}")
  endif()
  file(READ "${file}" content)
  set(include_programs)
  set(exclude_programs)
  if(content MATCHES "extends[ \t]*=[ \t]*['\"]([^'\"]+)['\"]")
    set(parent "${CMAKE_MATCH_1}")
    load_workload("${workloads}" "${parent}" p_inc p_exc)
    set(include_programs ${p_inc})
    set(exclude_programs ${p_exc})
  endif()
  parse_toml_string_list("${content}" "include_programs" inc inc_found)
  if(inc_found)
    set(include_programs ${inc})
  endif()
  parse_toml_string_list("${content}" "add_include_programs" add_inc add_inc_found)
  if(add_inc_found)
    list(APPEND include_programs ${add_inc})
  endif()
  parse_toml_string_list("${content}" "exclude_programs" exc exc_found)
  if(exc_found)
    set(exclude_programs ${exc})
  endif()
  parse_toml_string_list("${content}" "add_exclude_programs" add_exc add_exc_found)
  if(add_exc_found)
    list(APPEND exclude_programs ${add_exc})
  endif()
  set(${inc_var} "${include_programs}" PARENT_SCOPE)
  set(${exc_var} "${exclude_programs}" PARENT_SCOPE)
endfunction()

function(program_selected program include_patterns exclude_patterns output_var)
  foreach(pattern IN LISTS exclude_patterns)
    glob_to_regex("${pattern}" regex)
    if(program MATCHES "${regex}")
      set(${output_var} FALSE PARENT_SCOPE)
      return()
    endif()
  endforeach()
  if(include_patterns)
    foreach(pattern IN LISTS include_patterns)
      glob_to_regex("${pattern}" regex)
      if(program MATCHES "${regex}")
        set(${output_var} TRUE PARENT_SCOPE)
        return()
      endif()
    endforeach()
    set(${output_var} FALSE PARENT_SCOPE)
    return()
  endif()
  set(${output_var} TRUE PARENT_SCOPE)
endfunction()

function(resolve_packages routes workload_name workloads output_var)
  load_workload("${workloads}" "${workload_name}" inc exc)
  set(backends)
  foreach(route IN LISTS routes)
    if(route STREQUAL "all")
      set(backends cuda hip hsa sycl levelzero opencl vulkan openacc)
      break()
    endif()
    string(REGEX REPLACE "^cuda-(ptx|sass)/" "cuda/" r "${route}")
    string(REGEX REPLACE "/.*$" "" r "${r}")
    string(REGEX REPLACE "-shard-.*$" "" r "${r}")
    list(APPEND backends "${r}")
  endforeach()
  list(REMOVE_DUPLICATES backends)

  set(selected_packages)
  foreach(backend IN LISTS backends)
    conformance_interpreter_packages_for_backend("${backend}" candidate_packages)
    foreach(package IN LISTS candidate_packages)
      if(package IN_LIST selected_packages)
        continue()
      endif()
      set(programs ${conformance_interpreter_package_${package}_programs})
      foreach(prog IN LISTS programs)
        program_selected("${prog}" "${inc}" "${exc}" is_sel)
        if(is_sel)
          list(APPEND selected_packages "${package}")
          break()
        endif()
      endforeach()
    endforeach()
  endforeach()
  set(${output_var} "${selected_packages}" PARENT_SCOPE)
endfunction()

if(NOT DEFINED ROUTES)
  set(ROUTES all)
endif()

resolve_packages("${ROUTES}" "${WORKLOAD}" "${WORKLOADS}" selected_packages)

if(MODE STREQUAL "query")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${selected_packages}")
  return()
endif()

if(NOT selected_packages)
  message(STATUS "No interpreter packages required for workload ${WORKLOAD}")
  return()
endif()

file(MAKE_DIRECTORY "${CONFORMANCE_INTERPRETER_DIRECTORY}" "${CONFORMANCE_INTERPRETER_ARCHIVE_DIRECTORY}")

function(ensure_interpreter language)
  if(language STREQUAL "python")
    set(directory "cpython-${conformance_python_release}")
    set(archive_name "${conformance_python_archive}")
    set(url "${conformance_python_url}")
    set(sha256 "${conformance_python_sha256}")
    set(mode python)
    set(archive_var PYTHON_ARCHIVE)
    set(dir_var PYTHON_DIRECTORY)
  else()
    set(directory "julia-${conformance_julia_release}")
    set(archive_name "${conformance_julia_archive}")
    set(url "${conformance_julia_url}")
    set(sha256 "${conformance_julia_sha256}")
    set(mode julia)
    set(archive_var JULIA_ARCHIVE)
    set(dir_var JULIA_DIRECTORY)
  endif()
  set(ready "${CONFORMANCE_INTERPRETER_DIRECTORY}/${directory}/.ready")
  if(EXISTS "${ready}")
    return()
  endif()
  set(archive "${CONFORMANCE_INTERPRETER_ARCHIVE_DIRECTORY}/${archive_name}")
  set(needs_fetch TRUE)
  if(EXISTS "${archive}")
    file(SHA256 "${archive}" digest)
    if(digest STREQUAL sha256)
      set(needs_fetch FALSE)
    endif()
  endif()
  if(needs_fetch)
    if(offline EQUAL 1)
      message(FATAL_ERROR "Offline mode forbids downloading missing interpreter archive: ${archive_name}")
    endif()
    message(STATUS "Downloading ${url} -> ${archive}")
    file(DOWNLOAD "${url}" "${archive}" EXPECTED_HASH SHA256=${sha256} STATUS dl_status)
    list(GET dl_status 0 dl_code)
    list(GET dl_status 1 dl_message)
    if(NOT dl_code EQUAL 0)
      file(REMOVE "${archive}")
      message(FATAL_ERROR "Failed to download ${url}: ${dl_message}")
    endif()
  endif()
  message(STATUS "Extracting ${directory}")
  execute_process(
    COMMAND "${CMAKE_COMMAND}"
      "-DCACHE=${CONFORMANCE_INTERPRETER_DIRECTORY}"
      "-DMODE=${mode}"
      "-D${archive_var}=${archive}"
      "-D${dir_var}=${directory}"
      -P "${CMAKE_CURRENT_LIST_DIR}/bootstrap.cmake"
    COMMAND_ERROR_IS_FATAL ANY
  )
endfunction()

foreach(package IN LISTS selected_packages)
  conformance_interpreter_environment_key("${package}" key)
  set(target "${CONFORMANCE_INTERPRETER_DIRECTORY}/${package}-${key}")
  if(EXISTS "${target}/.complete")
    message(STATUS "Reusing interpreter environment: ${package}-${key}")
    continue()
  endif()

  set(language "${conformance_interpreter_package_${package}_language}")
  ensure_interpreter("${language}")

  message(STATUS "Building interpreter environment: ${package}-${key}")
  set(environment "${CMAKE_CURRENT_LIST_DIR}/${conformance_interpreter_package_${package}_environment}")
  if(language STREQUAL "python")
    execute_process(
      COMMAND sh "${CMAKE_CURRENT_LIST_DIR}/install-python.sh"
        "${CONFORMANCE_INTERPRETER_DIRECTORY}"
        "${package}"
        "${key}"
        "${environment}"
        "cpython-${conformance_python_release}"
        "${offline}"
      COMMAND_ERROR_IS_FATAL ANY
    )
  else()
    set(warmup "${CMAKE_CURRENT_LIST_DIR}/julia/warmup-${package}.jl")
    execute_process(
      COMMAND sh "${CMAKE_CURRENT_LIST_DIR}/install-julia.sh"
        "${CONFORMANCE_INTERPRETER_DIRECTORY}"
        "${package}"
        "${key}"
        "${environment}"
        "julia-${conformance_julia_release}"
        "${offline}"
        "${warmup}"
      COMMAND_ERROR_IS_FATAL ANY
    )
  endif()
endforeach()

string(TIMESTAMP prepare_end_seconds "%s")
math(EXPR prepare_elapsed_seconds "${prepare_end_seconds} - ${prepare_start_seconds}")
message(STATUS "Interpreter preparation completed in ${prepare_elapsed_seconds} s")
