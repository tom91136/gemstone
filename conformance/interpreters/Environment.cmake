# The key names the environment cache entry: the lock file, the installer, and the interpreter pin. Paths are relative
# so that identical checkouts on different hosts share an environment.
function(conformance_interpreter_environment_key package output)
  set(environment "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/${conformance_interpreter_package_${package}_environment}")
  set(files)
  if(IS_DIRECTORY "${environment}")
    file(GLOB_RECURSE files "${environment}/*")
  else()
    set(files "${environment}")
  endif()
  list(SORT files)
  set(definition "package=${package}\n")
  foreach(file IN LISTS files)
    file(RELATIVE_PATH relative "${CMAKE_CURRENT_FUNCTION_LIST_DIR}" "${file}")
    file(SHA256 "${file}" digest)
    string(APPEND definition "${relative}:${digest}\n")
  endforeach()
  foreach(extra IN ITEMS
      "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/install-${conformance_interpreter_package_${package}_language}.sh"
      "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/Packages.cmake")
    file(RELATIVE_PATH relative "${CMAKE_CURRENT_FUNCTION_LIST_DIR}" "${extra}")
    file(SHA256 "${extra}" digest)
    string(APPEND definition "${relative}:${digest}\n")
  endforeach()
  if(conformance_interpreter_package_${package}_language STREQUAL "python")
    string(APPEND definition "python=${conformance_python_release}\n")
  else()
    string(APPEND definition "julia=${conformance_julia_release}\n")
    file(SHA256 "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/julia/warmup-${package}.jl" digest)
    string(APPEND definition "warmup:${digest}\n")
  endif()
  string(SHA256 digest "${definition}")
  string(SUBSTRING "${digest}" 0 16 digest)
  set(${output} "${digest}" PARENT_SCOPE)
endfunction()

function(conformance_interpreter_environment_directory package output)
  conformance_interpreter_environment_key("${package}" key)
  set(${output} "${CONFORMANCE_INTERPRETER_DIRECTORY}/${package}-${key}" PARENT_SCOPE)
endfunction()
