cmake_minimum_required(VERSION 3.25)
# Extracts the pinned standalone interpreters into the environment cache. The archives come from the verified
# dependency cache, so this is the only place the cache's interpreter payload is produced.

foreach(variable IN ITEMS CACHE MODE)
  if(NOT DEFINED ${variable} OR "${${variable}}" STREQUAL "")
    message(FATAL_ERROR "${variable} is required")
  endif()
endforeach()

if(MODE STREQUAL "python")
  set(archive "${PYTHON_ARCHIVE}")
  set(directory "${PYTHON_DIRECTORY}")
  set(executable "bin/python3")
elseif(MODE STREQUAL "julia")
  set(archive "${JULIA_ARCHIVE}")
  set(directory "${JULIA_DIRECTORY}")
  set(executable "bin/julia")
else()
  message(FATAL_ERROR "Unknown interpreter mode: ${MODE}")
endif()

set(target "${CACHE}/${directory}")
if(NOT EXISTS "${target}/${executable}")
  if(NOT EXISTS "${archive}")
    message(FATAL_ERROR "Missing interpreter archive: ${archive}")
  endif()
  file(MAKE_DIRECTORY "${CACHE}")
  set(staging "${CACHE}/.${directory}.extract")
  file(REMOVE_RECURSE "${staging}")
  file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${staging}")
  file(GLOB children RELATIVE "${staging}" "${staging}/*")
  list(LENGTH children count)
  if(count EQUAL 1 AND IS_DIRECTORY "${staging}/${children}")
    file(RENAME "${staging}/${children}" "${target}")
    file(REMOVE_RECURSE "${staging}")
  else()
    file(RENAME "${staging}" "${target}")
  endif()
endif()
file(TOUCH "${target}/.ready")
# Julia 1.9 cannot start under the host SELinux policy; its first execution is the route's container.
if(MODE STREQUAL "python")
  execute_process(COMMAND "${target}/${executable}" --version COMMAND_ERROR_IS_FATAL ANY OUTPUT_VARIABLE version)
  message(STATUS "${directory}: ${version}")
else()
  message(STATUS "${directory}: extracted")
endif()
