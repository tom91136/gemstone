#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
base=${CONFORMANCE_INTERPRETER_DIRECTORY:-@CONFORMANCE_INTERPRETER_DIRECTORY@}
base=$(CDPATH= cd -- "$base" && pwd -P)
depot="$base/@PACKAGE@-@KEY@"
julia="$base/julia-@JULIA@/bin/julia"
project="$depot/environment/@PROJECT@"

export JULIA_DEPOT_PATH="$depot"
export JULIA_PKG_OFFLINE=true
export JULIA_NUM_THREADS="${JULIA_NUM_THREADS:-1}"

saved_ifs=$IFS
IFS=:
for library in ${LD_PRELOAD-}; do
  case "$(basename "$library")" in libamdhip64.so*) export ROCM_PATH="$(dirname "$library")" ;; esac
done
for directory in ${LD_LIBRARY_PATH-}; do
  if [ -z "${ROCM_PATH-}" ]; then
    for library in "$directory"/libamdhip64.so*; do
      [ -e "$library" ] && export ROCM_PATH="$directory" && break
    done
  fi
done

library_has_code_object() {
  matched=$(grep -aoE 'amdgcn-amd-amdhsa--gfx[0-9a-f]+' "$1" 2>/dev/null | sed 's/.*--//' | sort -u |
    while IFS= read -r architecture; do
      if [ "$architecture" = "$2" ]; then echo matched; break; fi
      case " @HIP_BUNDLE_FAMILIES@ " in
        *" $architecture "*)
          if [ "${architecture%?}" = "${2%?}" ]; then echo matched; break; fi
          ;;
      esac
    done)
  [ -n "$matched" ]
}

rocblas_missing=0
if [ -n "${ROCBLAS_TENSILE_LIBPATH-}" ] && [ -n "${CONFORMANCE_TARGET_ARCH-}" ] \
    && [ ! -f "$ROCBLAS_TENSILE_LIBPATH/TensileLibrary_lazy_${CONFORMANCE_TARGET_ARCH}.dat" ]; then
  rocblas_missing=1
fi

rocm_overlay=
if [ -n "${ROCM_PATH-}" ]; then
  rocm_overlay=$(mktemp -d)
  trap 'rm -rf "$rocm_overlay"' EXIT
  for directory in "$ROCM_PATH" ${LD_LIBRARY_PATH-}; do
    for library in "$directory"/lib*; do
      [ -e "$library" ] || continue
      case "$(basename "$library")" in
        librocblas*)
          [ "$rocblas_missing" -eq 0 ] || continue
          ;;
        librocsparse*)
          if [ -n "${CONFORMANCE_TARGET_ARCH-}" ] \
              && ! library_has_code_object "$library" "$CONFORMANCE_TARGET_ARCH"; then
            continue
          fi
          ;;
      esac
      ln -s "$library" "$rocm_overlay/" 2>/dev/null || true
    done
  done
  export ROCM_PATH="$rocm_overlay"
fi
IFS=$saved_ifs
export LD_LIBRARY_PATH="$base/julia-@JULIA@/lib/julia${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

status=0
"$julia" --startup-file=no --project="$project" \
  "$root/data/interpreters/@SCRIPT@" @ARGUMENTS@ "$@" || status=$?
exit "$status"
