enable_language(CUDA)
find_package(CUDAToolkit REQUIRED)

# CUDA 11.8 builds use the 11.8 samples and CCCL 2.8; newer toolkits use the current releases.
if(CUDAToolkit_VERSION VERSION_LESS 12)
  set(vendor_samples_name cuda_samples_11_8)
  set(vendor_samples_layout Samples)
  set(vendor_cccl_name cccl_2_8)
else()
  set(vendor_samples_name cuda_samples_13_3)
  set(vendor_samples_layout cpp)
  set(vendor_cccl_name cccl_3_4)
endif()
FetchContent_MakeAvailable(${vendor_samples_name} cuda_library_samples ${vendor_cccl_name})
set(vendor_samples_root "${${vendor_samples_name}_SOURCE_DIR}")
set(vendor_samples_directory "${vendor_samples_root}/${vendor_samples_layout}")
set(vendor_library_root "${cuda_library_samples_SOURCE_DIR}")
set(vendor_cccl_root "${${vendor_cccl_name}_SOURCE_DIR}")
string(REGEX REPLACE "[af]$" "" vendor_architecture "${conformance_cuda_architecture}")
set(vendor_programs_directory "${CMAKE_CURRENT_BINARY_DIR}/cases")
set(vendor_adapter_source "${CMAKE_CURRENT_LIST_DIR}/cuda/adapter.cpp")
set(vendor_cuda_patch_directory "${CMAKE_CURRENT_LIST_DIR}/cuda/patches")

set(CMAKE_CUDA_STANDARD 17)
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_C_STANDARD 11)

conformance_runtime_plugins(
  "${conformance_cuda_runtime_directory}/libcufft.so*"
  "${conformance_cuda_runtime_directory}/libcurand.so*"
  "${conformance_cuda_runtime_directory}/libcusparse.so*"
  "${conformance_cuda_runtime_directory}/libcusolver.so*"
  "${conformance_cuda_runtime_directory}/libnvJitLink.so*"
  "${conformance_cuda_runtime_directory}/libnvrtc.so*"
  "${conformance_cuda_runtime_directory}/libnvrtc-builtins.so*")

# Falling off the end of the renamed main is only defined for a function named main, so the entry point is renamed with an asm label
function(conformance_vendor_cuda_entry id source output)
  file(READ "${source}" content)
  if(NOT content MATCHES "int[ \t\r\n]+main[ \t\r\n]*\\(([^)]*)\\)")
    message(FATAL_ERROR "No main found in ${source}")
  endif()
  string(STRIP "${CMAKE_MATCH_1}" parameters)
  if(parameters STREQUAL "" OR parameters STREQUAL "void")
    set(prototype "void")
  elseif(parameters MATCHES "const")
    set(prototype "int, const char **")
  else()
    set(prototype "int, char **")
  endif()
  set(header "${vendor_programs_directory}/entry_${id}.h")
  set(content "int main(${prototype}) __asm__(\"vendor_main_${id}\");\n")
  foreach(include IN LISTS PROGRAM_ENTRY_INCLUDES)
    string(APPEND content "#include \"${include}\"\n")
  endforeach()
  file(WRITE "${header}.tmp" "${content}")
  file(COPY_FILE "${header}.tmp" "${header}" ONLY_IF_DIFFERENT)
  set(${output} "${header}" PARENT_SCOPE)
endfunction()

# Case entries are program-unique ids with display names and optional arguments and tags; the wrapper entry point is the original main of the case's source.
function(conformance_vendor_cuda_program program)
  cmake_parse_arguments(PARSE_ARGV 1 PROGRAM "" "TIMEOUT;TAG"
    "CASES;SOURCES;LIBRARIES;INCLUDES;DEFINITIONS;OPTIONS;ENTRY_INCLUDES")
  if(NOT PROGRAM_TIMEOUT)
    set(PROGRAM_TIMEOUT 300)
  endif()
  set(directory "${vendor_programs_directory}/${program}")
  file(MAKE_DIRECTORY "${directory}")
  set(cases_inc "#define CONFORMANCE_VENDOR_TAGS \"${PROGRAM_TAG}\"\n#define CONFORMANCE_VENDOR_CASES")
  foreach(entry IN LISTS PROGRAM_CASES)
    string(REPLACE "|" ";" fields "${entry}")
    list(GET fields 0 id)
    list(GET fields 1 name)
    list(GET fields 2 source)
    set(arguments "")
    set(tags "")
    list(LENGTH fields field_count)
    if(field_count GREATER 4)
      list(GET fields 4 tags)
    endif()
    if(field_count GREATER 3)
      list(GET fields 3 argument_list)
      string(REPLACE "," ";" argument_list "${argument_list}")
      foreach(argument IN LISTS argument_list)
        string(APPEND arguments ", \"${argument}\"")
      endforeach()
    endif()
    string(APPEND cases_inc " \\\n  CONFORMANCE_VENDOR_CASE(${id}, \"${name}\", \"${tags}\"${arguments})")
    conformance_vendor_cuda_entry(${id} "${source}" entry_header)
    set_source_files_properties("${source}" PROPERTIES
      COMPILE_DEFINITIONS "nvrtc_compile=nvrtc_compile_${id}" COMPILE_OPTIONS "-include;${entry_header}")
    list(APPEND case_sources "${source}")
  endforeach()
  string(APPEND cases_inc "\n")
  file(WRITE "${directory}/vendor_cases.inc.tmp" "${cases_inc}")
  file(COPY_FILE "${directory}/vendor_cases.inc.tmp" "${directory}/vendor_cases.inc" ONLY_IF_DIFFERENT)

  set(adapter "${program}_adapter")
  add_library(${adapter} OBJECT "${vendor_adapter_source}")
  conformance_project_target(${adapter})
  target_include_directories(${adapter} PRIVATE "${directory}")
  target_link_libraries(${adapter} PRIVATE Catch2::Catch2 conformance_device)

  add_executable(${program} $<TARGET_OBJECTS:${adapter}> ${case_sources} ${PROGRAM_SOURCES})
  set_target_properties(${program} PROPERTIES
    OUTPUT_NAME "${program}" CUDA_RUNTIME_LIBRARY Static CUDA_SEPARABLE_COMPILATION OFF)
  target_include_directories(${program} PRIVATE "${vendor_samples_root}/Common" ${PROGRAM_INCLUDES})
  target_compile_definitions(${program} PRIVATE ${PROGRAM_DEFINITIONS})
  target_compile_options(${program} PRIVATE ${PROGRAM_OPTIONS})
  target_link_libraries(${program} PRIVATE Catch2::Catch2 conformance_device CUDA::cudart_static ${PROGRAM_LIBRARIES})
  conformance_register_test_program(${program} ${PROGRAM_TIMEOUT})
  list(APPEND conformance_vendor_targets ${program})
  set(conformance_vendor_targets "${conformance_vendor_targets}" PARENT_SCOPE)
endfunction()

# One cuda-samples program per sample: every sample owns its global symbols.
# Fields: directory | main source | extra sources (comma) | libraries (comma) | arguments (comma) | patches (;-list of file|before|after or <name>.cmake)
function(conformance_vendor_cuda_sample directory main extras libraries arguments)
  get_filename_component(id "${directory}" NAME)
  set(source_root "${vendor_samples_directory}/${directory}")
  if(ARGC GREATER 5 AND NOT "${ARGV5}" STREQUAL "")
    set(source_root "${vendor_programs_directory}/cuda_sample_${id}/source")
    stage_source("${vendor_samples_directory}/${directory}" "${source_root}.staging")
    foreach(patch IN LISTS ARGV5)
      if(patch MATCHES "\\.cmake$")
        include("${vendor_cuda_patch_directory}/${patch}")
        continue()
      endif()
      string(REPLACE "|" ";" fields "${patch}")
      list(GET fields 0 file)
      list(GET fields 1 before)
      list(GET fields 2 after)
      patch_exact("${source_root}.staging/${file}" "${before}" "${after}")
    endforeach()
    commit_staged_source("${source_root}.staging" "${source_root}")
  endif()
  set(sources)
  foreach(source IN ITEMS ${main} ${extras})
    list(APPEND sources "${source_root}/${source}")
  endforeach()
  list(GET sources 0 main_source)
  list(REMOVE_AT sources 0)
  string(REPLACE "," ";" libraries "${libraries}")
  set(options)
  if("gomp" IN_LIST libraries)
    set(options -Xcompiler=-fopenmp)
  endif()
  conformance_vendor_cuda_program(vendor_cuda_sample_${id}
    TAG "[vendor][cuda-samples]${vendor_release_tag}"
    CASES "${id}|vendor/cuda-samples/${id}|${main_source}|${arguments}"
    SOURCES ${sources}
    LIBRARIES ${libraries}
    OPTIONS ${options}
    INCLUDES "${source_root}")
  set(conformance_vendor_targets "${conformance_vendor_targets}" PARENT_SCOPE)
endfunction()

