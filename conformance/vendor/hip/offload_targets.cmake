find_program(conformance_vendor_objcopy llvm-objcopy HINTS "${ROCM_ROOT}/llvm/bin" REQUIRED)
find_program(conformance_vendor_bundler clang-offload-bundler HINTS "${ROCM_ROOT}/llvm/bin" REQUIRED)

function(conformance_vendor_offload_targets library result)
  file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/vendor_hip")
  set(fatbin "${CMAKE_CURRENT_BINARY_DIR}/vendor_hip/${library}.hip_fatbin")
  set(bundle "${CMAKE_CURRENT_BINARY_DIR}/vendor_hip/${library}.bundle")
  get_filename_component(path "${ROCM_ROOT}/lib/lib${library}.so" REALPATH)
  get_filename_component(dir "${path}" DIRECTORY)

  execute_process(COMMAND "${conformance_vendor_objcopy}" "--dump-section=.hip_fatbin=${fatbin}" "${path}" /dev/null
    COMMAND_ERROR_IS_FATAL ANY)

  file(READ "${fatbin}" header LIMIT 24 HEX)
  string(SUBSTRING "${header}" 0 8 magic)
  if(magic STREQUAL "43434f42")
    # the bundler rejects the section padding that follows a compressed (CCOB) payload
    string(SUBSTRING "${header}" 8 2 version_lo)
    string(SUBSTRING "${header}" 10 2 version_hi)
    math(EXPR version "0x${version_hi}${version_lo}")
    if(version GREATER_EQUAL 3)
      set(length_bytes 8)
    else()
      set(length_bytes 4)
    endif()
    math(EXPR last_byte "${length_bytes} - 1")
    set(length_hex "")
    foreach(index RANGE ${last_byte})
      math(EXPR offset "16 + 2 * ${index}")
      string(SUBSTRING "${header}" ${offset} 2 byte)
      set(length_hex "${byte}${length_hex}")
    endforeach()
    math(EXPR length "0x${length_hex}")
    execute_process(COMMAND head -c "${length}" "${fatbin}" OUTPUT_FILE "${bundle}" COMMAND_ERROR_IS_FATAL ANY)
  else()
    set(bundle "${fatbin}")
  endif()

  execute_process(COMMAND "${conformance_vendor_bundler}" -type=o "-input=${bundle}" -list
    OUTPUT_VARIABLE listing COMMAND_ERROR_IS_FATAL ANY)
  file(REMOVE "${fatbin}" "${bundle}")

  string(REPLACE "\n" ";" listing "${listing}")
  set(targets)
  foreach(entry IN LISTS listing)
    if(entry MATCHES "amdgcn.*--([^:]+)")
      list(APPEND targets "${CMAKE_MATCH_1}")
    endif()
  endforeach()

  if(library STREQUAL "rocblas")
    file(GLOB files "${dir}/rocblas/library/*")
    set(kernels)
    foreach(file IN LISTS files)
      if(file MATCHES "(gfx[0-9a-f]+)\\.(co|hsaco)$")
        list(APPEND kernels "${CMAKE_MATCH_1}")
      endif()
    endforeach()
    set(filtered)
    foreach(target IN LISTS targets)
      if(target IN_LIST kernels)
        list(APPEND filtered "${target}")
      endif()
    endforeach()
    set(targets ${filtered})
  endif()

  list(REMOVE_DUPLICATES targets)
  list(SORT targets)
  set(${result} "${targets}" PARENT_SCOPE)
endfunction()
