cmake_minimum_required(VERSION 3.25)

# Arguments follow -- so compiler/build flags remain ordinary arguments.
math(EXPR last "${CMAKE_ARGC} - 1")
foreach(index RANGE 0 ${last})
  if(CMAKE_ARGV${index} STREQUAL "--")
    math(EXPR first "${index} + 1")
    break()
  endif()
endforeach()
set(index ${first})
set(mode "${CMAKE_ARGV${index}}")
if(mode STREQUAL "prepare")
  set(parameters directory jobs ninja make)
elseif(mode STREQUAL "container")
  set(parameters executable verb)
elseif(mode STREQUAL "cleanup")
  set(parameters record)
else()
  message(FATAL_ERROR "Unknown jobserver operation: ${mode}")
endif()
foreach(parameter IN LISTS parameters)
  math(EXPR index "${index} + 1")
  set(${parameter} "${CMAKE_ARGV${index}}")
endforeach()
math(EXPR index "${index} + 1")
set(arguments)
while(index LESS CMAKE_ARGC)
  string(REPLACE ";" "\\;" argument "${CMAKE_ARGV${index}}")
  list(APPEND arguments "${argument}")
  math(EXPR index "${index} + 1")
endwhile()

function(require_version executable minimum)
  execute_process(COMMAND "${executable}" --version OUTPUT_VARIABLE output
    RESULT_VARIABLE status)
  string(REGEX MATCH "[0-9]+\\.[0-9]+" version "${output}")
  if(NOT status EQUAL 0 OR NOT version OR version VERSION_LESS minimum)
    message(FATAL_ERROR "${executable} >= ${minimum} required for FIFO jobserver support")
  endif()
endfunction()

# Make recipes use shell quoting followed by Make's dollar escaping.
function(shell_quote value output)
  if(value MATCHES "[\r\n]")
    message(FATAL_ERROR "Newlines are not supported in build command arguments")
  endif()
  string(REPLACE "'" "'\"'\"'" value "${value}")
  set(${output} "'${value}'" PARENT_SCOPE)
endfunction()

if(mode STREQUAL "prepare")
  if(NOT jobs MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "Job budget must be positive")
  endif()
  require_version("${make}" 4.4)
  list(FIND arguments "--build" build_index)
  if(NOT build_index EQUAL -1)
    math(EXPR build_index "${build_index} + 1")
    list(GET arguments ${build_index} build_directory)
    if(EXISTS "${build_directory}/CMakeCache.txt")
      file(STRINGS "${build_directory}/CMakeCache.txt" cache_line REGEX "^CMAKE_MAKE_PROGRAM:[^=]+=.+$")
      if(cache_line)
        string(REGEX REPLACE "^[^=]+=" "" ninja "${cache_line}")
      endif()
    endif()
  endif()
  require_version("${ninja}" 1.13)
  if(jobs EQUAL 1)
    # Make -j1 has no FIFO; explicitly serialize both scheduler levels.
    list(GET arguments 0 executable)
    get_filename_component(name "${executable}" NAME)
    if(name MATCHES "ninja")
      list(APPEND arguments -j1)
    elseif(name MATCHES "cmake" AND NOT build_index EQUAL -1)
      list(APPEND arguments --parallel 1)
    else()
      message(FATAL_ERROR "Serial mode requires a CMake build or Ninja command")
    endif()
  endif()
  set(recipe "")
  foreach(argument IN LISTS arguments)
    shell_quote("${argument}" quoted)
    string(APPEND recipe " ${quoted}")
  endforeach()
  string(REPLACE "$" "$$" recipe "${recipe}")
  file(WRITE "${directory}/Makefile" ".PHONY: all\nall:\n\t+${recipe}\n")
elseif(mode STREQUAL "container")
  if(NOT verb STREQUAL "run")
    message(FATAL_ERROR "Container mode requires an OCI run command")
  endif()
  set(directory "$ENV{CONFORMANCE_JOBSERVER_DIRECTORY}")
  if(NOT directory)
    set(jobs "$ENV{CMAKE_BUILD_PARALLEL_LEVEL}")
    if(jobs STREQUAL "")
      set(jobs 4)
    endif()
    if(NOT jobs MATCHES "^[1-9][0-9]*$")
      message(FATAL_ERROR "CMAKE_BUILD_PARALLEL_LEVEL must be positive")
    endif()
    execute_process(COMMAND "${executable}" run --env "CMAKE_BUILD_PARALLEL_LEVEL=${jobs}"
      ${arguments} COMMAND_ERROR_IS_FATAL ANY)
    return()
  endif()
  set(flags "$ENV{MAKEFLAGS}")
  set(jobs "")
  if("$ENV{CONFORMANCE_JOBSERVER_SERIAL}" STREQUAL "1")
    set(jobs 1)
  else()
    string(REGEX MATCH "--jobserver-auth=fifo:([^ \t]+)" auth "${flags}")
    set(fifo "${CMAKE_MATCH_1}")
    get_filename_component(parent "${fifo}" DIRECTORY)
    execute_process(COMMAND test -p "${fifo}" RESULT_VARIABLE status)
    if(NOT auth OR NOT parent STREQUAL directory OR NOT status EQUAL 0)
      message(FATAL_ERROR "Missing invocation-owned FIFO jobserver")
    endif()
  endif()
  string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef identity)
  set(record "${directory}/${identity}")
  if(executable MATCHES "[\r\n]")
    message(FATAL_ERROR "Invalid container executable")
  endif()
  file(WRITE "${record}.runtime" "${executable}")
  # The outer Ninja edge already owns the inner Ninja's implicit slot.
  execute_process(
    COMMAND "${executable}" run --init --cidfile "${record}.cid"
      --env "MAKEFLAGS=${flags}" --env "CMAKE_BUILD_PARALLEL_LEVEL=${jobs}"
      --mount "type=bind,source=${directory},target=${directory}" ${arguments}
    COMMAND sh "${CMAKE_CURRENT_LIST_DIR}/jobserver.sh" --stream "${record}.progress"
    RESULTS_VARIABLE statuses)
  foreach(status IN LISTS statuses)
    if(NOT status STREQUAL "0")
      message(FATAL_ERROR "Artifact container failed: ${status}")
    endif()
  endforeach()
elseif(mode STREQUAL "cleanup")
  if(EXISTS "${record}.cid")
    file(READ "${record}.runtime" executable)
    file(READ "${record}.cid" identity)
    string(STRIP "${identity}" identity)
    string(LENGTH "${identity}" length)
    if(identity MATCHES "^[0-9a-f]+$" AND length GREATER_EQUAL 12 AND length LESS_EQUAL 64)
      execute_process(COMMAND "${executable}" stop --time 2 "${identity}"
        TIMEOUT 6 OUTPUT_QUIET ERROR_QUIET)
      execute_process(COMMAND "${executable}" rm --force "${identity}"
        TIMEOUT 6 OUTPUT_QUIET ERROR_QUIET)
    endif()
  endif()
else()
  message(FATAL_ERROR "Unknown jobserver operation: ${mode}")
endif()
