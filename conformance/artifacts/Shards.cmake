cmake_minimum_required(VERSION 3.25)

# Prints the CI shards of a target set as the include list of a GitHub Actions matrix, for the artifact build or the
# emulated run.
#
#   cmake -DCONFORMANCE_TARGET_SET=<target set> -DMODE=build|run -P Shards.cmake
#
# A route belongs to the group of the first pattern it matches; a route that matches none goes to shard 0 of the first
# group, with a warning, so a new route still builds and runs. A group cuts its architectures, in route order, into
# equal consecutive slices, one per shard, so a build selector keeps the compilers of its architecture together and
# neighbouring architectures of a family share a shard. A group with a SPLIT variable builds its routes on every build
# shard, with the variable set to the shard index. Empty shards are left out.
#
# Every build shard assembles the support closures its routes load, and closures of one key are identical, so only the
# lowest build shard holding a key packs it, as the support artifact of that shard. A build entry names the paths it
# leaves out of its package and the ones it packs as its support artifact. CI joins every build artifact into one full
# package, which every run shard takes. The SHARED directory of a split route holds the closure of each shard of it, so
# only shard 0 packs it.
#
# A run shard of a group with CASES <n> runs as n shards, each taking every n-th case of its routes through
# CONFORMANCE_CASE_SHARD, for routes too long for one runner that slicing cannot cut.

if(NOT MODE MATCHES "^(build|run)$")
  message(FATAL_ERROR "usage: cmake -DCONFORMANCE_TARGET_SET=<target set> -DMODE=build|run -P Shards.cmake")
endif()

set(shard_groups)
function(shard_group name)
  cmake_parse_arguments(PARSE_ARGV 1 ARG "" "BUILD;RUN;CASES;SPLIT;SHARED;PATTERN" "")
  set(shard_groups ${shard_groups} "${name}" PARENT_SCOPE)
  set(shard_${name}_build "${ARG_BUILD}" PARENT_SCOPE)
  set(shard_${name}_run "${ARG_RUN}" PARENT_SCOPE)
  if(NOT DEFINED ARG_CASES)
    set(ARG_CASES 1)
  endif()
  set(shard_${name}_cases "${ARG_CASES}" PARENT_SCOPE)
  set(shard_${name}_split "${ARG_SPLIT}" PARENT_SCOPE)
  set(shard_${name}_shared "${ARG_SHARED}" PARENT_SCOPE)
  set(shard_${name}_pattern "${ARG_PATTERN}" PARENT_SCOPE)
endfunction()

# 0 shards leave a group out of CI. The SYCL build count is the SYCL CTS shard count in cts/sycl/CMakeLists.txt; the
# build rejects a shard past it and Merge.cmake rejects a missing one.
shard_group(cuda BUILD 5 RUN 10 PATTERN "^(cuda-|openacc/)")
shard_group(amd BUILD 9 RUN 3 PATTERN "^(hip|hsa)/")
shard_group(opencl BUILD 1 RUN 1 CASES 4 PATTERN "^opencl$")
shard_group(levelzero BUILD 1 RUN 1 PATTERN "^levelzero$")
shard_group(sycl BUILD 4 RUN 1 SPLIT CONFORMANCE_SYCL_SHARD_INDEX SHARED lib PATTERN "^sycl$")
shard_group(vulkan BUILD 1 RUN 1 PATTERN "^vulkan$")

include("${CMAKE_CURRENT_LIST_DIR}/Targets.cmake")

list(GET shard_groups 0 fallback)
set(matched)
foreach(route IN LISTS conformance_execution_routes)
  set(group "")
  foreach(candidate IN LISTS shard_groups)
    if(route MATCHES "${shard_${candidate}_pattern}")
      set(group "${candidate}")
      break()
    endif()
  endforeach()
  string(REGEX REPLACE "^cuda-(ptx|sass)/" "cuda/" artifact "${route}")
  string(REPLACE "/" ";" parts "${artifact}")
  list(LENGTH parts length)
  if(MODE STREQUAL "run")
    set(selector "${route}")
  elseif(length GREATER 1)
    list(GET parts 0 1 selector)
    list(JOIN selector "/" selector)
  else()
    set(selector "${artifact}")
  endif()
  if(group STREQUAL "")
    message(NOTICE "warning: route ${route} matches no shard pattern; it goes to ${fallback}-0")
    set(group "${fallback}")
    set(slot -1)
  else()
    list(APPEND matched "${group}")
    if(length GREATER 1)
      list(GET parts 1 architecture)
    else()
      set(architecture "${artifact}")
    endif()
    list(FIND units_${group} "${architecture}" slot)
    if(slot LESS 0)
      list(LENGTH units_${group} slot)
      list(APPEND units_${group} "${architecture}")
    endif()
  endif()
  if(NOT selector IN_LIST selectors_${group})
    list(APPEND selectors_${group} "${selector}")
    list(APPEND slots_${group} "${slot}")
  endif()
  if(length GREATER 1)
    list(GET parts 0 backend)
    set(compiler vendor)
    if(length GREATER 2)
      list(GET parts 2 compiler)
    endif()
    conformance_support_key("${backend}" "${architecture}" "${compiler}" support)
    list(APPEND support_keys_${group} "${backend}/${support}")
    list(APPEND support_slots_${group} "${slot}")
  endif()
endforeach()

set(entries)
foreach(group IN LISTS shard_groups)
  if(NOT group IN_LIST matched)
    message(NOTICE "warning: shard pattern ${shard_${group}_pattern} of ${group} matches no route")
  endif()
  set(shards "${shard_${group}_${MODE}}")
  if(shards EQUAL 0)
    continue()
  endif()
  list(LENGTH units_${group} units)
  set(split "")
  if(MODE STREQUAL "build")
    set(split "${shard_${group}_split}")
  endif()
  set(supports)
  set(support_owners)
  if(MODE STREQUAL "build")
    foreach(support slot IN ZIP_LISTS support_keys_${group} support_slots_${group})
      set(owner 0)
      if(slot GREATER_EQUAL 0)
        math(EXPR owner "${slot} * ${shards} / ${units}")
      endif()
      list(FIND supports "${support}" index)
      if(index LESS 0)
        list(APPEND supports "${support}")
        list(APPEND support_owners "${owner}")
      else()
        list(GET support_owners ${index} previous)
        if(owner LESS previous)
          list(REMOVE_AT support_owners ${index})
          list(INSERT support_owners ${index} "${owner}")
        endif()
      endif()
    endforeach()
  endif()
  math(EXPR last "${shards} - 1")
  foreach(shard RANGE ${last})
    set(routes)
    foreach(selector slot IN ZIP_LISTS selectors_${group} slots_${group})
      if(slot LESS 0)
        set(owner 0)
      elseif(split STREQUAL "")
        math(EXPR owner "${slot} * ${shards} / ${units}")
      else()
        set(owner "${shard}")
      endif()
      if(owner EQUAL shard)
        list(APPEND routes "${selector}")
      endif()
    endforeach()
    if(NOT routes)
      continue()
    endif()
    list(JOIN routes " " routes)
    if(MODE STREQUAL "build")
      set(entry "{\"shard\":\"${group}-${shard}\",\"routes\":\"${routes}\"")
      if(split STREQUAL "")
        string(APPEND entry ",\"split\":\"\"")
      else()
        string(APPEND entry ",\"split\":\"${split}=${shard}\"")
      endif()
      set(excluded "${supports}")
      if(NOT split STREQUAL "" AND NOT shard_${group}_shared STREQUAL "" AND shard GREATER 0)
        foreach(route IN LISTS routes)
          list(APPEND excluded "${route}-shard-${shard}/${shard_${group}_shared}")
        endforeach()
      endif()
      set(owned)
      foreach(support owner IN ZIP_LISTS supports support_owners)
        if(owner EQUAL shard)
          list(APPEND owned "${support}")
        endif()
      endforeach()
      list(JOIN excluded " " excluded)
      list(JOIN owned " " owned)
      list(APPEND entries "${entry},\"excluded\":\"${excluded}\",\"owned\":\"${owned}\"}")
    else()
      set(cases "${shard_${group}_cases}")
      math(EXPR last_case "${cases} - 1")
      foreach(case RANGE ${last_case})
        math(EXPR index "${shard} * ${cases} + ${case}")
        set(selection "")
        if(cases GREATER 1)
          set(selection "${case}/${cases}")
        endif()
        list(APPEND entries
          "{\"shard\":\"${group}-${index}\",\"routes\":\"${routes}\",\"cases\":\"${selection}\"}")
      endforeach()
    endif()
  endforeach()
endforeach()
list(JOIN entries "," entries)
execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "[${entries}]" COMMAND_ERROR_IS_FATAL ANY)
