cmake_minimum_required(VERSION 3.25)

# The build profile is `complete`, or a machine profile of conformance/profiles that selects the architectures its targets
# name. Without one, the profile named after the local short hostname applies.
if(NOT DEFINED CONFORMANCE_BUILD_PROFILE OR CONFORMANCE_BUILD_PROFILE STREQUAL "")
  if(NOT "$ENV{HOSTNAME}" STREQUAL "")
    set(CONFORMANCE_BUILD_PROFILE "$ENV{HOSTNAME}")
  else()
    cmake_host_system_information(RESULT CONFORMANCE_BUILD_PROFILE QUERY HOSTNAME)
  endif()
  string(REGEX REPLACE "\\..*$" "" CONFORMANCE_BUILD_PROFILE "${CONFORMANCE_BUILD_PROFILE}")
endif()

if(NOT CONFORMANCE_BUILD_PROFILE MATCHES "^[A-Za-z0-9_.-]+$")
  message(FATAL_ERROR "Invalid CONFORMANCE_BUILD_PROFILE: ${CONFORMANCE_BUILD_PROFILE}")
endif()
if(CONFORMANCE_BUILD_PROFILE STREQUAL "complete")
  include("${CMAKE_CURRENT_LIST_DIR}/targets/complete.cmake")
else()
  set(machine_profile "${CMAKE_CURRENT_LIST_DIR}/../profiles/${CONFORMANCE_BUILD_PROFILE}.toml")
  if(NOT EXISTS "${machine_profile}")
    message(FATAL_ERROR "Unknown conformance build profile: ${CONFORMANCE_BUILD_PROFILE}; expected complete or a machine profile")
  endif()
  file(STRINGS "${machine_profile}" profile_lines REGEX "^(backend|architecture) *= *[\"']")
  set(profile_backends)
  set(profile_cuda_architectures)
  set(profile_amdgpu_architectures)
  foreach(line IN LISTS profile_lines)
    string(REGEX REPLACE "^([a-z]+) *= *[\"']([^\"']*)[\"'].*$" "\\1;\\2" fields "${line}")
    list(GET fields 0 key)
    list(GET fields 1 value)
    if(key STREQUAL "backend")
      list(APPEND profile_backends "${value}")
    elseif(value MATCHES "^sm_")
      list(APPEND profile_cuda_architectures "${value}")
    else()
      list(APPEND profile_amdgpu_architectures "${value}")
    endif()
  endforeach()
  if(NOT DEFINED CONFORMANCE_BACKENDS)
    set(CONFORMANCE_BACKENDS ${profile_backends})
  endif()
  if(NOT DEFINED CUDA_ARCHITECTURES)
    set(CUDA_ARCHITECTURES ${profile_cuda_architectures})
  endif()
  if(NOT DEFINED AMDGPU_ARCHITECTURES)
    set(AMDGPU_ARCHITECTURES ${profile_amdgpu_architectures})
  endif()
endif()

if(NOT DEFINED CONFORMANCE_COMPILERS)
  set(CONFORMANCE_COMPILERS vendor clang gcc)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/Toolchains.cmake")
foreach(variable IN ITEMS CONFORMANCE_BACKENDS CUDA_ARCHITECTURES AMDGPU_ARCHITECTURES CONFORMANCE_COMPILERS)
  string(REPLACE "," ";" "${variable}" "${${variable}}")
  list(REMOVE_DUPLICATES "${variable}")
endforeach()
foreach(compiler IN LISTS CONFORMANCE_COMPILERS)
  if(NOT compiler MATCHES "^(vendor|clang|gcc)$")
    message(FATAL_ERROR "Unknown conformance compiler: ${compiler}")
  endif()
endforeach()

foreach(architecture IN LISTS CUDA_ARCHITECTURES)
  if(NOT architecture MATCHES "^sm_[0-9]+[af]?$")
    message(FATAL_ERROR "Invalid CUDA architecture: ${architecture}")
  endif()
endforeach()
foreach(architecture IN LISTS AMDGPU_ARCHITECTURES)
  if(NOT architecture MATCHES "^gfx[0-9a-f]+$")
    message(FATAL_ERROR "Invalid AMDGPU architecture: ${architecture}")
  endif()
endforeach()

set(supported_backends cuda hip hsa opencl sycl levelzero vulkan openacc)
foreach(backend IN LISTS CONFORMANCE_BACKENDS)
  if(NOT backend IN_LIST supported_backends)
    message(FATAL_ERROR "Unsupported conformance backend: ${backend}")
  endif()
endforeach()
if("cuda" IN_LIST CONFORMANCE_BACKENDS OR "openacc" IN_LIST CONFORMANCE_BACKENDS)
  if(NOT CUDA_ARCHITECTURES)
    message(FATAL_ERROR "CUDA_ARCHITECTURES is required by the selected backends")
  endif()
endif()
if("hip" IN_LIST CONFORMANCE_BACKENDS OR "hsa" IN_LIST CONFORMANCE_BACKENDS)
  if(NOT AMDGPU_ARCHITECTURES)
    message(FATAL_ERROR "AMDGPU_ARCHITECTURES is required by the selected backends")
  endif()
endif()

set(conformance_routes)
foreach(backend IN LISTS CONFORMANCE_BACKENDS)
  if(backend MATCHES "^(cuda|openacc)$")
    set(architectures ${CUDA_ARCHITECTURES})
  elseif(backend MATCHES "^(hip|hsa)$")
    set(architectures ${AMDGPU_ARCHITECTURES})
    if(backend STREQUAL "hip" AND "gfx908" IN_LIST architectures)
      # The first route builds the shared HIP closure, which must include rocBLAS, unavailable on gfx803.
      list(REMOVE_ITEM architectures gfx908)
      list(PREPEND architectures gfx908)
    endif()
  else()
    set(architectures neutral)
  endif()
  foreach(compiler IN LISTS CONFORMANCE_COMPILERS)
    foreach(architecture IN LISTS architectures)
      conformance_compiler_supported("${backend}" "${architecture}" "${compiler}" supported)
      if(NOT supported)
        continue()
      endif()
      set(route "${backend}")
      if(NOT architecture STREQUAL "neutral")
        string(APPEND route "/${architecture}")
      endif()
      if(NOT compiler STREQUAL "vendor")
        string(APPEND route "/${compiler}")
      endif()
      list(APPEND conformance_routes "${route}")
    endforeach()
  endforeach()
endforeach()

if(NOT conformance_routes)
  message(FATAL_ERROR "No supported backend/architecture/compiler combinations selected")
endif()

set(conformance_execution_routes)
foreach(route IN LISTS conformance_routes)
  if(route MATCHES "^cuda/(.+)$")
    set(suffix "${CMAKE_MATCH_1}")
    list(APPEND conformance_execution_routes "cuda-ptx/${suffix}")
    if(NOT route MATCHES "/gcc$")
      list(APPEND conformance_execution_routes "cuda-sass/${suffix}")
    endif()
  else()
    list(APPEND conformance_execution_routes "${route}")
  endif()
endforeach()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
  string(REPLACE ";" "\n" routes "${conformance_execution_routes}")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${routes}" COMMAND_ERROR_IS_FATAL ANY)
endif()
