include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/ElfVersions.cmake")

function(conformance_floor root sysroot glibc_var glibcxx_var)
  set(glibc_floor "")
  set(glibcxx_floor "")
  if(sysroot)
    read_elf_versions("${sysroot}/lib64/libc.so.6" libc_defs libc_needs)
    highest_version(GLIBC "${libc_defs}" glibc_floor)
    read_elf_versions("${sysroot}/lib64/libstdc++.so.6" libstdcxx_defs libstdcxx_needs)
    highest_version(GLIBCXX "${libstdcxx_defs}" glibcxx_floor)
    if(NOT glibc_floor OR NOT glibcxx_floor)
      message(FATAL_ERROR "no GLIBC_ or GLIBCXX_ definitions in the sysroot ${sysroot}")
    endif()
  endif()

  file(GLOB_RECURSE candidates LIST_DIRECTORIES FALSE "${root}/*")
  set(needs "")
  set(problems "")
  foreach(candidate IN LISTS candidates)
    file(READ "${candidate}" magic LIMIT 4 HEX)
    if(NOT magic STREQUAL "7f454c46")
      continue()
    endif()
    read_elf_versions("${candidate}" object_defs object_needs)
    list(APPEND needs ${object_needs})
    if(sysroot)
      exceeding_versions(GLIBC "${glibc_floor}" "${object_needs}" glibc_exceeding)
      exceeding_versions(GLIBCXX "${glibcxx_floor}" "${object_needs}" glibcxx_exceeding)
      foreach(name IN LISTS glibc_exceeding glibcxx_exceeding)
        list(APPEND problems "${candidate} requires ${name}")
      endforeach()
    endif()
  endforeach()

  highest_version(GLIBC "${needs}" glibc)
  highest_version(GLIBCXX "${needs}" glibcxx)
  set(${glibc_var} "${glibc}" PARENT_SCOPE)
  set(${glibcxx_var} "${glibcxx}" PARENT_SCOPE)

  if(problems)
    list(REMOVE_DUPLICATES problems)
    list(JOIN problems "\n  " listing)
    message(FATAL_ERROR
      "objects under ${root} exceed the sysroot floor GLIBC_${glibc_floor} and GLIBCXX_${glibcxx_floor}:\n  ${listing}")
  endif()
endfunction()
