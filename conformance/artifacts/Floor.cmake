include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/ElfVersions.cmake")

set(conformance_floor_families GLIBC GLIBCXX CXXABI GCC)

function(conformance_floor root sysroot glibc_var glibcxx_var)
  if(sysroot)
    set(sysroot_defs "")
    foreach(library IN ITEMS libc.so.6 libstdc++.so.6 libgcc_s.so.1)
      if(EXISTS "${sysroot}/lib64/${library}")
        read_elf_versions("${sysroot}/lib64/${library}" defs unused_needs)
        list(APPEND sysroot_defs ${defs})
      endif()
    endforeach()
    foreach(family IN LISTS conformance_floor_families)
      highest_version(${family} "${sysroot_defs}" floor_${family})
    endforeach()
    foreach(family GLIBC GLIBCXX CXXABI)
      if(NOT floor_${family})
        message(FATAL_ERROR "no ${family}_ definitions in the sysroot ${sysroot}")
      endif()
    endforeach()
  endif()

  file(GLOB_RECURSE candidates LIST_DIRECTORIES FALSE "${root}/*")
  set(needs "")
  set(problems "")
  foreach(candidate IN LISTS candidates)
    file(READ "${candidate}" magic LIMIT 4 HEX)
    if(NOT magic STREQUAL "7f454c46")
      continue()
    endif()
    read_elf_versions("${candidate}" object_defs object_needs)
    list(APPEND needs ${object_needs})
    if(sysroot)
      foreach(family IN LISTS conformance_floor_families)
        if(floor_${family})
          exceeding_versions(${family} "${floor_${family}}" "${object_needs}" exceeding)
          foreach(name IN LISTS exceeding)
            list(APPEND problems "${candidate} requires ${name}")
          endforeach()
        endif()
      endforeach()
    endif()
  endforeach()

  highest_version(GLIBC "${needs}" glibc)
  highest_version(GLIBCXX "${needs}" glibcxx)
  set(${glibc_var} "${glibc}" PARENT_SCOPE)
  set(${glibcxx_var} "${glibcxx}" PARENT_SCOPE)

  if(problems)
    list(REMOVE_DUPLICATES problems)
    list(JOIN problems "\n  " listing)
    set(floor_names "")
    foreach(family IN LISTS conformance_floor_families)
      if(floor_${family})
        list(APPEND floor_names "${family}_${floor_${family}}")
      endif()
    endforeach()
    list(JOIN floor_names " " floor_text)
    message(FATAL_ERROR
      "objects under ${root} exceed the sysroot floor ${floor_text}:\n  ${listing}")
  endif()
endfunction()
