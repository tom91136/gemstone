cmake_minimum_required(VERSION 3.25)

# Joins the sycl-shard-<n> artifacts into the sycl artifact. Every shard holds a
# disjoint part of the suites and its own runtime closure, so the result is the
# union of their files and test program manifests.
#
#   cmake -DARTIFACTS=<artifact directory> -P Merge.cmake

if(NOT DEFINED ARTIFACTS OR ARTIFACTS STREQUAL "")
  message(FATAL_ERROR "usage: cmake -DARTIFACTS=<artifact directory> -P Merge.cmake")
endif()

file(GLOB shards LIST_DIRECTORIES TRUE "${ARTIFACTS}/sycl-shard-*")
set(count "")
set(indices)
foreach(shard IN LISTS shards)
  if(NOT EXISTS "${shard}/shard.txt")
    message(FATAL_ERROR "Incomplete shard: ${shard}")
  endif()
  file(READ "${shard}/shard.txt" marker)
  string(STRIP "${marker}" marker)
  if(NOT marker MATCHES "^([0-9]+)/([0-9]+)$")
    message(FATAL_ERROR "Invalid shard marker in ${shard}: ${marker}")
  endif()
  if(NOT count STREQUAL "" AND NOT count STREQUAL CMAKE_MATCH_2)
    message(FATAL_ERROR "Shards disagree on the shard count: ${count} and ${CMAKE_MATCH_2}")
  endif()
  set(count "${CMAKE_MATCH_2}")
  list(APPEND indices "${CMAKE_MATCH_1}")
endforeach()
if(count STREQUAL "")
  message(FATAL_ERROR "No sycl-shard-* artifacts in ${ARTIFACTS}")
endif()
math(EXPR last "${count} - 1")
foreach(index RANGE 0 ${last})
  if(NOT index IN_LIST indices)
    message(FATAL_ERROR "Missing shard ${index} of ${count}")
  endif()
endforeach()

set(output "${ARTIFACTS}/sycl")
file(REMOVE_RECURSE "${output}")
file(MAKE_DIRECTORY "${output}")
set(programs)
foreach(shard IN LISTS shards)
  file(GLOB entries LIST_DIRECTORIES TRUE "${shard}/*")
  foreach(entry IN LISTS entries)
    get_filename_component(name "${entry}" NAME)
    if(NOT name MATCHES "^(shard|test-programs)\\.txt$")
      file(COPY "${entry}" DESTINATION "${output}")
    endif()
  endforeach()
  file(STRINGS "${shard}/test-programs.txt" lines)
  list(APPEND programs ${lines})
endforeach()
list(REMOVE_DUPLICATES programs)
list(SORT programs)
list(JOIN programs "\n" manifest)
file(WRITE "${output}/test-programs.txt" "${manifest}\n")

foreach(entry IN LISTS programs)
  string(REGEX REPLACE "\t.*$" "" program "${entry}")
  if(NOT EXISTS "${output}/${program}")
    message(FATAL_ERROR "The merged artifact is missing ${program}")
  endif()
endforeach()
