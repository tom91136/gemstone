# Values the CMake driver supplies (CUDA_IMAGE, CUDA_PACKAGE_VERSION,
# ROCM_VERSION) carry no usable default here; their authority is
# Toolchains.cmake or build.sbt, and a fallback would only let the two drift
# apart. CUDA_IMAGE names no image so BuildKit, which rejects a blank FROM in
# any stage, still builds the routes that leave it unset.
ARG UBUNTU_IMAGE=docker.io/library/ubuntu@sha256:1e0a86e57d247923571b75e0aaf48a1449cf8c543d51fb3e07a4a7d7bfa79316
ARG CUDA_IMAGE=cuda-image-not-supplied
ARG SYCL_IMAGE=docker.io/intel/oneapi-toolkit@sha256:e9db518398753434ee5aab9740a25f1d3134396a30be1569cfad8f8b0d90740c
# The package versions SYCL_IMAGE carries; lint-sycl installs the same ones without the rest of the toolkit.
ARG ONEAPI_VERSION=2026.1
ARG ONEAPI_DPCPP_PACKAGE=2026.1.0-235
ARG ONEAPI_MKL_PACKAGE=2026.1.0-236
ARG NVHPC_IMAGE=nvcr.io/nvidia/nvhpc@sha256:25621a24ed39fe0dce3e9458e56e3f11194c122ac0206a44532246a58972a854

ARG CUDA_PACKAGE_VERSION
ARG CMAKE_VERSION=3.31.10
ARG CMAKE_LINUX_X86_64_SHA256=3cb3dd247b6a1de2d0f4b20c6fd4326c9024e894cebc9dc8699758887e566ca7
ARG ROCM_VERSION
ARG ROCM_DISTRIBUTION=noble

# Mirrors answer 503 now and then, and a stage that loses a package fails the whole build, so
# every apt and curl call in this file retries instead of giving up on the first error.
FROM ${UBUNTU_IMAGE} AS network-config
USER root
RUN printf '%s\n' \
      'Acquire::Retries "5";' \
      'Acquire::http::Timeout "30";' \
      'Acquire::https::Timeout "30";' \
    > /etc/apt/apt.conf.d/80-retries \
 && printf '%s\n' \
      'fail' \
      'silent' \
      'show-error' \
      'location' \
      'retry = 5' \
      'retry-all-errors' \
      'retry-delay = 30' \
      'connect-timeout = 30' \
    > /root/.curlrc
ENV CURL_HOME=/root

FROM network-config AS ubuntu-build-base
USER root
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install --no-install-recommends --yes \
       binutils build-essential ca-certificates ccache cmake ninja-build patchelf python3 \
    && rm -rf /var/lib/apt/lists/*

# One static Ninja works across the different toolchain base distributions.
FROM ubuntu-build-base AS jobserver-ninja
RUN apt-get update && apt-get install --no-install-recommends --yes curl \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://codeload.github.com/ninja-build/ninja/tar.gz/refs/tags/v1.13.2 -o /tmp/ninja.tar.gz \
    && echo "974d6b2f4eeefa25625d34da3cb36bdcebe7fbce40f4c16ac0835fd1c0cbae17  /tmp/ninja.tar.gz" | sha256sum --check --strict \
    && mkdir /tmp/ninja-src \
    && tar -xzf /tmp/ninja.tar.gz --strip-components=1 -C /tmp/ninja-src \
    && cmake -S /tmp/ninja-src -B /tmp/ninja-build -G Ninja -DBUILD_TESTING=OFF \
       -DCMAKE_BUILD_TYPE=Release -DCMAKE_EXE_LINKER_FLAGS=-static \
    && cmake --build /tmp/ninja-build --parallel 2

FROM jobserver-ninja AS cmake-release
ARG CMAKE_VERSION
ARG CMAKE_LINUX_X86_64_SHA256
RUN archive="cmake-${CMAKE_VERSION}-linux-x86_64.tar.gz" \
    && curl -fsSLO "https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/${archive}" \
    && echo "${CMAKE_LINUX_X86_64_SHA256}  ${archive}" | sha256sum --check --strict \
    && mkdir -p /opt/cmake \
    && tar -xzf "${archive}" --strip-components=1 -C /opt/cmake \
    && rm "${archive}"

# The release archive is the pinned upstream build and runs on every base distribution here, where apt.llvm.org
# drops out often enough to fail whole runs. Its tools land where the distribution packages would put them.
FROM jobserver-ninja AS llvm-tidy
ARG DEBIAN_FRONTEND=noninteractive
ARG LLVM_VERSION
ARG LLVM_RELEASE
ARG LLVM_RELEASE_SHA256
RUN apt-get update && apt-get install --no-install-recommends --yes xz-utils \
    && rm -rf /var/lib/apt/lists/*
RUN test "${LLVM_RELEASE%%.*}" = "${LLVM_VERSION}" \
    && curl -fsSL "https://github.com/llvm/llvm-project/releases/download/llvmorg-${LLVM_RELEASE}/LLVM-${LLVM_RELEASE}-Linux-X64.tar.xz" \
       -o /tmp/llvm.tar.xz \
    && echo "${LLVM_RELEASE_SHA256}  /tmp/llvm.tar.xz" | sha256sum --check --strict \
    && mkdir -p /llvm/usr/bin "/llvm/usr/lib/llvm-${LLVM_VERSION}" \
    && tar -xJf /tmp/llvm.tar.xz --strip-components=1 -C "/llvm/usr/lib/llvm-${LLVM_VERSION}" \
       "LLVM-${LLVM_RELEASE}-Linux-X64/bin/clang-tidy" "LLVM-${LLVM_RELEASE}-Linux-X64/bin/run-clang-tidy" \
       "LLVM-${LLVM_RELEASE}-Linux-X64/bin/clang-apply-replacements" "LLVM-${LLVM_RELEASE}-Linux-X64/lib/clang" \
    && for tool in clang-tidy run-clang-tidy clang-apply-replacements; do \
         ln -s "../lib/llvm-${LLVM_VERSION}/bin/${tool}" "/llvm/usr/bin/${tool}-${LLVM_VERSION}"; \
       done

FROM llvm-tidy AS llvm
ARG LLVM_VERSION
ARG LLVM_RELEASE
RUN tar -xJf /tmp/llvm.tar.xz --strip-components=1 -C "/llvm/usr/lib/llvm-${LLVM_VERSION}" \
       $(for tool in clang clang++ "clang-${LLVM_VERSION}" clang-scan-deps clang-offload-bundler clang-offload-packager \
           clang-linker-wrapper clang-nvlink-wrapper; do echo "LLVM-${LLVM_RELEASE}-Linux-X64/bin/${tool}"; done) \
    && for tool in clang clang++; do \
         ln -s "../lib/llvm-${LLVM_VERSION}/bin/${tool}" "/llvm/usr/bin/${tool}-${LLVM_VERSION}"; \
       done

FROM jobserver-ninja AS cccl
ARG CCCL_VERSION
ARG CCCL_SHA256
RUN curl -fsSL "https://codeload.github.com/NVIDIA/cccl/tar.gz/refs/tags/v${CCCL_VERSION}" -o /tmp/cccl.tar.gz \
    && echo "${CCCL_SHA256}  /tmp/cccl.tar.gz" | sha256sum --check --strict \
    && mkdir /opt/cccl \
    && tar -xzf /tmp/cccl.tar.gz --strip-components=1 -C /opt/cccl \
    && rm /tmp/cccl.tar.gz

