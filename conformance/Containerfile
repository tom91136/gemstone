    CC=/opt/rocm/llvm/bin/amdclang \
    CXX=/opt/rocm/llvm/bin/amdclang++ \
    HIPCXX=/opt/rocm/llvm/bin/amdclang++ \
    ROCM_PATH=/opt/rocm \
    CPATH=/opt/rocm/include \
    LIBRARY_PATH=/opt/rocm/lib \
    LD_LIBRARY_PATH=/opt/rocm/lib

# Make vendor runtimes discoverable by both the loader and CMake dependency scanning.
RUN printf '%s\n' /opt/rocm/lib /opt/rocm/llvm/lib \
    > /etc/ld.so.conf.d/conformance.conf && ldconfig

