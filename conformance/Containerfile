FROM ${CUDA_IMAGE} AS cuda-sdk
USER root
ARG DEBIAN_FRONTEND=noninteractive
ARG CUDA_PACKAGE_VERSION
ARG CMAKE_VERSION
ARG CMAKE_LINUX_X86_64_SHA256
COPY --from=network-config /etc/apt/apt.conf.d/80-retries /etc/apt/apt.conf.d/80-retries
COPY --from=network-config /root/.curlrc /root/.curlrc
ENV CURL_HOME=/root
RUN apt-get update \
    && apt-get install --no-install-recommends --yes \
       binutils build-essential ca-certificates curl ninja-build patchelf xz-utils \
       cuda-nvcc-${CUDA_PACKAGE_VERSION} cuda-nvdisasm-${CUDA_PACKAGE_VERSION} cuda-cudart-dev-${CUDA_PACKAGE_VERSION} \
       cuda-cccl-${CUDA_PACKAGE_VERSION} \
       libcublas-dev-${CUDA_PACKAGE_VERSION} \
    && rm -rf /var/lib/apt/lists/*
# The conformance host harness needs C++23, while nvcc 11.8 needs GCC <= 11.
# Keep the pinned SDK and use separate compilers for host and device sources.
FROM ubuntu-build-base AS toolchain-cuda
ARG DEBIAN_FRONTEND=noninteractive
ARG CUDA_PACKAGE_VERSION
COPY --from=cuda-sdk /usr/local/ /usr/local/
RUN apt-get update \
    && apt-get install --no-install-recommends --yes curl xz-utils g++-11 \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /usr/local/cuda \
    && ln -s "cuda-$(echo "${CUDA_PACKAGE_VERSION}" | tr - .)" /usr/local/cuda
ENV CUDAHOSTCXX=/usr/bin/g++-11
COPY --from=cmake-release /opt/cmake /opt/cmake
ENV PATH="/opt/cmake/bin:/usr/local/cuda/bin:${PATH}" \
    CXX=/usr/bin/g++ \
    CUDAToolkit_ROOT=/usr/local/cuda \
    CPATH=/usr/local/cuda/targets/x86_64-linux/include \
    LIBRARY_PATH=/usr/local/cuda/targets/x86_64-linux/lib \
    LD_LIBRARY_PATH=/usr/local/cuda/targets/x86_64-linux/lib:/usr/local/cuda/compat

# Make toolkit runtimes discoverable by both the loader and CMake dependency scanning.
RUN printf '%s\n' /usr/local/cuda/targets/x86_64-linux/lib \
    > /etc/ld.so.conf.d/conformance.conf && ldconfig

COPY --from=jobserver-ninja /tmp/ninja-build/ninja /usr/local/bin/ninja
COPY --from=jobserver-ninja /tmp/ninja-src/COPYING /usr/local/share/licenses/ninja/COPYING

# CUDA's frontend and device assembler are separate choices. Each Clang image
# carries a matching CCCL release instead of relying on the SDK's bundled headers.
FROM cuda-sdk AS clang-cuda-headers
ARG DEBIAN_FRONTEND=noninteractive
ARG CUDA_PACKAGE_VERSION
RUN apt-get update \
    && apt-get install --no-install-recommends --yes libcurand-dev-${CUDA_PACKAGE_VERSION} \
    && mkdir /clang-cuda-headers \
    && cp /usr/local/cuda/include/curand*.h /clang-cuda-headers/ \
    && rm -rf /var/lib/apt/lists/*

FROM toolchain-cuda AS toolchain-clang-cuda
COPY --from=clang-cuda-headers /clang-cuda-headers/ /opt/cuda-clang-headers/
ARG LLVM_VERSION
COPY --from=llvm /llvm/ /
COPY --from=cccl /opt/cccl /opt/cccl
RUN ln -s /usr/bin/clang-${LLVM_VERSION} /usr/local/bin/clang \
    && ln -s /usr/bin/clang++-${LLVM_VERSION} /usr/local/bin/clang++
ENV PATH=/usr/lib/llvm-${LLVM_VERSION}/bin:${PATH} \
    CC=/usr/local/bin/clang CXX=/usr/local/bin/clang++ CUDACXX=/usr/local/bin/clang++ \
    CPATH=/opt/cuda-clang-headers:/opt/cccl/thrust:/opt/cccl/cub:/opt/cccl/libcudacxx/include:/usr/local/cuda/targets/x86_64-linux/include

# The toolkit packages come from NVIDIA's repository, so the lint does not pull the SDK image, which carries the
# whole toolkit; the rest mirrors toolchain-cuda and toolchain-clang-cuda.
FROM ubuntu-build-base AS lint-clang-cuda
ARG DEBIAN_FRONTEND=noninteractive
ARG CUDA_PACKAGE_VERSION
ARG LLVM_VERSION
RUN apt-get update \
    && apt-get install --no-install-recommends --yes curl gpg g++-11 \
    && curl -fsSL https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/3bf863cc.pub \
       | gpg --dearmor -o /usr/share/keyrings/cuda.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/cuda.gpg] https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/ /" \
       > /etc/apt/sources.list.d/cuda.list \
    && apt-get update \
    && apt-get install --no-install-recommends --yes \
       cuda-nvcc-${CUDA_PACKAGE_VERSION} cuda-cudart-dev-${CUDA_PACKAGE_VERSION} \
       cuda-nvdisasm-${CUDA_PACKAGE_VERSION} libcublas-dev-${CUDA_PACKAGE_VERSION} \
       libcurand-dev-${CUDA_PACKAGE_VERSION} \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /usr/local/cuda \
    && ln -s "cuda-$(echo "${CUDA_PACKAGE_VERSION}" | tr - .)" /usr/local/cuda
COPY --from=cmake-release /opt/cmake /opt/cmake
COPY --from=llvm /llvm/ /
COPY --from=cccl /opt/cccl /opt/cccl
RUN ln -s /usr/bin/clang-${LLVM_VERSION} /usr/local/bin/clang \
    && ln -s /usr/bin/clang++-${LLVM_VERSION} /usr/local/bin/clang++
ENV PATH="/opt/cmake/bin:/usr/local/cuda/bin:/usr/lib/llvm-${LLVM_VERSION}/bin:${PATH}" \
    CC=/usr/local/bin/clang CXX=/usr/local/bin/clang++ CUDACXX=/usr/local/bin/clang++ \
    CUDAHOSTCXX=/usr/bin/g++-11 \
    CUDAToolkit_ROOT=/usr/local/cuda \
    CPATH=/opt/cccl/thrust:/opt/cccl/cub:/opt/cccl/libcudacxx/include:/usr/local/cuda/targets/x86_64-linux/include \
    LIBRARY_PATH=/usr/local/cuda/targets/x86_64-linux/lib \
    LD_LIBRARY_PATH=/usr/local/cuda/targets/x86_64-linux/lib:/usr/local/cuda/compat

# Make toolkit runtimes discoverable by both the loader and CMake dependency scanning.
RUN printf '%s\n' /usr/local/cuda/targets/x86_64-linux/lib \
    > /etc/ld.so.conf.d/conformance.conf && ldconfig

COPY --from=jobserver-ninja /tmp/ninja-build/ninja /usr/local/bin/ninja
COPY --from=jobserver-ninja /tmp/ninja-src/COPYING /usr/local/share/licenses/ninja/COPYING

# GCC 14 looks up launch ICVs using the unresolved default-device sentinel.
# Rebuild only the host runtime; retain distribution offload plugins/device libraries.
FROM ubuntu-build-base AS gcc-host-runtime
ARG DEBIAN_FRONTEND=noninteractive
ARG GCC_VERSION
ARG GCC_RUNTIME_VERSION
ARG GCC_RUNTIME_SHA256
RUN apt-get update \
    && apt-get install --no-install-recommends --yes gcc-${GCC_VERSION} curl xz-utils file \
    && rm -rf /var/lib/apt/lists/* \
    && test "$(gcc-${GCC_VERSION} -dumpfullversion)" = "${GCC_RUNTIME_VERSION}"
COPY patches/libgomp-default-device.patch /tmp/libgomp-default-device.patch
RUN curl -fsSL "https://gcc.gnu.org/pub/gcc/releases/gcc-${GCC_RUNTIME_VERSION}/gcc-${GCC_RUNTIME_VERSION}.tar.xz" -o /tmp/gcc.tar.xz \
    && echo "${GCC_RUNTIME_SHA256}  /tmp/gcc.tar.xz" | sha256sum --check --strict \
    && mkdir /tmp/gcc-src /tmp/libgomp-build \
    && tar -xJf /tmp/gcc.tar.xz --strip-components=1 -C /tmp/gcc-src \
       gcc-${GCC_RUNTIME_VERSION}/libgomp gcc-${GCC_RUNTIME_VERSION}/config gcc-${GCC_RUNTIME_VERSION}/include \
       gcc-${GCC_RUNTIME_VERSION}/gcc/BASE-VER gcc-${GCC_RUNTIME_VERSION}/config.guess gcc-${GCC_RUNTIME_VERSION}/config.sub \
       gcc-${GCC_RUNTIME_VERSION}/install-sh gcc-${GCC_RUNTIME_VERSION}/missing gcc-${GCC_RUNTIME_VERSION}/mkinstalldirs \
       gcc-${GCC_RUNTIME_VERSION}/ltmain.sh gcc-${GCC_RUNTIME_VERSION}/libtool.m4 gcc-${GCC_RUNTIME_VERSION}/libtool-ldflags \
       gcc-${GCC_RUNTIME_VERSION}/ltoptions.m4 gcc-${GCC_RUNTIME_VERSION}/ltsugar.m4 gcc-${GCC_RUNTIME_VERSION}/ltversion.m4 \
       gcc-${GCC_RUNTIME_VERSION}/lt~obsolete.m4 gcc-${GCC_RUNTIME_VERSION}/depcomp gcc-${GCC_RUNTIME_VERSION}/multilib.am \
       gcc-${GCC_RUNTIME_VERSION}/config-ml.in gcc-${GCC_RUNTIME_VERSION}/COPYING.RUNTIME gcc-${GCC_RUNTIME_VERSION}/COPYING3 \
    && patch --batch --fuzz=0 -d /tmp/gcc-src -p1 < /tmp/libgomp-default-device.patch \
    && cd /tmp/libgomp-build \
    && CC=gcc-${GCC_VERSION} enable_offload_targets=nvptx-none,amdgcn-amdhsa enable_offload_defaulted=yes \
       ../gcc-src/libgomp/configure --prefix=/usr --disable-multilib --disable-static \
    && make -j2 libgomp.la \
    && mkdir -p /runtime/lib /runtime/licenses \
    && install -m755 .libs/libgomp.so.1.0.0 /runtime/lib/ \
    && strip --strip-unneeded /runtime/lib/libgomp.so.1.0.0 \
    && cp /tmp/gcc-src/COPYING3 /tmp/gcc-src/COPYING.RUNTIME /runtime/licenses/ \
    && rm -rf /tmp/gcc.tar.xz /tmp/gcc-src /tmp/libgomp-build

FROM toolchain-cuda AS toolchain-gcc-cuda
ARG DEBIAN_FRONTEND=noninteractive
ARG GCC_VERSION
RUN apt-get update \
    && apt-get install --no-install-recommends --yes g++-${GCC_VERSION} gcc-${GCC_VERSION}-offload-nvptx libgomp-plugin-nvptx1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=gcc-host-runtime /runtime/lib/ /usr/lib/x86_64-linux-gnu/
COPY --from=gcc-host-runtime /runtime/licenses/ /usr/local/share/licenses/libgomp/
RUN ldconfig
ENV CC=/usr/bin/gcc-${GCC_VERSION} CXX=/usr/bin/g++-${GCC_VERSION}

FROM ubuntu-build-base AS toolchain-gcc-hsa
ARG DEBIAN_FRONTEND=noninteractive
ARG GCC_VERSION
RUN apt-get update \
    && apt-get install --no-install-recommends --yes g++-${GCC_VERSION} gcc-${GCC_VERSION}-offload-amdgcn libgomp-plugin-amdgcn1 libhsa-runtime-dev \
    && rm -rf /var/lib/apt/lists/*
COPY --from=gcc-host-runtime /runtime/lib/ /usr/lib/x86_64-linux-gnu/
COPY --from=gcc-host-runtime /runtime/licenses/ /usr/local/share/licenses/libgomp/
RUN ldconfig
ENV CC=/usr/bin/gcc-${GCC_VERSION} CXX=/usr/bin/g++-${GCC_VERSION}
COPY --from=jobserver-ninja /tmp/ninja-build/ninja /usr/local/bin/ninja
COPY --from=jobserver-ninja /tmp/ninja-src/COPYING /usr/local/share/licenses/ninja/COPYING

FROM ${SYCL_IMAGE} AS toolchain-sycl
USER root
ARG DEBIAN_FRONTEND=noninteractive
COPY --from=network-config /etc/apt/apt.conf.d/80-retries /etc/apt/apt.conf.d/80-retries
COPY --from=network-config /root/.curlrc /root/.curlrc
ENV CURL_HOME=/root
RUN apt-get update \
    && apt-get install --no-install-recommends --yes \
       binutils build-essential ca-certificates ccache cmake ninja-build patchelf \
       libdrm2 libhwloc15 libnuma1 libze1 python3 \
    && rm -rf /var/lib/apt/lists/*
ENV PATH="/opt/intel/oneapi/compiler/latest/bin:${PATH}" \
    CC=icx \
    CXX=icpx \
    ONEAPI_ROOT=/opt/intel/oneapi \
    MKLROOT=/opt/intel/oneapi/mkl/latest \
    TBBROOT=/opt/intel/oneapi/tbb/latest \
    CPATH=/opt/intel/oneapi/dpl/latest/include:/opt/intel/oneapi/mkl/latest/include \
    LIBRARY_PATH=/opt/intel/oneapi/compiler/latest/lib:/opt/intel/oneapi/mkl/latest/lib:/opt/intel/oneapi/tbb/latest/lib:/opt/intel/oneapi/umf/latest/lib \
    LD_LIBRARY_PATH=/opt/intel/oneapi/compiler/latest/lib:/opt/intel/oneapi/mkl/latest/lib:/opt/intel/oneapi/tbb/latest/lib:/opt/intel/oneapi/umf/latest/lib \
    CMAKE_PREFIX_PATH=/opt/intel/oneapi/compiler/latest:/opt/intel/oneapi/dpl/latest:/opt/intel/oneapi/mkl/latest:/opt/intel/oneapi/tbb/latest:/opt/intel/oneapi/umf/latest

# Make vendor runtimes discoverable by both the loader and CMake dependency scanning.
RUN printf '%s\n' /opt/intel/oneapi/compiler/latest/lib /opt/intel/oneapi/mkl/latest/lib /opt/intel/oneapi/tbb/latest/lib /opt/intel/oneapi/umf/latest/lib \
    > /etc/ld.so.conf.d/conformance.conf && ldconfig

COPY --from=jobserver-ninja /tmp/ninja-build/ninja /usr/local/bin/ninja
COPY --from=jobserver-ninja /tmp/ninja-src/COPYING /usr/local/share/licenses/ninja/COPYING

# The lint installs the compiler and oneMKL that SYCL_IMAGE carries, at the same versions, without the rest of the
# toolkit; the environment mirrors toolchain-sycl.
FROM ubuntu-build-base AS lint-sycl
ARG DEBIAN_FRONTEND=noninteractive
ARG ONEAPI_VERSION
ARG ONEAPI_DPCPP_PACKAGE
ARG ONEAPI_MKL_PACKAGE
RUN apt-get update \
    && apt-get install --no-install-recommends --yes curl gpg \
    && curl -fsSL https://apt.repos.intel.com/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB \
       | gpg --dearmor -o /usr/share/keyrings/intel.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/intel.gpg] https://apt.repos.intel.com/oneapi all main" \
       > /etc/apt/sources.list.d/intel.list \
    && apt-get update \
    && apt-get install --no-install-recommends --yes \
       intel-oneapi-dpcpp-cpp-${ONEAPI_VERSION}=${ONEAPI_DPCPP_PACKAGE} \
       intel-oneapi-mkl-devel-${ONEAPI_VERSION}=${ONEAPI_MKL_PACKAGE} \
       libdrm2 libhwloc15 libnuma1 libze1 \
    && rm -rf /var/lib/apt/lists/*
ENV PATH="/opt/intel/oneapi/compiler/latest/bin:${PATH}" \
    CC=icx \
    CXX=icpx \
    ONEAPI_ROOT=/opt/intel/oneapi \
    MKLROOT=/opt/intel/oneapi/mkl/latest \
    TBBROOT=/opt/intel/oneapi/tbb/latest \
    CPATH=/opt/intel/oneapi/dpl/latest/include:/opt/intel/oneapi/mkl/latest/include \
    LIBRARY_PATH=/opt/intel/oneapi/compiler/latest/lib:/opt/intel/oneapi/mkl/latest/lib:/opt/intel/oneapi/tbb/latest/lib:/opt/intel/oneapi/umf/latest/lib \
    LD_LIBRARY_PATH=/opt/intel/oneapi/compiler/latest/lib:/opt/intel/oneapi/mkl/latest/lib:/opt/intel/oneapi/tbb/latest/lib:/opt/intel/oneapi/umf/latest/lib \
    CMAKE_PREFIX_PATH=/opt/intel/oneapi/compiler/latest:/opt/intel/oneapi/dpl/latest:/opt/intel/oneapi/mkl/latest:/opt/intel/oneapi/tbb/latest:/opt/intel/oneapi/umf/latest

# Make vendor runtimes discoverable by both the loader and CMake dependency scanning.
RUN printf '%s\n' /opt/intel/oneapi/compiler/latest/lib /opt/intel/oneapi/mkl/latest/lib /opt/intel/oneapi/tbb/latest/lib /opt/intel/oneapi/umf/latest/lib \
    > /etc/ld.so.conf.d/conformance.conf && ldconfig

COPY --from=jobserver-ninja /tmp/ninja-build/ninja /usr/local/bin/ninja
COPY --from=jobserver-ninja /tmp/ninja-src/COPYING /usr/local/share/licenses/ninja/COPYING

# oneAPI's own clang-tidy understands the DPC++ frontend that upstream clang-tidy cannot parse.
RUN ln -s /opt/intel/oneapi/compiler/latest/bin/compiler/clang-tidy /usr/local/bin/clang-tidy

FROM ${NVHPC_IMAGE} AS toolchain-openacc
USER root
ARG DEBIAN_FRONTEND=noninteractive
ARG NVHPC_VERSION=26.5
COPY --from=network-config /etc/apt/apt.conf.d/80-retries /etc/apt/apt.conf.d/80-retries
COPY --from=network-config /root/.curlrc /root/.curlrc
ENV CURL_HOME=/root
RUN apt-get update \
    && apt-get install --no-install-recommends --yes \
       binutils build-essential ca-certificates ccache cmake ninja-build patchelf \
    && rm -rf /var/lib/apt/lists/*
ENV NVHPC_ROOT="/opt/nvidia/hpc_sdk/Linux_x86_64/${NVHPC_VERSION}" \
    PATH="/opt/nvidia/hpc_sdk/Linux_x86_64/${NVHPC_VERSION}/compilers/bin:${PATH}" \
    CC="/opt/nvidia/hpc_sdk/Linux_x86_64/${NVHPC_VERSION}/compilers/bin/nvc" \
    CXX="/opt/nvidia/hpc_sdk/Linux_x86_64/${NVHPC_VERSION}/compilers/bin/nvc++" \
    CPATH="/opt/nvidia/hpc_sdk/Linux_x86_64/${NVHPC_VERSION}/compilers/include" \
    LIBRARY_PATH="/opt/nvidia/hpc_sdk/Linux_x86_64/${NVHPC_VERSION}/compilers/lib" \
    LD_LIBRARY_PATH="/opt/nvidia/hpc_sdk/Linux_x86_64/${NVHPC_VERSION}/compilers/lib"
COPY --from=jobserver-ninja /tmp/ninja-build/ninja /usr/local/bin/ninja
COPY --from=jobserver-ninja /tmp/ninja-src/COPYING /usr/local/share/licenses/ninja/COPYING
