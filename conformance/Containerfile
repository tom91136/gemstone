ARG DEBIAN_FRONTEND=noninteractive
ARG NVHPC_VERSION=26.5
RUN apt-get update \
    && apt-get install --no-install-recommends --yes \
       binutils build-essential ca-certificates cmake ninja-build patchelf \
    && rm -rf /var/lib/apt/lists/*
ENV NVHPC_ROOT="/opt/nvidia/hpc_sdk/Linux_x86_64/${NVHPC_VERSION}" \
    PATH="/opt/nvidia/hpc_sdk/Linux_x86_64/${NVHPC_VERSION}/compilers/bin:${PATH}" \
    CC="/opt/nvidia/hpc_sdk/Linux_x86_64/${NVHPC_VERSION}/compilers/bin/nvc" \
    CXX="/opt/nvidia/hpc_sdk/Linux_x86_64/${NVHPC_VERSION}/compilers/bin/nvc++" \
    CPATH="/opt/nvidia/hpc_sdk/Linux_x86_64/${NVHPC_VERSION}/compilers/include" \
    LIBRARY_PATH="/opt/nvidia/hpc_sdk/Linux_x86_64/${NVHPC_VERSION}/compilers/lib" \
    LD_LIBRARY_PATH="/opt/nvidia/hpc_sdk/Linux_x86_64/${NVHPC_VERSION}/compilers/lib"
COPY --from=jobserver-ninja /tmp/ninja-build/ninja /usr/local/bin/ninja
COPY --from=jobserver-ninja /tmp/ninja-src/COPYING /usr/local/share/licenses/ninja/COPYING
