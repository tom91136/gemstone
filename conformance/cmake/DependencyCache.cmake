# Generic helpers for a shared, toolchain-independent source cache for
# FetchContent dependencies. This module holds no project-specific data: the
# manifest and the cache location are passed in by the caller.
include_guard(GLOBAL)

# conformance_dependency_lookup(<manifest> <name> <out_url> <out_sha256> <out_kind>)
# Manifest rows are "name|kind|url|sha256".
function(conformance_dependency_lookup manifest name output_url output_sha256 output_kind)
  foreach(row IN LISTS manifest)
    string(REPLACE "|" ";" fields "${row}")
    list(GET fields 0 candidate)
    if(candidate STREQUAL name)
      list(GET fields 1 kind)
      list(GET fields 2 url)
      list(GET fields 3 sha256)
      set(${output_kind} "${kind}" PARENT_SCOPE)
      set(${output_url} "${url}" PARENT_SCOPE)
      set(${output_sha256} "${sha256}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  message(FATAL_ERROR "Unknown conformance dependency: ${name}")
endfunction()

function(conformance_dependency_cached cache name sha256 output)
  set(ready FALSE)
  if(EXISTS "${cache}/${name}/.conformance-complete")
    file(READ "${cache}/${name}/.conformance-complete" stamp)
    string(STRIP "${stamp}" stamp)
    if(stamp STREQUAL "pinned ${sha256}")
      set(ready TRUE)
    endif()
  endif()
  set(${output} "${ready}" PARENT_SCOPE)
endfunction()

# conformance_dependency_cache_ready(<manifest> <cache> <out_ready>)
# The content hash identifies the pinned source even if its download URL changes.
function(conformance_dependency_cache_ready manifest cache output)
  if(NOT cache)
    set(${output} FALSE PARENT_SCOPE)
    return()
  endif()
  foreach(row IN LISTS manifest)
    string(REPLACE "|" ";" fields "${row}")
    list(GET fields 0 name)
    list(GET fields 3 sha256)
    conformance_dependency_cached("${cache}" "${name}" "${sha256}" ready)
    if(NOT ready)
      set(${output} FALSE PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${output} TRUE PARENT_SCOPE)
endfunction()

# conformance_dependency_cache_apply(<cache> <name> <offline> <sha256>)
# Points FetchContent at the cached source tree when it has been populated.
function(conformance_dependency_cache_apply cache name offline sha256)
  if(NOT cache)
    return()
  endif()
  string(TOUPPER "${name}" upper)
  set(FETCHCONTENT_FULLY_DISCONNECTED "${offline}" CACHE BOOL "" FORCE)
  conformance_dependency_cached("${cache}" "${name}" "${sha256}" ready)
  if(NOT ready)
    if(FETCHCONTENT_SOURCE_DIR_${upper} STREQUAL "${cache}/${name}")
      unset(FETCHCONTENT_SOURCE_DIR_${upper} CACHE)
    endif()
    if(offline)
      message(FATAL_ERROR "Missing or outdated cached dependency: ${name}; populate the dependency cache first")
    endif()
    return()
  endif()
  set(FETCHCONTENT_SOURCE_DIR_${upper} "${cache}/${name}" CACHE PATH "" FORCE)
  set(FETCHCONTENT_UPDATES_DISCONNECTED ON CACHE BOOL "" FORCE)
endfunction()

# conformance_dependency_cache_populate(<manifest> <cache>)
# Downloads and extracts every manifest entry. Idempotent and script-safe.
function(conformance_dependency_cache_populate manifest cache)
  if(NOT cache)
    message(FATAL_ERROR "A conformance dependency cache directory is required")
  endif()
  file(MAKE_DIRECTORY "${cache}")
  foreach(row IN LISTS manifest)
    string(REPLACE "|" ";" fields "${row}")
    list(GET fields 0 name)
    list(GET fields 1 kind)
    list(GET fields 2 url)
    list(GET fields 3 sha256)

    set(destination "${cache}/${name}")
    conformance_dependency_cached("${cache}" "${name}" "${sha256}" ready)
    if(ready)
      message(STATUS "conformance dependency cached: ${name}")
      continue()
    endif()
    message(STATUS "conformance dependency unpacking: ${name}")
    file(REMOVE_RECURSE "${destination}")

    if(kind STREQUAL "file")
      file(MAKE_DIRECTORY "${destination}")
      get_filename_component(filename "${url}" NAME)
      file(DOWNLOAD "${url}" "${destination}/${filename}" EXPECTED_HASH "SHA256=${sha256}" TLS_VERIFY ON STATUS status)
      list(GET status 0 code)
      if(NOT code EQUAL 0)
        list(GET status 1 message)
        message(FATAL_ERROR "cannot download ${name}: ${message}")
      endif()
    else()
      set(archive "${cache}/.${name}.archive")
      file(DOWNLOAD "${url}" "${archive}" EXPECTED_HASH "SHA256=${sha256}" TLS_VERIFY ON STATUS status)
      list(GET status 0 code)
      if(NOT code EQUAL 0)
        list(GET status 1 message)
        file(REMOVE "${archive}")
        message(FATAL_ERROR "cannot download ${name}: ${message}")
      endif()
      set(extract "${cache}/.${name}.extract")
      file(REMOVE_RECURSE "${extract}")
      file(MAKE_DIRECTORY "${extract}")
      file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${extract}")
      file(REMOVE "${archive}")
      file(GLOB children RELATIVE "${extract}" "${extract}/*")
      list(LENGTH children count)
      if(count EQUAL 1 AND IS_DIRECTORY "${extract}/${children}")
        file(RENAME "${extract}/${children}" "${destination}")
        file(REMOVE_RECURSE "${extract}")
      else()
        file(RENAME "${extract}" "${destination}")
      endif()
    endif()
    file(WRITE "${destination}/.conformance-complete" "pinned ${sha256}\n")
  endforeach()
  message(STATUS "conformance dependency cache ready: ${cache}")
endfunction()
