include_guard(GLOBAL)
# script mode has no cmake_minimum_required, and functions keep the policies of their definition
cmake_policy(VERSION 3.25)
include(FetchContent)

# The content hash identifies the pinned source even if its download URL changes.
function(dependency_cached cache name hash size output)
  set(expected "pinned ${hash}")
  if(NOT "${size}" STREQUAL "")
    string(APPEND expected " ${size}")
  endif()
  set(ready FALSE)
  if(EXISTS "${cache}/${name}/.pinned")
    file(READ "${cache}/${name}/.pinned" stamp)
    string(STRIP "${stamp}" stamp)
    if(stamp STREQUAL expected)
      set(ready TRUE)
    endif()
  endif()
  set(${output} "${ready}" PARENT_SCOPE)
endfunction()

function(dependency_cache_apply cache name offline hash size)
  set(FETCHCONTENT_FULLY_DISCONNECTED "${offline}" CACHE BOOL "" FORCE)
  if(NOT cache)
    return()
  endif()
  string(TOUPPER "${name}" upper)
  dependency_cached("${cache}" "${name}" "${hash}" "${size}" ready)
  if(NOT ready)
    if(FETCHCONTENT_SOURCE_DIR_${upper} STREQUAL "${cache}/${name}")
      unset(FETCHCONTENT_SOURCE_DIR_${upper} CACHE)
    endif()
    if(offline)
      message(FATAL_ERROR "Missing or outdated cached dependency: ${name}; populate the dependency cache first")
    endif()
    return()
  endif()
  set(FETCHCONTENT_SOURCE_DIR_${upper} "${cache}/${name}" CACHE PATH "" FORCE)
  set(FETCHCONTENT_UPDATES_DISCONNECTED ON CACHE BOOL "" FORCE)
endfunction()

function(dependency_cache_populate cache name url hash_type hash size extract filename)
  dependency_cached("${cache}" "${name}" "${hash}" "${size}" ready)
  if(ready)
    return()
  endif()
  message(STATUS "dependency unpacking: ${name}")
  file(MAKE_DIRECTORY "${cache}")
  set(destination "${cache}/${name}")
  file(REMOVE_RECURSE "${destination}")
  if(NOT extract)
    if("${filename}" STREQUAL "")
      get_filename_component(filename "${url}" NAME)
    endif()
    set(download "${destination}/${filename}")
  else()
    set(download "${cache}/.${name}.archive")
  endif()
  message(STATUS "dependency downloading: ${name}")
  file(DOWNLOAD "${url}" "${download}" EXPECTED_HASH "${hash_type}=${hash}" TLS_VERIFY ON STATUS status)
  list(GET status 0 code)
  if(NOT code EQUAL 0)
    list(GET status 1 message)
    file(REMOVE "${download}")
    message(FATAL_ERROR "cannot download ${name}: ${message}")
  endif()
  if(NOT extract AND NOT "${size}" STREQUAL "")
    file(SIZE "${download}" actual_size)
    if(NOT "${actual_size}" STREQUAL "${size}")
      file(REMOVE "${download}")
      message(FATAL_ERROR "cannot download ${name}: size mismatch, expected ${size} bytes, got ${actual_size}")
    endif()
  endif()
  if(extract)
    set(staging "${cache}/.${name}.extract")
    file(REMOVE_RECURSE "${staging}")
    file(ARCHIVE_EXTRACT INPUT "${download}" DESTINATION "${staging}")
    file(REMOVE "${download}")
    file(GLOB children RELATIVE "${staging}" "${staging}/*")
    list(LENGTH children count)
    if(count EQUAL 1 AND IS_DIRECTORY "${staging}/${children}")
      file(RENAME "${staging}/${children}" "${destination}")
      file(REMOVE_RECURSE "${staging}")
    else()
      file(RENAME "${staging}" "${destination}")
    endif()
  endif()
  set(stamp "pinned ${hash}")
  if(NOT extract AND NOT "${size}" STREQUAL "")
    string(APPEND stamp " ${size}")
  endif()
  file(WRITE "${destination}/.pinned" "${stamp}\n")
endfunction()

function(pinned_dependency name)
  cmake_parse_arguments(PARSE_ARGV 1 ARG "SOURCE_ONLY" "URL;URL_HASH;FILENAME;SIZE" "")
  if(NOT ARG_URL OR NOT ARG_URL_HASH MATCHES "^(SHA256|MD5)=([0-9a-f]+)$")
    message(FATAL_ERROR "pinned_dependency(${name}) requires URL and URL_HASH SHA256=<hash> or MD5=<hash>")
  endif()
  set(hash_type "${CMAKE_MATCH_1}")
  set(hash "${CMAKE_MATCH_2}")
  set(size "${ARG_SIZE}")
  set(options ${ARG_UNPARSED_ARGUMENTS})
  set(extract TRUE)
  if("DOWNLOAD_NO_EXTRACT" IN_LIST options)
    set(extract FALSE)
  endif()
  if(extract AND (NOT "${size}" STREQUAL "" OR NOT "${ARG_FILENAME}" STREQUAL ""))
    message(FATAL_ERROR "pinned_dependency(${name}) accepts SIZE and FILENAME only with DOWNLOAD_NO_EXTRACT")
  endif()
  if(DEPENDENCY_CACHE_MODE STREQUAL "populate")
    dependency_cache_populate("${DEPENDENCY_CACHE}" "${name}" "${ARG_URL}" "${hash_type}" "${hash}" "${size}" ${extract} "${ARG_FILENAME}")
  elseif(DEPENDENCY_CACHE_MODE STREQUAL "verify")
    dependency_cached("${DEPENDENCY_CACHE}" "${name}" "${hash}" "${size}" ready)
    if(NOT ready)
      message(FATAL_ERROR "Missing or outdated cached dependency: ${name} in ${DEPENDENCY_CACHE}")
    endif()
  else()
    dependency_cache_apply("${DEPENDENCY_CACHE}" "${name}" "${DEPENDENCY_OFFLINE}" "${hash}" "${size}")
    if(ARG_SOURCE_ONLY)
      list(APPEND options SOURCE_SUBDIR .source-only)
    endif()
    if(extract)
      list(APPEND options DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
    endif()
    FetchContent_Declare(${name} URL "${ARG_URL}" URL_HASH "${ARG_URL_HASH}" ${options})
  endif()
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
  if(NOT MANIFEST OR NOT DEPENDENCY_CACHE)
    message(FATAL_ERROR "usage: cmake -DMANIFEST=<file> -DDEPENDENCY_CACHE=<directory> -P DependencyCache.cmake")
  endif()
  set(DEPENDENCY_CACHE_MODE populate)
  include("${MANIFEST}")
endif()
