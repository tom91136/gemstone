include_guard(GLOBAL)

function(bundle_runtime_dependencies)
  cmake_parse_arguments(PARSE_ARGV 0 bundle "" "DESTINATION"
    "EXECUTABLE_PATTERNS;LIBRARY_PATTERNS;SEARCH_DIRECTORIES;PLUGINS;PREFERENCES;EXCLUDE_REGEXES")
  if(NOT bundle_DESTINATION)
    message(FATAL_ERROR "bundle_runtime_dependencies requires DESTINATION")
  endif()
  if(bundle_UNPARSED_ARGUMENTS)
    message(FATAL_ERROR "Unknown bundle_runtime_dependencies arguments: ${bundle_UNPARSED_ARGUMENTS}")
  endif()
  file(MAKE_DIRECTORY "${bundle_DESTINATION}")

  set(plugins ${bundle_PLUGINS})
  list(FILTER plugins INCLUDE REGEX "\\.so(\\.[0-9]+)*$")
  set(executables)
  foreach(pattern IN LISTS bundle_EXECUTABLE_PATTERNS)
    string(REPLACE "\${runtime_input}" "${runtime_input}" pattern "${pattern}")
    file(GLOB matches LIST_DIRECTORIES FALSE "${pattern}")
    list(APPEND executables ${matches})
  endforeach()
  set(libraries)
  foreach(pattern IN LISTS bundle_LIBRARY_PATTERNS)
    file(GLOB matches LIST_DIRECTORIES FALSE "${pattern}")
    list(APPEND libraries ${matches})
  endforeach()
  list(FILTER libraries INCLUDE REGEX "\\.so(\\.[0-9]+)*$")
  list(APPEND libraries ${plugins})
  list(REMOVE_DUPLICATES executables)
  list(REMOVE_DUPLICATES libraries)

  set(runtime_dependency_arguments)
  if(executables)
    list(APPEND runtime_dependency_arguments EXECUTABLES ${executables})
  endif()
  if(libraries)
    list(APPEND runtime_dependency_arguments LIBRARIES ${libraries})
  endif()
  if(runtime_dependency_arguments)
    file(GET_RUNTIME_DEPENDENCIES
      ${runtime_dependency_arguments}
      DIRECTORIES ${bundle_SEARCH_DIRECTORIES}
      RESOLVED_DEPENDENCIES_VAR resolved
      UNRESOLVED_DEPENDENCIES_VAR unresolved
      CONFLICTING_DEPENDENCIES_PREFIX conflicts
      PRE_EXCLUDE_REGEXES "ld-linux.*" "libc\\.so.*" "libm\\.so.*" "libpthread\\.so.*" "libdl\\.so.*"
        "librt\\.so.*" "libgcc_s\\.so.*" "libstdc\\+\\+\\.so.*" ${bundle_EXCLUDE_REGEXES})
  endif()

  foreach(filename IN LISTS conflicts_FILENAMES)
    set(candidates "${conflicts_${filename}}")
    set(selected)
    foreach(preference IN LISTS bundle_PREFERENCES)
      string(REPLACE "|" ";" fields "${preference}")
      list(GET fields 0 preferred_filename)
      list(GET fields 1 preferred_regex)
      if(filename STREQUAL preferred_filename)
        set(preferred_candidates "${candidates}")
        list(FILTER preferred_candidates INCLUDE REGEX "${preferred_regex}")
        list(SORT preferred_candidates)
        if(preferred_candidates)
          list(GET preferred_candidates 0 selected)
        endif()
      endif()
    endforeach()
    if(NOT selected)
      list(GET candidates 0 selected)
      file(SHA256 "${selected}" selected_sha256)
      foreach(candidate IN LISTS candidates)
        file(SHA256 "${candidate}" candidate_sha256)
        if(NOT candidate_sha256 STREQUAL selected_sha256)
          message(FATAL_ERROR "Conflicting runtime dependency ${filename}: ${candidates}")
        endif()
      endforeach()
    endif()
    list(APPEND resolved "${selected}")
  endforeach()

  list(REMOVE_DUPLICATES resolved)
  foreach(dependency IN LISTS resolved plugins)
    if(EXISTS "${dependency}")
      file(COPY "${dependency}" DESTINATION "${bundle_DESTINATION}" FOLLOW_SYMLINK_CHAIN)
    endif()
  endforeach()
  if(unresolved)
    message(FATAL_ERROR "Unresolved runtime dependencies: ${unresolved}")
  endif()

  find_program(patchelf patchelf REQUIRED)
  file(GLOB_RECURSE libraries LIST_DIRECTORIES FALSE "${bundle_DESTINATION}/*.so*")
  foreach(library IN LISTS libraries)
    get_filename_component(library_directory "${library}" DIRECTORY)
    file(RELATIVE_PATH runtime_relative "${library_directory}" "${bundle_DESTINATION}")
    if(runtime_relative STREQUAL ".")
      set(runtime_rpath "$ORIGIN")
    else()
      set(runtime_rpath "$ORIGIN/${runtime_relative}")
    endif()
    execute_process(COMMAND "${patchelf}" --set-rpath "${runtime_rpath}" "${library}"
      COMMAND_ERROR_IS_FATAL ANY OUTPUT_QUIET)
  endforeach()
endfunction()
