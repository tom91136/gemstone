include_guard(GLOBAL)

function(container_command output)
  cmake_parse_arguments(ARG "" "EXECUTABLE;IMAGE;SOURCE;SOURCE_TARGET;ARTIFACTS;DEPENDENCIES;CCACHE;WORK;NETWORK;CPU_SHARES;IDENTITY;INTERPRETERS"
    "COMMAND" ${ARGN})
  if(NOT ARG_EXECUTABLE OR NOT ARG_IMAGE)
    message(FATAL_ERROR "container_command requires EXECUTABLE and IMAGE")
  endif()
  set(command "${ARG_EXECUTABLE}" run --rm --security-opt label=disable)
  if(ARG_NETWORK)
    list(APPEND command "--network=${ARG_NETWORK}")
  endif()
  if(ARG_CPU_SHARES)
    list(APPEND command --cpu-shares "${ARG_CPU_SHARES}")
  endif()
  if(ARG_IDENTITY)
    separate_arguments(identity NATIVE_COMMAND "${ARG_IDENTITY}")
    list(APPEND command ${identity})
  endif()
  if(ARG_SOURCE)
    if(ARG_SOURCE_TARGET)
      set(source_target "${ARG_SOURCE_TARGET}")
    else()
      set(source_target "/source/conformance")
    endif()
    list(APPEND command --mount "type=bind,source=${ARG_SOURCE},target=${source_target},readonly")
  endif()
  if(ARG_ARTIFACTS)
    list(APPEND command --mount "type=bind,source=${ARG_ARTIFACTS},target=/output")
  endif()
  if(ARG_DEPENDENCIES)
    list(APPEND command --mount "type=bind,source=${ARG_DEPENDENCIES},target=/conformance-deps,readonly")
  endif()
  if(ARG_CCACHE)
    list(APPEND command --mount "type=bind,source=${ARG_CCACHE},target=/ccache"
      --env CCACHE_DIR=/ccache --env CCACHE_MAXSIZE=30G --env CCACHE_COMPRESS=1)
  endif()
  if(ARG_WORK)
    list(APPEND command --mount "type=bind,source=${ARG_WORK},target=/work")
  endif()
  # Interpreter environments keep absolute paths in their caches (depots, bytecode), so they mount where they live.
  if(ARG_INTERPRETERS)
    list(APPEND command --mount "type=bind,source=${ARG_INTERPRETERS},target=${ARG_INTERPRETERS}")
  endif()
  list(APPEND command "${ARG_IMAGE}")
  list(APPEND command ${ARG_COMMAND})
  set(${output} "${CMAKE_COMMAND};-P;${CMAKE_CURRENT_FUNCTION_LIST_DIR}/Jobserver.cmake;--;container;${command}" PARENT_SCOPE)
endfunction()

function(container_identity output executable)
  execute_process(COMMAND id -u OUTPUT_VARIABLE uid OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
  execute_process(COMMAND id -g OUTPUT_VARIABLE gid OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
  if(executable MATCHES "(^|/)podman$")
    set(${output} "--userns keep-id --user ${uid}:${gid}" PARENT_SCOPE)
  else()
    set(${output} "--user ${uid}:${gid}" PARENT_SCOPE)
  endif()
endfunction()

function(container_stage_digest output containerfile stage)
  file(STRINGS "${containerfile}" lines)
  set(preamble)
  set(stages)
  set(current)
  set(started FALSE)
  foreach(line IN LISTS lines)
    if(line MATCHES "^[ \t]*[Ff][Rr][Oo][Mm][ \t]+([^ \t]+)")
      set(started TRUE)
      set(image "${CMAKE_MATCH_1}")
      set(current)
      if(line MATCHES "[ \t][Aa][Ss][ \t]+([A-Za-z0-9_.-]+)")
        set(current "${CMAKE_MATCH_1}")
        list(APPEND stages "${current}")
        set(_container_stage_${current}_text)
        set(_container_stage_${current}_parents "${image}")
      endif()
    endif()
    if(NOT started)
      string(APPEND preamble "${line}\n")
    elseif(current)
      string(APPEND _container_stage_${current}_text "${line}\n")
      string(REGEX MATCHALL "[ ,-]from=[A-Za-z0-9_.-]+" copies "${line}")
      foreach(copy IN LISTS copies)
        string(REGEX REPLACE "^.from=" "" parent "${copy}")
        list(APPEND _container_stage_${current}_parents "${parent}")
      endforeach()
    endif()
  endforeach()
  if(NOT stage IN_LIST stages)
    message(FATAL_ERROR "stage ${stage} is not defined in ${containerfile}")
  endif()
  set(closure "${stage}")
  set(pending "${stage}")
  while(pending)
    list(POP_FRONT pending node)
    foreach(parent IN LISTS _container_stage_${node}_parents)
      if(parent IN_LIST stages AND NOT parent IN_LIST closure)
        list(APPEND closure "${parent}")
        list(APPEND pending "${parent}")
      endif()
    endforeach()
  endwhile()
  list(SORT closure)
  string(SHA256 digest "${preamble}")
  foreach(member IN LISTS closure)
    string(SHA256 member_digest "${_container_stage_${member}_text}")
    string(APPEND digest ";${member_digest}")
  endforeach()
  string(SHA256 digest "${digest}")
  set(${output} "${digest}" PARENT_SCOPE)
endfunction()

function(container_image_tag output)
  cmake_parse_arguments(PARSE_ARGV 1 ARG "" "REPOSITORY;FILE;STAGE" "BUILD_ARGUMENTS;BUILD_CONTEXTS;INPUTS")
  list(REMOVE_ITEM ARG_INPUTS "${ARG_FILE}")
  container_stage_digest(stage_digest "${ARG_FILE}" "${ARG_STAGE}")
  set(definition "${stage_digest};${ARG_BUILD_ARGUMENTS};${ARG_BUILD_CONTEXTS}")
  foreach(input IN ITEMS ${ARG_INPUTS})
    file(SHA256 "${input}" digest)
    string(APPEND definition ";${digest}")
  endforeach()
  string(SHA256 digest "${definition}")
  string(SUBSTRING "${digest}" 0 16 digest)
  set(${output} "${ARG_REPOSITORY}:${digest}" PARENT_SCOPE)
endfunction()

function(container_image output_tag output_stamp)
  cmake_parse_arguments(PARSE_ARGV 2 ARG "" "EXECUTABLE;REPOSITORY;FILE;CONTEXT;STAGE;JOB_POOL"
    "BUILD_ARGUMENTS;BUILD_CONTEXTS;INPUTS;DEPENDS")
  container_image_tag(tag REPOSITORY "${ARG_REPOSITORY}" FILE "${ARG_FILE}" STAGE "${ARG_STAGE}"
    BUILD_ARGUMENTS ${ARG_BUILD_ARGUMENTS} BUILD_CONTEXTS ${ARG_BUILD_CONTEXTS} INPUTS ${ARG_INPUTS})
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${ARG_FILE}" ${ARG_INPUTS})
  string(REGEX REPLACE "[^A-Za-z0-9_.-]" "_" stamp "${tag}")
  file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/images")
  set(stamp "${CMAKE_BINARY_DIR}/images/${stamp}")
  set(stage)
  if(ARG_STAGE)
    set(stage --target "${ARG_STAGE}")
  endif()
  set(pool)
  if(ARG_JOB_POOL)
    set(pool JOB_POOL "${ARG_JOB_POOL}")
  endif()
  set(contexts)
  foreach(context IN LISTS ARG_BUILD_CONTEXTS)
    list(APPEND contexts --build-context "${context}")
  endforeach()
  get_property(images GLOBAL PROPERTY CONTAINER_IMAGES)
  if(NOT tag IN_LIST images)
    add_custom_command(
      OUTPUT "${stamp}"
      COMMAND sh -c [=[exe=$1 tag=$2; shift 2; "$exe" image inspect "$tag" >/dev/null 2>&1 && exit 0; [ -z "${JOBSERVER_DIRECTORY-}" ] || exec >&3 2>&1; exec "$exe" build --progress=plain --tag "$tag" "$@"]=]
        sh "${ARG_EXECUTABLE}" "${tag}" --file "${ARG_FILE}" ${stage} ${ARG_BUILD_ARGUMENTS} ${contexts} "${ARG_CONTEXT}"
      COMMAND "${CMAKE_COMMAND}" -E touch "${stamp}"
      DEPENDS ${ARG_DEPENDS}
      COMMENT "Preparing container image ${tag}"
      ${pool}
      VERBATIM)
    set_property(GLOBAL APPEND PROPERTY CONTAINER_IMAGES "${tag}")
  endif()
  set(${output_tag} "${tag}" PARENT_SCOPE)
  set(${output_stamp} "${stamp}" PARENT_SCOPE)
endfunction()

function(container_prune_target target)
  cmake_parse_arguments(PARSE_ARGV 1 ARG "" "EXECUTABLE" "")
  get_property(images GLOBAL PROPERTY CONTAINER_IMAGES)
  set(commands)
  foreach(image IN LISTS images)
    string(REGEX REPLACE ":[^:/]+$" "" repository "${image}")
    list(APPEND commands COMMAND sh -c
      [=["$0" images --format '{{.Repository}}:{{.Tag}}' --filter "reference=$1" | grep -F "$1:" | grep -vxF "$2" | xargs -r "$0" rmi]=]
      "${ARG_EXECUTABLE}" "${repository}" "${image}")
  endforeach()
  add_custom_target("${target}" ${commands}
    COMMAND "${ARG_EXECUTABLE}" image prune --force
    COMMENT "Removing superseded container images" VERBATIM)
endfunction()
