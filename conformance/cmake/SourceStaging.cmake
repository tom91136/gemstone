include_guard(GLOBAL)

function(patch_exact path before after)
  file(READ "${path}" content)
  string(FIND "${content}" "${before}" location)
  if(location EQUAL -1)
    message(FATAL_ERROR "Pinned integration point changed in ${path}:\n${before}")
  endif()
  string(REPLACE "${before}" "${after}" content "${content}")
  file(WRITE "${path}" "${content}")
endfunction()

function(stage_source source staging)
  cmake_parse_arguments(PARSE_ARGV 2 ARG "" "" "EXCLUDE")
  set(excludes)
  foreach(name IN LISTS ARG_EXCLUDE)
    list(APPEND excludes PATTERN "${name}" EXCLUDE)
  endforeach()
  file(REMOVE_RECURSE "${staging}")
  file(COPY "${source}/" DESTINATION "${staging}" ${excludes})
endfunction()

function(commit_staged_source staging destination)
  file(GLOB_RECURSE previous LIST_DIRECTORIES true RELATIVE "${destination}" "${destination}/*")
  foreach(entry IN LISTS previous)
    if(NOT EXISTS "${staging}/${entry}" OR
        (IS_DIRECTORY "${destination}/${entry}" AND NOT IS_DIRECTORY "${staging}/${entry}") OR
        (NOT IS_DIRECTORY "${destination}/${entry}" AND IS_DIRECTORY "${staging}/${entry}"))
      file(REMOVE_RECURSE "${destination}/${entry}")
    endif()
  endforeach()
  file(GLOB_RECURSE staged LIST_DIRECTORIES true RELATIVE "${staging}" "${staging}/*")
  foreach(entry IN LISTS staged)
    if(IS_DIRECTORY "${staging}/${entry}")
      file(MAKE_DIRECTORY "${destination}/${entry}")
    else()
      get_filename_component(parent "${destination}/${entry}" DIRECTORY)
      file(MAKE_DIRECTORY "${parent}")
      file(COPY_FILE "${staging}/${entry}" "${destination}/${entry}" ONLY_IF_DIFFERENT)
    endif()
  endforeach()
  file(REMOVE_RECURSE "${staging}")
endfunction()
