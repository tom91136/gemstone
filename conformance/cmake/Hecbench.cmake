include_guard(GLOBAL)

# DVC archives are addressed by the MD5 and size recorded in each pointer.
function(hecbench_dvc_entries source output)
  file(GLOB_RECURSE pointers "${source}/src/*.dvc")
  file(GLOB cuda_projects "${source}/src/*-cuda/CMakeLists.txt")
  set(referenced)
  set(referenced_names)
  foreach(project IN LISTS cuda_projects)
    get_filename_component(directory "${project}" DIRECTORY)
    file(READ "${project}" content)
    unset(DATA_DIR)
    unset(SRC_DIR)
    file(STRINGS "${project}" lines REGEX "^ *set\\([A-Z_]+ +\"[^\"]*\"\\)")
    foreach(line IN LISTS lines)
      if(line MATCHES "set\\(([A-Z_]+) +\"([^\"]*)\"\\)")
        set(value "${CMAKE_MATCH_2}")
        string(REPLACE "\${CMAKE_CURRENT_LIST_DIR}" "${directory}" value "${value}")
        set(${CMAKE_MATCH_1} "${value}")
      endif()
    endforeach()
    string(REGEX MATCHALL "UNZIPFILE\\([^)]*\\)" calls "${content}")
    foreach(call IN LISTS calls)
      string(REGEX REPLACE "^UNZIPFILE\\(\"?([^\")]*)\"?\\)$" "\\1" path "${call}")
      string(REPLACE "\${CMAKE_CURRENT_LIST_DIR}" "${directory}" path "${path}")
      foreach(variable IN ITEMS DATA_DIR SRC_DIR)
        if(DEFINED ${variable})
          string(REPLACE "\${${variable}}" "${${variable}}" path "${path}")
        endif()
      endforeach()
      if(path MATCHES "\\$\\{")
        get_filename_component(filename "${path}" NAME)
        list(APPEND referenced_names "${filename}")
      else()
        cmake_path(ABSOLUTE_PATH path BASE_DIRECTORY "${directory}")
        cmake_path(NORMAL_PATH path)
        file(RELATIVE_PATH relative "${source}" "${path}")
        list(APPEND referenced "${relative}")
      endif()
    endforeach()
  endforeach()
  list(REMOVE_DUPLICATES referenced)
  list(REMOVE_DUPLICATES referenced_names)
  set(entries)
  foreach(pointer IN LISTS pointers)
    string(REGEX REPLACE "\\.dvc$" "" archive "${pointer}")
    get_filename_component(filename "${archive}" NAME)
    file(RELATIVE_PATH relative "${source}" "${archive}")
    if(NOT archive MATCHES "-cuda/" AND NOT relative IN_LIST referenced AND NOT filename IN_LIST referenced_names)
      continue()
    endif()
    file(READ "${pointer}" content)
    if(NOT content MATCHES "md5: *([0-9a-f]+)")
      message(FATAL_ERROR "HeCBench DVC pointer has no MD5: ${pointer}")
    endif()
    set(md5 "${CMAKE_MATCH_1}")
    if(NOT content MATCHES "size: *([0-9]+)")
      message(FATAL_ERROR "HeCBench DVC pointer has no size: ${pointer}")
    endif()
    set(size "${CMAKE_MATCH_1}")
    list(APPEND entries "${md5}|${size}|${relative}")
  endforeach()
  list(SORT entries)
  set(${output} "${entries}" PARENT_SCOPE)
endfunction()

function(hecbench_dvc_url md5 output)
  string(LENGTH "${md5}" length)
  if(NOT md5 MATCHES "^[0-9a-f]+$" OR NOT length EQUAL 32)
    message(FATAL_ERROR "Invalid HeCBench DVC MD5: ${md5}")
  endif()
  string(SUBSTRING "${md5}" 0 2 prefix)
  string(SUBSTRING "${md5}" 2 -1 remainder)
  set(${output} "https://hecbench-geekdude.s3.amazonaws.com/files/md5/${prefix}/${remainder}" PARENT_SCOPE)
endfunction()

# target_compile_features rejects a cuda_std_NN the compiler has no option for.
function(hecbench_cuda_feature_supported feature output)
  if(NOT feature MATCHES "^cuda_std_([0-9]+)$")
    set(${output} FALSE PARENT_SCOPE)
    return()
  endif()
  set(option "CMAKE_CUDA${CMAKE_MATCH_1}_STANDARD_COMPILE_OPTION")
  if(DEFINED ${option} AND NOT "${${option}}" STREQUAL "")
    set(${output} TRUE PARENT_SCOPE)
  else()
    set(${output} FALSE PARENT_SCOPE)
  endif()
endfunction()

function(hecbench_unsupported_cuda_features content output)
  string(REGEX MATCHALL "cuda_std_[0-9]+" features "${content}")
  list(REMOVE_DUPLICATES features)
  set(unsupported)
  foreach(feature IN LISTS features)
    hecbench_cuda_feature_supported("${feature}" supported)
    if(NOT supported)
      list(APPEND unsupported "${feature}")
    endif()
  endforeach()
  set(${output} "${unsupported}" PARENT_SCOPE)
endfunction()

function(hecbench_classify_licence_text text output_name output_class)
  string(TOLOWER "${text}" lower)
  string(REGEX REPLACE "[ \t\r\n]+" " " lower "${lower}")
  set(name unknown)
  set(class unknown)
  if(lower MATCHES "non-commercial use" OR lower MATCHES "noncommercial use" OR
      lower MATCHES "non-commercial license" OR lower MATCHES "noncommercial license" OR
      lower MATCHES "non-commercial purposes" OR lower MATCHES "not for commercial" OR
      lower MATCHES "by-nc" OR lower MATCHES "by nc" OR lower MATCHES "dhara")
    set(class non-commercial)
    if(lower MATCHES "dhara")
      set(name "Dhara non-commercial")
    elseif(lower MATCHES "creative commons|cc-by-nc|by-nc")
      set(name CC-BY-NC-3.0)
    else()
      set(name non-commercial)
    endif()
  elseif(lower MATCHES "proprietary and confidential" OR
      (lower MATCHES "nvidia corporation" AND lower MATCHES "all rights reserved"
       AND lower MATCHES "licensed deliverables"))
    set(class proprietary)
    set(name "NVIDIA proprietary")
  elseif(lower MATCHES "gnu lgpl")
    set(class copyleft)
    if(lower MATCHES "lgpl-2\\.1|lgpl version 2\\.1")
      set(name LGPL-2.1)
    else()
      set(name LGPL-3.0)
    endif()
  elseif(lower MATCHES "gnu lesser general public license|gnu (library )?general public license")
    string(FIND "${lower}" "gnu lesser general public license" lgpl_position)
    string(FIND "${lower}" "gnu general public license" gpl_position)
    set(class copyleft)
    if(lgpl_position GREATER -1 AND (gpl_position EQUAL -1 OR lgpl_position LESS gpl_position))
      if(lower MATCHES "version 2\\.1|version 2")
        set(name LGPL-2.1)
      else()
        set(name LGPL-3.0)
      endif()
    elseif(lower MATCHES "version 2[^0-9]|v2[^0-9]")
      set(name GPL-2.0)
    else()
      set(name GPL-3.0)
    endif()
  elseif(lower MATCHES "mozilla public license")
    set(class copyleft)
    set(name MPL-2.0)
  elseif(lower MATCHES "university of illinois/ncsa|ncsa open source license")
    set(class permissive)
    set(name NCSA)
  elseif(lower MATCHES "high performance computing linpack|linpack benchmark")
    set(class permissive)
    set(name HPL)
  elseif(lower MATCHES "apache license")
    set(class permissive)
    set(name Apache-2.0)
  elseif(lower MATCHES "mit license" OR lower MATCHES "permission is hereby granted, free of charge")
    set(class permissive)
    set(name MIT)
  elseif(lower MATCHES "redistribution and use in source and binary forms")
    set(class permissive)
    if(lower MATCHES "neither the name")
      set(name BSD-3-Clause)
    else()
      set(name BSD-2-Clause)
    endif()
  elseif(lower MATCHES "boost software license")
    set(class permissive)
    set(name BSL-1.0)
  elseif(lower MATCHES "this is free and unencumbered software released into the public domain")
    set(class permissive)
    set(name Unlicense)
  elseif(lower MATCHES "cc0 1\\.0|creative commons zero")
    set(class permissive)
    set(name CC0-1.0)
  elseif(lower MATCHES "ohio state university software distribution license")
    set(class permissive)
    set(name "Ohio State University licence")
  elseif(lower MATCHES "hpl license")
    set(class permissive)
    set(name HPL)
  endif()
  set(${output_name} "${name}" PARENT_SCOPE)
  set(${output_class} "${class}" PARENT_SCOPE)
endfunction()

function(hecbench_licence_rank class output)
  if(class STREQUAL "non-commercial")
    set(rank 5)
  elseif(class STREQUAL "proprietary")
    set(rank 4)
  elseif(class STREQUAL "copyleft")
    set(rank 3)
  elseif(class STREQUAL "unknown")
    set(rank 2)
  else()
    set(rank 1)
  endif()
  set(${output} "${rank}" PARENT_SCOPE)
endfunction()

function(hecbench_licence_classification source output)
  file(STRINGS "${source}/src/CMakeLists.txt" lines)
  set(names)
  set(in_list FALSE)
  foreach(line IN LISTS lines)
    if(line MATCHES "^set\\(HECBENCH_POC_BENCHMARKS")
      set(in_list TRUE)
      string(REGEX REPLACE "^set\\(HECBENCH_POC_BENCHMARKS" "" line "${line}")
    endif()
    if(NOT in_list)
      continue()
    endif()
    if(line MATCHES "^\\)")
      break()
    endif()
    string(REGEX REPLACE "#.*$" "" line "${line}")
    string(STRIP "${line}" line)
    if(line AND EXISTS "${source}/src/${line}-cuda/CMakeLists.txt")
      list(APPEND names "${line}")
    endif()
  endforeach()
  list(REMOVE_DUPLICATES names)
  list(SORT names)
  set(rows)
  foreach(name IN LISTS names)
    file(GLOB_RECURSE files LIST_DIRECTORIES false
      "${source}/src/${name}-*/LICENSE*"
      "${source}/src/${name}-*/LICENCE*"
      "${source}/src/${name}-*/COPYING*")
    list(SORT files)
    set(names_found)
    set(class permissive)
    set(rank 1)
    if(NOT files)
      set(names_found BSD-3-Clause)
    endif()
    foreach(file IN LISTS files)
      file(READ "${file}" text)
      hecbench_classify_licence_text("${text}" licence_name licence_class)
      hecbench_licence_rank("${licence_class}" file_rank)
      if(file_rank GREATER rank)
        set(class "${licence_class}")
        set(rank "${file_rank}")
      endif()
      list(APPEND names_found "${licence_name}")
    endforeach()
    list(REMOVE_DUPLICATES names_found)
    list(SORT names_found)
    list(JOIN names_found "+" licence)
    set(relative_files)
    foreach(file IN LISTS files)
      file(RELATIVE_PATH file "${source}" "${file}")
      list(APPEND relative_files "${file}")
    endforeach()
    list(JOIN relative_files "+" files)
    list(APPEND rows "${name}|${licence}|${class}|${files}")
  endforeach()
  set(${output} "${rows}" PARENT_SCOPE)
endfunction()
