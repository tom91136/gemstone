include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/Relocation.cmake")

# The report quotes compiler diagnostics, which name the build tree and the SDK of the machine that produced them.
function(hecbench_failure_line entry source build output)
  string(REPLACE "|" ": " line "${entry}")
  string(REPLACE "${source}/" "" line "${line}")
  string(REPLACE "${build}/" "" line "${line}")
  conformance_relocatable_text("${line}" line)
  set(${output} "${line}" PARENT_SCOPE)
endfunction()

# DVC archives are addressed by the MD5 and size recorded in each pointer.
function(hecbench_dvc_entries source output)
  file(GLOB_RECURSE pointers "${source}/src/*.dvc")
  file(GLOB cuda_projects "${source}/src/*-cuda/CMakeLists.txt")
  set(referenced)
  set(referenced_names)
  foreach(project IN LISTS cuda_projects)
    get_filename_component(directory "${project}" DIRECTORY)
    file(READ "${project}" content)
    unset(DATA_DIR)
    unset(SRC_DIR)
    file(STRINGS "${project}" lines REGEX "^ *set\\([A-Z_]+ +\"[^\"]*\"\\)")
    foreach(line IN LISTS lines)
      if(line MATCHES "set\\(([A-Z_]+) +\"([^\"]*)\"\\)")
        set(value "${CMAKE_MATCH_2}")
        string(REPLACE "\${CMAKE_CURRENT_LIST_DIR}" "${directory}" value "${value}")
        set(${CMAKE_MATCH_1} "${value}")
      endif()
    endforeach()
    string(REGEX MATCHALL "UNZIPFILE\\([^)]*\\)" calls "${content}")
    foreach(call IN LISTS calls)
      string(REGEX REPLACE "^UNZIPFILE\\(\"?([^\")]*)\"?\\)$" "\\1" path "${call}")
      string(REPLACE "\${CMAKE_CURRENT_LIST_DIR}" "${directory}" path "${path}")
      foreach(variable IN ITEMS DATA_DIR SRC_DIR)
        if(DEFINED ${variable})
          string(REPLACE "\${${variable}}" "${${variable}}" path "${path}")
        endif()
      endforeach()
      if(path MATCHES "\\$\\{")
        get_filename_component(filename "${path}" NAME)
        list(APPEND referenced_names "${filename}")
      else()
        cmake_path(ABSOLUTE_PATH path BASE_DIRECTORY "${directory}")
        cmake_path(NORMAL_PATH path)
        file(RELATIVE_PATH relative "${source}" "${path}")
        list(APPEND referenced "${relative}")
      endif()
    endforeach()
  endforeach()
  list(REMOVE_DUPLICATES referenced)
  list(REMOVE_DUPLICATES referenced_names)
  set(entries)
  foreach(pointer IN LISTS pointers)
    string(REGEX REPLACE "\\.dvc$" "" archive "${pointer}")
    get_filename_component(filename "${archive}" NAME)
    file(RELATIVE_PATH relative "${source}" "${archive}")
    if(NOT archive MATCHES "-cuda/" AND NOT relative IN_LIST referenced AND NOT filename IN_LIST referenced_names)
      continue()
    endif()
    file(READ "${pointer}" content)
    if(NOT content MATCHES "md5: *([0-9a-f]+)")
      message(FATAL_ERROR "HeCBench DVC pointer has no MD5: ${pointer}")
    endif()
    set(md5 "${CMAKE_MATCH_1}")
    if(NOT content MATCHES "size: *([0-9]+)")
      message(FATAL_ERROR "HeCBench DVC pointer has no size: ${pointer}")
    endif()
    set(size "${CMAKE_MATCH_1}")
    list(APPEND entries "${md5}|${size}|${relative}")
  endforeach()
  list(SORT entries)
  set(${output} "${entries}" PARENT_SCOPE)
endfunction()

function(hecbench_dvc_url md5 output)
  string(LENGTH "${md5}" length)
  if(NOT md5 MATCHES "^[0-9a-f]+$" OR NOT length EQUAL 32)
    message(FATAL_ERROR "Invalid HeCBench DVC MD5: ${md5}")
  endif()
  string(SUBSTRING "${md5}" 0 2 prefix)
  string(SUBSTRING "${md5}" 2 -1 remainder)
  set(${output} "https://hecbench-geekdude.s3.amazonaws.com/files/md5/${prefix}/${remainder}" PARENT_SCOPE)
endfunction()

# target_compile_features rejects a cuda_std_NN the compiler has no option for.
function(hecbench_cuda_feature_supported feature output)
  if(NOT feature MATCHES "^cuda_std_([0-9]+)$")
    set(${output} FALSE PARENT_SCOPE)
    return()
  endif()
  set(option "CMAKE_CUDA${CMAKE_MATCH_1}_STANDARD_COMPILE_OPTION")
  if(DEFINED ${option} AND NOT "${${option}}" STREQUAL "")
    set(${output} TRUE PARENT_SCOPE)
  else()
    set(${output} FALSE PARENT_SCOPE)
  endif()
endfunction()

function(hecbench_unsupported_cuda_features content output)
  string(REGEX MATCHALL "cuda_std_[0-9]+" features "${content}")
  list(REMOVE_DUPLICATES features)
  set(unsupported)
  foreach(feature IN LISTS features)
    hecbench_cuda_feature_supported("${feature}" supported)
    if(NOT supported)
      list(APPEND unsupported "${feature}")
    endif()
  endforeach()
  set(${output} "${unsupported}" PARENT_SCOPE)
endfunction()

function(hecbench_classify_licence_text text output_name output_class)
  string(TOLOWER "${text}" lower)
  string(REGEX REPLACE "[ \t\r\n]+" " " lower "${lower}")
  set(name unknown)
  set(class unknown)
  if(lower MATCHES "non-commercial use" OR lower MATCHES "noncommercial use" OR
      lower MATCHES "non-commercial license" OR lower MATCHES "noncommercial license" OR
      lower MATCHES "non-commercial purposes" OR lower MATCHES "not for commercial" OR
      lower MATCHES "by-nc" OR lower MATCHES "by nc" OR lower MATCHES "dhara")
    set(class non-commercial)
    if(lower MATCHES "dhara")
      set(name "Dhara non-commercial")
    elseif(lower MATCHES "creative commons|cc-by-nc|by-nc")
      set(name CC-BY-NC-3.0)
    else()
      set(name non-commercial)
    endif()
  elseif(lower MATCHES "proprietary and confidential" OR
      (lower MATCHES "nvidia corporation" AND lower MATCHES "all rights reserved"
       AND lower MATCHES "licensed deliverables"))
    set(class proprietary)
    set(name "NVIDIA proprietary")
  elseif(lower MATCHES "gnu lgpl")
    set(class copyleft)
    if(lower MATCHES "lgpl-2\\.1|lgpl version 2\\.1")
      set(name LGPL-2.1)
    else()
      set(name LGPL-3.0)
    endif()
  elseif(lower MATCHES "gnu lesser general public license|gnu (library )?general public license")
    string(FIND "${lower}" "gnu lesser general public license" lgpl_position)
    string(FIND "${lower}" "gnu general public license" gpl_position)
    set(class copyleft)
    if(lgpl_position GREATER -1 AND (gpl_position EQUAL -1 OR lgpl_position LESS gpl_position))
      if(lower MATCHES "version 2\\.1|version 2")
        set(name LGPL-2.1)
      else()
        set(name LGPL-3.0)
      endif()
    elseif(lower MATCHES "version 2[^0-9]|v2[^0-9]")
      set(name GPL-2.0)
    else()
      set(name GPL-3.0)
    endif()
  elseif(lower MATCHES "mozilla public license")
    set(class copyleft)
    set(name MPL-2.0)
  elseif(lower MATCHES "university of illinois/ncsa|ncsa open source license")
    set(class permissive)
    set(name NCSA)
  elseif(lower MATCHES "high performance computing linpack|linpack benchmark")
    set(class permissive)
    set(name HPL)
  elseif(lower MATCHES "apache license")
    set(class permissive)
    set(name Apache-2.0)
  elseif(lower MATCHES "mit license" OR lower MATCHES "permission is hereby granted, free of charge")
    set(class permissive)
    set(name MIT)
  elseif(lower MATCHES "redistribution and use in source and binary forms")
    set(class permissive)
    if(lower MATCHES "neither the name")
      set(name BSD-3-Clause)
    else()
      set(name BSD-2-Clause)
    endif()
  elseif(lower MATCHES "boost software license")
    set(class permissive)
    set(name BSL-1.0)
  elseif(lower MATCHES "this is free and unencumbered software released into the public domain")
    set(class permissive)
    set(name Unlicense)
  elseif(lower MATCHES "cc0 1\\.0|creative commons zero")
    set(class permissive)
    set(name CC0-1.0)
  elseif(lower MATCHES "ohio state university software distribution license")
    set(class permissive)
    set(name "Ohio State University licence")
  elseif(lower MATCHES "hpl license")
    set(class permissive)
    set(name HPL)
  endif()
  set(${output_name} "${name}" PARENT_SCOPE)
  set(${output_class} "${class}" PARENT_SCOPE)
endfunction()

function(hecbench_licence_rank class output)
  if(class STREQUAL "non-commercial")
    set(rank 5)
  elseif(class STREQUAL "proprietary")
    set(rank 4)
  elseif(class STREQUAL "copyleft")
    set(rank 3)
  elseif(class STREQUAL "unknown")
    set(rank 2)
  else()
    set(rank 1)
  endif()
  set(${output} "${rank}" PARENT_SCOPE)
endfunction()

function(hecbench_licence_classification source output)
  file(STRINGS "${source}/src/CMakeLists.txt" lines)
  set(names)
  set(in_list FALSE)
  foreach(line IN LISTS lines)
    if(line MATCHES "^set\\(HECBENCH_POC_BENCHMARKS")
      set(in_list TRUE)
      string(REGEX REPLACE "^set\\(HECBENCH_POC_BENCHMARKS" "" line "${line}")
    endif()
    if(NOT in_list)
      continue()
    endif()
    if(line MATCHES "^\\)")
      break()
    endif()
    string(REGEX REPLACE "#.*$" "" line "${line}")
    string(STRIP "${line}" line)
    if(line AND EXISTS "${source}/src/${line}-cuda/CMakeLists.txt")
      list(APPEND names "${line}")
    endif()
  endforeach()
  list(REMOVE_DUPLICATES names)
  list(SORT names)
  set(rows)
  foreach(name IN LISTS names)
    file(GLOB_RECURSE files LIST_DIRECTORIES false
      "${source}/src/${name}-*/LICENSE*"
      "${source}/src/${name}-*/LICENCE*"
      "${source}/src/${name}-*/COPYING*")
    list(SORT files)
    set(names_found)
    set(class permissive)
    set(rank 1)
    if(NOT files)
      set(names_found BSD-3-Clause)
    endif()
    foreach(file IN LISTS files)
      file(READ "${file}" text)
      hecbench_classify_licence_text("${text}" licence_name licence_class)
      hecbench_licence_rank("${licence_class}" file_rank)
      if(file_rank GREATER rank)
        set(class "${licence_class}")
        set(rank "${file_rank}")
      endif()
      list(APPEND names_found "${licence_name}")
    endforeach()
    list(REMOVE_DUPLICATES names_found)
    list(SORT names_found)
    list(JOIN names_found "+" licence)
    set(relative_files)
    foreach(file IN LISTS files)
      file(RELATIVE_PATH file "${source}" "${file}")
      list(APPEND relative_files "${file}")
    endforeach()
    list(JOIN relative_files "+" files)
    list(APPEND rows "${name}|${licence}|${class}|${files}")
  endforeach()
  set(${output} "${rows}" PARENT_SCOPE)
endfunction()

function(hecbench_benchmark_arguments yaml_file output_var)
  file(STRINGS "${yaml_file}" lines)
  set(current_name "")
  set(json_entries)
  foreach(line IN LISTS lines)
    if(line MATCHES "^([A-Za-z0-9._/-]+):")
      string(REGEX REPLACE "[^A-Za-z0-9._-]" "_" sanitized "${CMAKE_MATCH_1}")
      set(current_name "hecbench_${sanitized}")
    elseif(current_name AND line MATCHES [=[^[ \t]*args:[ \t]*\[(.*)\]]=])
      set(raw_args "${CMAKE_MATCH_1}")
      string(STRIP "${raw_args}" raw_args)
      if(raw_args)
        list(APPEND json_entries "  \"${current_name}\": [${raw_args}]")
      endif()
      set(current_name "")
    endif()
  endforeach()
  list(JOIN json_entries ",\n" json_body)
  set(${output_var} "{\n${json_body}\n}" PARENT_SCOPE)
endfunction()

# The YAML test arguments are a subset of the runs HeCBench maintains. The per-benchmark Makefile run target is the
# invocation upstream actually runs, so expand it with make instead of reimplementing make variables and conditions.
function(hecbench_run_command directory output_var)
  execute_process(COMMAND make -n run
    WORKING_DIRECTORY "${directory}"
    OUTPUT_VARIABLE stdout
    ERROR_VARIABLE stderr
    RESULT_VARIABLE status
    TIMEOUT 30)
  string(REPLACE "\r" "" stdout "${stdout}")
  string(REPLACE "\\\n" " " stdout "${stdout}")
  string(REPLACE ";" "@SEMICOLON@" stdout "${stdout}")
  string(REPLACE "\n" ";" raw_lines "${stdout}")
  set(lines)
  set(joined "")
  foreach(line IN LISTS raw_lines)
    if(line MATCHES "\\\\$")
      string(REGEX REPLACE "\\\\$" "" line "${line}")
      string(APPEND joined "${line} ")
    else()
      string(APPEND joined "${line}")
      list(APPEND lines "${joined}")
      set(joined "")
    endif()
  endforeach()
  if(NOT joined STREQUAL "")
    list(APPEND lines "${joined}")
  endif()
  set(command "")
  set(fallback "")
  if(status EQUAL 0)
    foreach(line IN LISTS lines)
      string(REPLACE "@SEMICOLON@" ";" line "${line}")
      string(STRIP "${line}" line)
      if(line STREQUAL "")
        continue()
      endif()
      string(REGEX MATCH "^[^ ]+" first_word "${line}")
      if(first_word MATCHES "^(nvcc|hipcc|icpx|gcc|clang|cmake|make|cd|echo|mkdir|cp|rm|mv|ln|tar|unzip)$"
          OR first_word STREQUAL "g++")
        continue()
      endif()
      if(line MATCHES "^(\./|\.\./)" OR line MATCHES "^(ulimit|timeout|env|taskset) ")
        set(command "${line}")
      else()
        set(fallback "${line}")
      endif()
    endforeach()
  endif()
  if(command STREQUAL "")
    set(command "${fallback}")
  endif()
  if(command STREQUAL "")
    set(${output_var} "NO_RUN" PARENT_SCOPE)
  else()
    set(${output_var} "${command}" PARENT_SCOPE)
  endif()
endfunction()

# Splits a Makefile run command into its program arguments. Only the shorthands HeCBench uses are removed; anything with
# shell syntax or an unexpanded make variable is reported instead of guessed.
function(hecbench_run_arguments command benchmark output_var output_kind)
  set(kind parsed)
  set(rest "${command}")
  if(rest MATCHES "[;&|<>]" OR rest MATCHES "\\$[({]" OR rest MATCHES "^(cd|for|while|if|set|export|mpirun|make) ")
    set(kind unparsed)
    set(${output_var} "" PARENT_SCOPE)
    set(${output_kind} "unparsed" PARENT_SCOPE)
    return()
  endif()
  separate_arguments(tokens UNIX_COMMAND "${rest}")
  # Remove wrappers that only adjust the process environment or limits.
  while(tokens)
    list(GET tokens 0 first)
    if(first STREQUAL "ulimit")
      list(REMOVE_AT tokens 0)
      while(tokens)
        list(GET tokens 0 first)
        if(first MATCHES "^-" OR first STREQUAL "unlimited")
          list(REMOVE_AT tokens 0)
        else()
          break()
        endif()
      endwhile()
    elseif(first STREQUAL "timeout")
      list(REMOVE_AT tokens 0)
      if(tokens)
        list(REMOVE_AT tokens 0)
      endif()
    elseif(first STREQUAL "env")
      list(REMOVE_AT tokens 0)
      while(tokens)
        list(GET tokens 0 first)
        if(first MATCHES "^[A-Za-z_][A-Za-z0-9_]*=")
          list(REMOVE_AT tokens 0)
        else()
          break()
        endif()
      endwhile()
    elseif(first STREQUAL "taskset")
      list(REMOVE_AT tokens 0)
      while(tokens)
        list(GET tokens 0 first)
        if(first MATCHES "^-")
          list(REMOVE_AT tokens 0)
          if(tokens AND first MATCHES "^-c$")
            list(REMOVE_AT tokens 0)
          endif()
        else()
          break()
        endif()
      endwhile()
    else()
      break()
    endif()
  endwhile()
  if(NOT tokens)
    set(${output_var} "" PARENT_SCOPE)
    set(${output_kind} "${kind}" PARENT_SCOPE)
    return()
  endif()
  list(REMOVE_AT tokens 0)
  set(parsed)
  foreach(token IN LISTS tokens)
    if(token MATCHES "\\$\\(|\\$\\{")
      set(kind unparsed)
      set(parsed "")
      break()
    endif()
    list(APPEND parsed "${token}")
  endforeach()
  set(${output_var} "${parsed}" PARENT_SCOPE)
  set(${output_kind} "${kind}" PARENT_SCOPE)
endfunction()

function(hecbench_yaml_entries yaml_file output_names output_arguments)
  file(STRINGS "${yaml_file}" lines)
  set(current_name "")
  set(names)
  set(arguments)
  foreach(line IN LISTS lines)
    if(line MATCHES "^([A-Za-z0-9._/-]+):")
      set(current_name "${CMAKE_MATCH_1}")
    elseif(current_name AND line MATCHES [=[^[ \t]*args:[ \t]*\[(.*)\]]=])
      set(raw_args "${CMAKE_MATCH_1}")
      string(REGEX REPLACE "\"" "" raw_args "${raw_args}")
      string(REGEX REPLACE "'" "" raw_args "${raw_args}")
      string(REPLACE "," "|" raw_args "${raw_args}")
      string(REGEX REPLACE "[ \t]+" "" raw_args "${raw_args}")
      string(REGEX REPLACE "^\\||\\|$" "" raw_args "${raw_args}")
      if(NOT raw_args STREQUAL "")
        list(APPEND names "${current_name}")
        list(APPEND arguments "${raw_args}")
      endif()
      set(current_name "")
    endif()
  endforeach()
  set(${output_names} "${names}" PARENT_SCOPE)
  set(${output_arguments} "${arguments}" PARENT_SCOPE)
endfunction()

# Copies the files a benchmark opens relative to its own directory into a tree that keeps the source layout, so the
# program can run with its run target's working directory and its relative data paths still resolve.
function(hecbench_invocation_data source benchmark directory tree output_paths output_missing)
  set(found)
  set(missing)
  set(candidates ${ARGN})
  # Literals in the program that name a relative data file are not always on the command line.
  file(GLOB_RECURSE sources
    "${directory}/*.cu" "${directory}/*.cpp" "${directory}/*.c" "${directory}/*.h" "${directory}/*.hpp")
  foreach(file IN LISTS sources)
    file(READ "${file}" content)
    string(REGEX MATCHALL "\"([A-Za-z0-9_./-]+/[A-Za-z0-9_./-]+)\"" literals "${content}")
    foreach(literal IN LISTS literals)
      string(REGEX REPLACE "^\"|\"$" "" literal "${literal}")
      if(literal MATCHES "\\.(dat|bin|txt|su|csv|raw|ppm|dds|mtx|gr|fasta|fa|fq|gz|bz2|zip|img|hdr|avi|mtx|p2i|macepipe|bmp|seq|out)$"
          OR literal MATCHES "/data/")
        list(APPEND candidates "${literal}")
      endif()
    endforeach()
  endforeach()
  list(REMOVE_DUPLICATES candidates)
  foreach(path IN LISTS candidates)
    if(path MATCHES "^-" AND NOT path MATCHES "/")
      continue()
    endif()
    if(path MATCHES "=")
      string(REGEX REPLACE "^[^=]*=" "" path "${path}")
    endif()
    if(path STREQUAL "" OR path MATCHES "^/" OR path MATCHES "^\\$")
      continue()
    endif()
    get_filename_component(absolute "${directory}/${path}" ABSOLUTE)
    if(EXISTS "${absolute}")
      file(RELATIVE_PATH relative "${source}" "${absolute}")
      if(NOT relative MATCHES "^\\.\\.")
        get_filename_component(parent "${relative}" DIRECTORY)
        if(parent STREQUAL "")
          set(parent ".")
        endif()
        file(MAKE_DIRECTORY "${tree}/${parent}")
        file(COPY "${absolute}" DESTINATION "${tree}/${parent}")
        list(APPEND found "${relative}")
      endif()
    elseif(path MATCHES "\\.(dat|bin|txt|su|csv|raw|ppm|dds|mtx|gr|fasta|fa|fq|gz|bz2|zip|img|hdr|avi|p2i|macepipe|bmp|seq|in|mtx)$"
        OR path MATCHES "/data/")
      list(APPEND missing "${path}")
    endif()
  endforeach()
  if(found)
    list(REMOVE_DUPLICATES found)
    list(SORT found)
  endif()
  if(missing)
    list(REMOVE_DUPLICATES missing)
    list(SORT missing)
  endif()
  set(${output_paths} "${found}" PARENT_SCOPE)
  set(${output_missing} "${missing}" PARENT_SCOPE)
endfunction()

# Writes the arguments and working directory of every built benchmark from the pinned source. `targets` is
# targets.txt (name|target|program) and `built` is built.txt (program|binary).
function(hecbench_generate_invocations source targets_file built_file tree manifest directories missing unparsed)
  hecbench_yaml_entries("${source}/benchmarks.yaml" yaml_all_names yaml_all_arguments)
  file(STRINGS "${targets_file}" target_lines)
  file(STRINGS "${built_file}" built_lines)
  set(built_programs)
  foreach(line IN LISTS built_lines)
    if(line MATCHES "^([^|]+)\\|")
      list(APPEND built_programs "${CMAKE_MATCH_1}")
    endif()
  endforeach()
  set(manifest_lines)
  set(directory_lines)
  set(missing_lines)
  set(unparsed_lines)
  set(argument_failures)
  foreach(line IN LISTS target_lines)
    if(NOT line MATCHES "^([^|]+)\\|([^|]+)\\|([^|]+)$")
      continue()
    endif()
    set(benchmark "${CMAKE_MATCH_1}")
    set(program "${CMAKE_MATCH_3}")
    if(NOT program IN_LIST built_programs)
      continue()
    endif()
    set(benchmark_directory "${source}/src/${benchmark}-cuda")
    if(NOT IS_DIRECTORY "${benchmark_directory}")
      continue()
    endif()
    file(MAKE_DIRECTORY "${tree}/src/${benchmark}-cuda")
    hecbench_run_command("${benchmark_directory}" command)
    set(arguments)
    set(raw_arguments)
    set(kind parsed)
    if(NOT command STREQUAL "NO_RUN")
      hecbench_run_arguments("${command}" "${benchmark}" raw_arguments kind)
      set(arguments "${raw_arguments}")
    endif()
    set(yaml_arguments)
    list(FIND yaml_all_names "${benchmark}" yaml_index)
    if(NOT yaml_index EQUAL -1)
      list(GET yaml_all_arguments "${yaml_index}" yaml_joined)
      string(REPLACE "|" ";" yaml_arguments "${yaml_joined}")
    endif()
    if(yaml_arguments)
      set(arguments "${yaml_arguments}")
      set(kind parsed)
    endif()
    if(kind STREQUAL "unparsed")
      list(APPEND unparsed_lines "${program}|${command}")
    endif()
    if(raw_arguments AND NOT arguments)
      list(APPEND argument_failures "${program}")
    endif()
    hecbench_invocation_data("${source}" "${benchmark}" "${benchmark_directory}" "${tree}" data_paths missing_paths ${arguments})
    set(output_arguments)
    set(previous "")
    foreach(argument IN LISTS arguments)
      if(previous MATCHES "^--?(output|out|o|scores|save|results)$")
        list(APPEND output_arguments "${argument}")
      endif()
      set(previous "${argument}")
    endforeach()
    foreach(path IN LISTS missing_paths)
      if(path IN_LIST output_arguments)
        continue()
      endif()
      string(TOLOWER "${path}" lower_path)
      if(lower_path MATCHES "(^|/)(out|output|result|error|log|scores)[^/]*$"
          OR lower_path MATCHES "(^|/)out/"
          OR lower_path MATCHES "_out$"
          OR lower_path MATCHES "-out"
          OR lower_path MATCHES "\\.out$"
          OR lower_path MATCHES "output|result")
        continue()
      endif()
      list(APPEND missing_lines "${program}|${path}")
    endforeach()
    set(json_args_items)
    foreach(argument IN LISTS arguments)
      string(REPLACE "\\" "\\\\" argument "${argument}")
      string(REPLACE "\"" "\\\"" argument "${argument}")
      list(APPEND json_args_items "\"${argument}\"")
    endforeach()
    list(JOIN json_args_items ", " json_args)
    string(REPLACE "\\" "\\\\" json_directory "data/hecbench/tree/src/${benchmark}-cuda")
    list(APPEND manifest_lines "  \"${program}\": [${json_args}]")
    list(APPEND directory_lines "  \"${program}\": \"${json_directory}\"")
  endforeach()
  list(JOIN manifest_lines ",\n" manifest_body)
  file(WRITE "${manifest}" "{\n${manifest_body}\n}\n")
  list(JOIN directory_lines ",\n" directory_body)
  file(WRITE "${directories}" "{\n${directory_body}\n}\n")
  list(JOIN missing_lines "\n" missing_body)
  file(WRITE "${missing}" "${missing_body}\n")
  list(JOIN unparsed_lines "\n" unparsed_body)
  file(WRITE "${unparsed}" "${unparsed_body}\n")
  if(argument_failures)
    list(JOIN argument_failures ", " failure_text)
    message(FATAL_ERROR "HeCBench run target arguments are missing from the manifest: ${failure_text}")
  endif()
endfunction()
