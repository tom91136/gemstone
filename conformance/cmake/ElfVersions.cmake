# script mode has no cmake_minimum_required, and functions keep the policies of their definition
cmake_policy(VERSION 3.25)

function(read_elf_versions file defs_var needs_var)
  execute_process(COMMAND "${READELF}" -V "${file}" OUTPUT_VARIABLE text COMMAND_ERROR_IS_FATAL ANY)
  string(REPLACE "\n" ";" lines "${text}")
  set(defs "")
  set(requirements "")
  foreach(line IN LISTS lines)
    if(line MATCHES "^Version ([a-z]+) section")
      set(section "${CMAKE_MATCH_1}")
    elseif(section STREQUAL "definition" AND line MATCHES "Name: ([^ ]+)$")
      list(APPEND defs "${CMAKE_MATCH_1}")
    elseif(section STREQUAL "needs" AND line MATCHES "Name: ([^ ]+)  Flags:")
      list(APPEND requirements "${CMAKE_MATCH_1}")
    endif()
  endforeach()
  set(${defs_var} "${defs}" PARENT_SCOPE)
  set(${needs_var} "${requirements}" PARENT_SCOPE)
endfunction()

function(highest_version prefix names result_var)
  set(highest "")
  foreach(name IN LISTS names)
    if(name MATCHES "^${prefix}_([0-9.]+)$")
      set(version "${CMAKE_MATCH_1}")
      if(NOT highest OR version VERSION_GREATER highest)
        set(highest "${version}")
      endif()
    endif()
  endforeach()
  set(${result_var} "${highest}" PARENT_SCOPE)
endfunction()

function(exceeding_versions prefix floor names result_var)
  set(exceeding "")
  foreach(name IN LISTS names)
    if(name MATCHES "^${prefix}_([0-9.]+)$")
      if(CMAKE_MATCH_1 VERSION_GREATER floor)
        list(APPEND exceeding "${name}")
      endif()
    endif()
  endforeach()
  set(${result_var} "${exceeding}" PARENT_SCOPE)
endfunction()
