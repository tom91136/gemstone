set(miniapp_supported_cuda cuda cuda-tuned kokkos)
set(miniapp_supported_hip hip omp-target kokkos)
set(miniapp_supported_opencl ocl)
set(miniapp_supported_sycl sycl sycl-usm sycl-acc sycl2020-usm sycl2020-acc)
set(miniapp_supported_openacc acc)
set(miniapp_supported_vulkan vulkan)
if(CONFORMANCE_COMPILER STREQUAL "gcc")
  set(miniapp_supported_cuda omp-target)
  set(miniapp_supported_hsa omp-target)
elseif(CONFORMANCE_COMPILER STREQUAL "clang")
  set(miniapp_supported_cuda cuda cuda-tuned omp-target)
endif()
# nvc++ rejects -stdpar below cc60
set(miniapp_gated_openacc std-indices)
if(CONFORMANCE_BACKEND STREQUAL "openacc" AND conformance_cuda_capability GREATER_EQUAL 60)
  list(APPEND miniapp_supported_openacc std-indices)
endif()

function(conformance_miniapp_models app output)
  set(supported ${ARGN})
  set_property(GLOBAL APPEND PROPERTY CONFORMANCE_MINIAPP_NAMES "${app}")
  set(selected)
  if(CONFORMANCE_MINIAPP_MODELS STREQUAL "")
    foreach(model IN LISTS supported)
      if(model IN_LIST miniapp_supported_${CONFORMANCE_BACKEND})
        list(APPEND selected "${model}")
      endif()
    endforeach()
  else()
    foreach(specification IN LISTS CONFORMANCE_MINIAPP_MODELS)
      if(NOT specification MATCHES "^([^:]+):([^:]+)$")
        message(FATAL_ERROR "Invalid miniapp specification: ${specification}")
      endif()
      if(CMAKE_MATCH_1 STREQUAL app)
        list(APPEND selected "${CMAKE_MATCH_2}")
      endif()
    endforeach()
  endif()
  foreach(model IN LISTS selected)
    if(NOT model IN_LIST supported)
      message(FATAL_ERROR "${app} does not provide the ${model} model")
    endif()
    if(NOT model IN_LIST miniapp_supported_${CONFORMANCE_BACKEND})
      message(FATAL_ERROR "${app}:${model} is not a supported ${CONFORMANCE_BACKEND} model")
    endif()
  endforeach()
  list(REMOVE_DUPLICATES selected)
  set(${output} "${selected}" PARENT_SCOPE)
endfunction()

# The support closure of a key is built by one architecture and shared by all of them, so a model that only some
# architectures build still contributes its data and decks.
function(conformance_miniapp_closure output selected)
  set(closure ${selected})
  if(CONFORMANCE_MINIAPP_MODELS STREQUAL "")
    foreach(model IN LISTS ARGN)
      if(model IN_LIST miniapp_gated_${CONFORMANCE_BACKEND})
        list(APPEND closure "${model}")
      endif()
    endforeach()
  endif()
  list(REMOVE_DUPLICATES closure)
  set(${output} "${closure}" PARENT_SCOPE)
endfunction()
