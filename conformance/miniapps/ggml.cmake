conformance_miniapp_models(ggml ggml_models vulkan)
if(NOT ggml_models)
  return()
endif()
FetchContent_MakeAvailable(llama)
block(SCOPE_FOR VARIABLES)
# Prevent GGML's BUILD_SHARED_LIBS default from affecting Catch on reconfigure.
set(BUILD_SHARED_LIBS OFF)
set(GGML_VULKAN ON CACHE BOOL "" FORCE)
set(GGML_NATIVE OFF CACHE BOOL "" FORCE)
set(GGML_OPENMP OFF CACHE BOOL "" FORCE)
# Toolchain containers do not provide a compiler cache.
set(GGML_CCACHE OFF CACHE BOOL "" FORCE)
set(GGML_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(GGML_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(GGML_BACKEND_DL OFF CACHE BOOL "" FORCE)
add_subdirectory("${llama_SOURCE_DIR}/ggml" "build/ggml-vulkan" EXCLUDE_FROM_ALL)
endblock()
add_executable(miniapp_ggml_vulkan "${CMAKE_CURRENT_LIST_DIR}/ggml_vulkan_test.cpp")
conformance_project_target(miniapp_ggml_vulkan)
target_link_libraries(miniapp_ggml_vulkan PRIVATE ggml ggml-vulkan Catch2::Catch2WithMain conformance_device)
conformance_register_test_program(miniapp_ggml_vulkan 300)
list(APPEND miniapp_targets miniapp_ggml_vulkan)
install(FILES "${llama_SOURCE_DIR}/LICENSE" DESTINATION licences RENAME llama.cpp.txt COMPONENT support)
