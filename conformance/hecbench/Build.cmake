cmake_minimum_required(VERSION 3.25)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/Hecbench.cmake")

foreach(variable IN ITEMS SOURCE BUILD DATA TARGETS PREREQUISITES PROGRAMS BUILT FAILURES CXXOPTS FMT CUDA_ARCH JOBS TIMEOUT)
  if(NOT DEFINED ${variable} OR "${${variable}}" STREQUAL "")
    message(FATAL_ERROR "${variable} is required")
  endif()
endforeach()
find_program(NINJA ninja REQUIRED)
file(MAKE_DIRECTORY "${BUILD}")

set(candidates)
if(EXISTS "${TARGETS}")
  file(STRINGS "${TARGETS}" lines)
  foreach(line IN LISTS lines)
    if(line STREQUAL "")
      continue()
    endif()
    string(REPLACE "|" ";" fields "${line}")
    list(GET fields 0 name)
    list(GET fields 1 target)
    list(GET fields 2 program)
    list(APPEND candidates "${name}|${target}|${program}")
  endforeach()
endif()
set(prerequisite_failures)
if(EXISTS "${PREREQUISITES}")
  file(STRINGS "${PREREQUISITES}" lines)
  foreach(line IN LISTS lines)
    if(NOT line STREQUAL "")
      list(APPEND prerequisite_failures "${line}")
    endif()
  endforeach()
endif()

set(configure_arguments
  -S "${SOURCE}" -B "${BUILD}" -G Ninja
  -DCMAKE_BUILD_TYPE=Release
  -DCMAKE_EXPORT_COMPILE_COMMANDS=ON
  -DHECBENCH_ENABLE_CUDA=ON
  -DHECBENCH_ENABLE_HIP=OFF
  -DHECBENCH_ENABLE_SYCL=OFF
  -DHECBENCH_ENABLE_OPENMP=OFF
  -DHECBENCH_ENABLE_TESTING=OFF
  "-DHECBENCH_CUDA_ARCH=${CUDA_ARCH}"
  "-DFETCHCONTENT_SOURCE_DIR_CXXOPTS=${CXXOPTS}"
  "-DFETCHCONTENT_SOURCE_DIR_FMT=${FMT}"
  -DCMAKE_CUDA_FLAGS=-Wno-deprecated-gpu-targets)
if(DEFINED ENV{CXX} AND NOT "$ENV{CXX}" STREQUAL "")
  list(APPEND configure_arguments "-DCMAKE_CXX_COMPILER=$ENV{CXX}")
endif()
if(DEFINED ENV{CC} AND NOT "$ENV{CC}" STREQUAL "")
  list(APPEND configure_arguments "-DCMAKE_C_COMPILER=$ENV{CC}")
endif()
if(DEFINED ENV{CUDAHOSTCXX} AND NOT "$ENV{CUDAHOSTCXX}" STREQUAL "")
  list(APPEND configure_arguments "-DCMAKE_CUDA_HOST_COMPILER=$ENV{CUDAHOSTCXX}")
endif()

execute_process(COMMAND "${CMAKE_COMMAND}" ${configure_arguments}
  OUTPUT_FILE "${BUILD}/configure.log" ERROR_FILE "${BUILD}/configure-errors.log"
  RESULT_VARIABLE configure_status)
if(NOT configure_status EQUAL 0)
  file(READ "${BUILD}/configure.log" output)
  file(READ "${BUILD}/configure-errors.log" errors)
  message(FATAL_ERROR "HeCBench configure failed:\n${output}${errors}")
endif()
file(STRINGS "${BUILD}/configure.log" configure_lines)
file(STRINGS "${BUILD}/configure-errors.log" configure_error_lines)
set(registered_targets)
set(skip_entries)
foreach(line IN LISTS configure_lines configure_error_lines)
  if(line MATCHES "Registered benchmark: (.*)$")
    string(STRIP "${CMAKE_MATCH_1}" target)
    list(APPEND registered_targets "${target}")
  elseif(line MATCHES "Skipping (.*)-cuda \\(([^)]*)\\)")
    string(STRIP "${CMAKE_MATCH_1}" target)
    string(STRIP "${CMAKE_MATCH_2}" reason)
    list(APPEND skip_entries "${target}-cuda|${reason}")
  endif()
endforeach()

set(build_targets)
foreach(candidate IN LISTS candidates)
  string(REPLACE "|" ";" fields "${candidate}")
  list(GET fields 1 target)
  if(target IN_LIST registered_targets)
    list(APPEND build_targets "${target}")
  endif()
endforeach()

if(build_targets)
  execute_process(COMMAND "${NINJA}" -C "${BUILD}" -j "${JOBS}" -k 0 ${build_targets}
    OUTPUT_FILE "${BUILD}/build.log" ERROR_FILE "${BUILD}/build-errors.log"
    RESULT_VARIABLE build_status)
else()
  set(build_status 0)
  file(WRITE "${BUILD}/build.log" "")
  file(WRITE "${BUILD}/build-errors.log" "")
endif()

file(STRINGS "${BUILD}/build.log" build_lines)
file(STRINGS "${BUILD}/build-errors.log" build_error_lines)
set(entries)
set(current "")
set(reason "")
foreach(line IN LISTS build_lines build_error_lines)
  if(line MATCHES "^FAILED: (.*)$")
    if(NOT current STREQUAL "")
      list(APPEND entries "${current}|${reason}")
    endif()
    set(current "${CMAKE_MATCH_1}")
    set(reason "")
  elseif(NOT current STREQUAL "" AND reason STREQUAL "" AND
      line MATCHES "(fatal error|error:|nvcc fatal|undefined reference)")
    string(STRIP "${line}" reason)
  endif()
endforeach()
if(NOT current STREQUAL "")
  list(APPEND entries "${current}|${reason}")
endif()

set(failure_entries)
foreach(entry IN LISTS entries)
  string(REPLACE "|" ";" fields "${entry}")
  list(GET fields 0 line)
  list(GET fields 1 entry_reason)
  string(REGEX MATCH "src/([^/]+)-cuda/" unused "${line}")
  if(CMAKE_MATCH_1)
    set(benchmark "${CMAKE_MATCH_1}")
  else()
    string(REGEX MATCH "bin/cuda/([^/ ]+)" unused "${line}")
    set(benchmark "${CMAKE_MATCH_1}")
  endif()
  if(benchmark STREQUAL "")
    continue()
  endif()
  set(known FALSE)
  foreach(existing IN LISTS failure_entries)
    if(existing MATCHES "^${benchmark}\\|")
      set(known TRUE)
      break()
    endif()
  endforeach()
  if(NOT known)
    if(entry_reason STREQUAL "")
      set(entry_reason "build failed")
    endif()
    list(APPEND failure_entries "${benchmark}|${entry_reason}")
  endif()
endforeach()

foreach(candidate IN LISTS candidates)
  string(REPLACE "|" ";" fields "${candidate}")
  list(GET fields 0 name)
  list(GET fields 1 target)
  list(GET fields 2 program)
  if(NOT target IN_LIST registered_targets)
    set(reason "not configured")
    foreach(entry IN LISTS skip_entries)
      if(entry MATCHES "^${target}\\|")
        string(REGEX REPLACE "^[^|]*\\|" "" reason "${entry}")
        break()
      endif()
    endforeach()
    list(APPEND failure_entries "${name}|${reason}")
    continue()
  endif()
  set(recorded FALSE)
  foreach(entry IN LISTS failure_entries)
    if(entry MATCHES "^${name}\\|")
      set(recorded TRUE)
      break()
    endif()
  endforeach()
  set(binary "${BUILD}/bin/cuda/${name}")
  if(NOT EXISTS "${binary}")
    if(NOT recorded)
      list(APPEND failure_entries "${name}|not built")
    endif()
  endif()
endforeach()

list(APPEND failure_entries ${prerequisite_failures})
list(REMOVE_DUPLICATES failure_entries)
list(SORT failure_entries)
set(failure_lines)
foreach(entry IN LISTS failure_entries)
  hecbench_failure_line("${entry}" "${SOURCE}" "${BUILD}" line)
  string(APPEND failure_lines "${line}\n")
endforeach()
file(WRITE "${FAILURES}" "${failure_lines}")

file(WRITE "${PROGRAMS}" "")
file(WRITE "${BUILT}" "")
set(program_count 0)
foreach(candidate IN LISTS candidates)
  string(REPLACE "|" ";" fields "${candidate}")
  list(GET fields 0 name)
  list(GET fields 1 target)
  list(GET fields 2 program)
  if(NOT target IN_LIST registered_targets)
    continue()
  endif()
  set(binary "${BUILD}/bin/cuda/${name}")
  if(EXISTS "${binary}")
    file(APPEND "${PROGRAMS}" "${program}\t${TIMEOUT}\thecbench\n")
    file(APPEND "${BUILT}" "${program}|${binary}\n")
    math(EXPR program_count "${program_count} + 1")
  endif()
endforeach()
list(LENGTH candidates candidate_count)
message(STATUS "HeCBench built ${program_count} of ${candidate_count} selected benchmarks")

file(MAKE_DIRECTORY "${DATA}/tree")
hecbench_generate_invocations("${SOURCE}" "${TARGETS}" "${BUILT}" "${DATA}/tree"
  "${DATA}/hecbench-arguments.json"
  "${DATA}/hecbench-directories.json"
  "${DATA}/hecbench-missing-data.txt"
  "${DATA}/hecbench-unparsed-runs.txt")
