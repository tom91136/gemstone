# Generated configuration; discovery executes no GPU work.
set(executable "$<TARGET_FILE:@DISCOVER_TARGET@>")
if(NOT EXISTS "${executable}")
  add_test("@DISCOVER_ID@/not-built" "${executable}")
  return()
endif()
set(arguments @DISCOVER_ARGUMENTS@)
execute_process(COMMAND "${executable}" ${arguments} --list
  RESULT_VARIABLE status OUTPUT_VARIABLE catalog ERROR_VARIABLE diagnostic)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Cannot discover @DISCOVER_ID@: ${diagnostic}")
endif()
string(REPLACE "\r" "" catalog "${catalog}")
string(REPLACE "\n" ";" catalog "${catalog}")
foreach(case IN LISTS catalog)
  if(NOT case STREQUAL "")
    set(name "@DISCOVER_BACKEND@/${case}")
    add_test("${name}" "${executable}" ${arguments} "--case=${case}")
    set_tests_properties("${name}" PROPERTIES TIMEOUT @UNIFIED_SUITE_CTEST_TIMEOUT@
      SKIP_RETURN_CODE 77 LABELS "unified-suite;@DISCOVER_BACKEND@;@DISCOVER_SUITE@")
    if(@DISCOVER_FIXED_PROBE@)
      set_property(TEST "${name}" APPEND PROPERTY LABELS "fixed-api-probe")
    endif()
    if("@DISCOVER_BACKEND@" STREQUAL "sycl" AND @UNIFIED_SUITE_SYCL_ENABLE_FP64_EMULATION@)
      set_tests_properties("${name}" PROPERTIES ENVIRONMENT "OverrideDefaultFP64Settings=1;IGC_EnableDPEmulation=1")
    endif()
  endif()
endforeach()
