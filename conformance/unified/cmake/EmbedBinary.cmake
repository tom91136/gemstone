if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT)
  message(FATAL_ERROR "INPUT and OUTPUT are required")
endif()
file(READ "${INPUT}" bytes HEX)
string(LENGTH "${bytes}" hex_length)
math(EXPR byte_count "${hex_length} / 2")
set(content "#pragma once\n#include <array>\n#include <cstddef>\n#include <cstdint>\ninline constexpr std::array<uint8_t, ${byte_count}> dispatch_image = {")
set(index 0)
while(index LESS hex_length)
  string(SUBSTRING "${bytes}" ${index} 2 byte)
  string(APPEND content "0x${byte},")
  math(EXPR index "${index} + 2")
endwhile()
string(APPEND content "};\n")
file(WRITE "${OUTPUT}" "${content}")
