.version 7.8
.target sm_70
.address_size 64
.visible .entry probe(.param .u64 input, .param .u64 output, .param .u64 indices, .param .u32 mode) {
 .reg .u64 %p, %q, %offset, %old64; .reg .u32 %i, %group, %width, %m, %old; .reg .pred %pred;
 ld.param.u64 %p, [input]; ld.param.u64 %q, [output]; ld.param.u32 %m, [mode];
 mov.u32 %i, %tid.x; mov.u32 %group, %ctaid.x; mov.u32 %width, %ntid.x;
 mad.lo.u32 %i, %group, %width, %i;
 setp.eq.u32 %pred, %m, 10; @%pred bra wide;
 mul.wide.u32 %offset, %i, 4; add.u64 %q, %q, %offset;
 atom.acq_rel.sys.global.add.u32 %old, [%p+8], 1;
 st.global.u32 [%q], %old; ret;
 wide:
 mul.wide.u32 %offset, %i, 8; add.u64 %q, %q, %offset;
 atom.acq_rel.sys.global.add.u64 %old64, [%p+16], 1;
 st.global.u64 [%q], %old64; ret;
}
