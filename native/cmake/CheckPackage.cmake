include("${CMAKE_CURRENT_LIST_DIR}/../../conformance/cmake/ElfVersions.cmake")

read_elf_versions("${SYSROOT}/lib64/libc.so.6" libc_defs libc_needs)
highest_version(GLIBC "${libc_defs}" floor)
if(NOT floor)
  message(FATAL_ERROR "no GLIBC_ version definitions in ${SYSROOT}/lib64/libc.so.6")
endif()

execute_process(COMMAND "${READELF}" -d "${LIBRARY}" OUTPUT_VARIABLE dynamic COMMAND_ERROR_IS_FATAL ANY)
string(REPLACE "\n" ";" dynamic_lines "${dynamic}")
set(problems "")
if(SANITIZER_RUNTIME)
  get_filename_component(sanitizer_soname "${SANITIZER_RUNTIME}" NAME)
endif()
foreach(line IN LISTS dynamic_lines)
  if(NOT line MATCHES "Shared library: \\[([^]]+)\\]")
    continue()
  endif()
  set(soname "${CMAKE_MATCH_1}")
  if(soname STREQUAL sanitizer_soname)
    continue()
  endif()
  if(NOT EXISTS "${SYSROOT}/lib64/${soname}")
    list(APPEND problems "DT_NEEDED ${soname} is not in the sysroot")
    continue()
  endif()
  read_elf_versions("${SYSROOT}/lib64/${soname}" soname_defs soname_needs)
  list(FILTER soname_defs INCLUDE REGEX "^GLIBC_")
  if(NOT soname_defs)
    list(APPEND problems "DT_NEEDED ${soname} is not provided by the sysroot glibc")
  endif()
endforeach()

read_elf_versions("${LIBRARY}" lib_defs lib_needs)
foreach(name IN LISTS lib_needs)
  if(name MATCHES "^(GLIBCXX|CXXABI|GCC)_")
    list(APPEND problems "requires ${name}")
  elseif(name MATCHES "^GLIBC_([0-9.]+)$")
    if(CMAKE_MATCH_1 VERSION_GREATER floor)
      list(APPEND problems "requires ${name}, newer than the sysroot glibc ${floor}")
    endif()
  elseif(name MATCHES "^GLIBC_")
    list(APPEND problems "requires ${name}, which is not a numbered glibc version")
  endif()
endforeach()

if(problems)
  list(REMOVE_DUPLICATES problems)
  list(JOIN problems "\n  " listing)
  message(FATAL_ERROR "${LIBRARY} does not run on the sysroot glibc ${floor}:\n  ${listing}")
endif()
