if(NOT DEFINED HEADER OR NOT EXISTS "${HEADER}")
  message(FATAL_ERROR "HEADER must point at the pinned cuda.h")
endif()
if(NOT DEFINED GOLDEN OR NOT EXISTS "${GOLDEN}")
  message(FATAL_ERROR "GOLDEN must point at the recorded error texts")
endif()
if(NOT DEFINED OUTPUT)
  message(FATAL_ERROR "OUTPUT must name the generated header")
endif()

function(escape_cxx text out)
  string(REPLACE "\\" "\\\\" escaped "${text}")
  string(REPLACE "\"" "\\\"" escaped "${escaped}")
  set(${out} "${escaped}" PARENT_SCOPE)
endfunction()

file(STRINGS "${HEADER}" header_lines)
set(enum_rows "")
set(in_enum FALSE)
foreach(line IN LISTS header_lines)
  if(line MATCHES "typedef enum cudaError_enum")
    set(in_enum TRUE)
    continue()
  endif()
  if(in_enum AND line MATCHES "} CUresult;")
    break()
  endif()
  if(in_enum AND line MATCHES "^[ \t]*(CUDA_[A-Z0-9_]+)[ \t]*=[ \t]*([0-9]+)")
    set(value "${CMAKE_MATCH_2}")
    set(name "${CMAKE_MATCH_1}")
    escape_cxx("${name}" name)
    string(APPEND enum_rows "    CudaErrorValue{${value}, \"${name}\"},\n")
  endif()
endforeach()
if(enum_rows STREQUAL "")
  message(FATAL_ERROR "No CUresult values found in ${HEADER}")
endif()

file(STRINGS "${GOLDEN}" golden_lines)
set(error_rows "")
foreach(line IN LISTS golden_lines)
  if(line MATCHES "^#")
    continue()
  endif()
  if(line MATCHES "^value\t")
    continue()
  endif()
  string(REPLACE "\t" ";" fields "${line}")
  list(LENGTH fields count)
  if(NOT count EQUAL 8)
    message(FATAL_ERROR "Malformed error text row: ${line}")
  endif()
  list(GET fields 0 value)
  list(GET fields 1 enum_name)
  list(GET fields 2 name_status)
  list(GET fields 3 driver_name)
  list(GET fields 4 string_status)
  list(GET fields 5 driver_message)
  list(GET fields 6 runtime_name)
  list(GET fields 7 runtime_message)
  foreach(field IN ITEMS driver_name runtime_name driver_message runtime_message)
    if("${${field}}" STREQUAL "<null>")
      set(${field} "nullptr")
    else()
      escape_cxx("${${field}}" escaped)
      set(${field} "\"${escaped}\"")
    endif()
  endforeach()
  string(APPEND error_rows
    "    CudaErrorText{${value}, \"${enum_name}\", ${name_status}, ${string_status}, ${driver_name}, ${runtime_name}, ${driver_message}, ${runtime_message}},\n")
endforeach()
if(error_rows STREQUAL "")
  message(FATAL_ERROR "No error text rows found in ${GOLDEN}")
endif()

set(content "// Generated from the pinned cuda.h and the recorded driver probe. Do not edit.\n")
string(APPEND content "#pragma once\n\n#include <array>\n\n")
string(APPEND content "struct CudaErrorText {\n")
string(APPEND content "  int value;\n  const char *enumName;\n  int driverNameStatus;\n  int driverStringStatus;\n")
string(APPEND content "  const char *driverName;\n  const char *runtimeName;\n  const char *driverMessage;\n  const char *runtimeMessage;\n};\n\n")
string(APPEND content "inline constexpr std::array ErrorTextRows{\n${error_rows}};\n\n")
string(APPEND content "struct CudaErrorValue {\n  int value;\n  const char *enumName;\n};\n\n")
string(APPEND content "inline constexpr std::array EnumValues{\n${enum_rows}};\n")
file(WRITE "${OUTPUT}" "${content}")
