--- |
  define amdgpu_kernel void @fp_atomic_salu2() {
    ret void
  }
...
---
name: fp_atomic_salu2
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr2
    GLOBAL_ATOMIC_FMIN $vgpr0_vgpr1, $vgpr2, 0, 0, implicit $exec
    $sgpr0 = S_MOV_B32 0
    $sgpr1 = S_MOV_B32 0
    S_DENORM_MODE 0, implicit-def $mode, implicit $mode
    S_ENDPGM 0
...
